# Copy this file to ".env" and fill in the values.

# GoHighLevel inbound webhook for the "Free Instant Demo" form.
# In GHL: Automation → Workflows → Create → Trigger "Inbound Webhook" → copy the URL here.
PUBLIC_GHL_WEBHOOK_URL=

# OpenAI API key for `npm run image` (local only — never commit this, never prefix with PUBLIC_).
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: override the image model. Sunburst = most precise (default); gpt-image-2.5-flare = faster.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
