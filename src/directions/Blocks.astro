---
// Content blocks added to the Liquid Metal pages: the offer strip, who it is (and is not) for,
// the data promises, the FAQ, and the revenue calculator. Pick the ones a page needs with `show`.
import { offer, fit, security, faq, calc, CTA_LABEL, CTA_HREF } from './copy';
type Block = 'offer' | 'fit' | 'security' | 'faq' | 'calc';
interface Props {
  show: Block[];
}
const { show } = Astro.props;
const on = (b: Block) => show.includes(b);
---

{on('offer') && (
  <section class="blk blk-offer">
    <h2 class="offer-head fade">{offer.heading}</h2>
    <p class="offer-cta fade"><a class="cta" href={CTA_HREF}><span>{CTA_LABEL}</span></a></p>
    <ul class="offer-grid">
      {offer.cards.map((c) => (
        <li class="offer-card fade">
          <h3>{c.name}</h3>
          <p class="offer-tag">{c.tag}</p>
          <p class="offer-line">{c.line}</p>
        </li>
      ))}
    </ul>
    <p class="offer-cta offer-cta-end fade"><a class="cta" href={CTA_HREF}><span>{CTA_LABEL}</span></a></p>
  </section>
)}

{on('fit') && (
  <section class="blk blk-fit">
    <p class="blk-label fade">{fit.eyebrow}</p>
    <div class="fit-cols">
      <div class="fit-col fit-yes fade">
        <h2>{fit.goodLabel}</h2>
        <ul>{fit.good.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div class="fit-col fit-no fade">
        <h2>{fit.badLabel}</h2>
        <ul>{fit.bad.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </section>
)}

{on('security') && (
  <section class="blk blk-security">
    <p class="blk-label fade">{security.eyebrow}</p>
    <ul class="sec-list fade">
      {security.items.map((t) => <li>{t}</li>)}
    </ul>
  </section>
)}

{on('faq') && (
  <section class="blk blk-faq">
    <p class="blk-label fade">{faq.eyebrow}</p>
    <div class="faq-list fade">
      {faq.items.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
)}

{on('calc') && (
  <section class="blk blk-calc">
    <p class="blk-label fade">{calc.eyebrow}</p>
    <div class="calc-card fade" data-calc>
      <h2>{calc.headline}</h2>
      <div class="calc-fields">
        {calc.fields.map((f) => (
          <label>
            <span>{f.label}</span>
            <input type="number" inputmode="decimal" min="0" step={f.step} name={f.name} value={f.value} />
          </label>
        ))}
      </div>
      <p class="calc-result-label">{calc.resultLabel}</p>
      <p class="calc-result" data-calc-out aria-live="polite">$0</p>
      <p class="calc-foot">{calc.footnote}</p>
    </div>
  </section>
)}

<script>
  const card = document.querySelector<HTMLElement>('[data-calc]');
  if (card) {
    const val = (n: string) => Math.max(0, parseFloat(card.querySelector<HTMLInputElement>(`[name="${n}"]`)?.value || '0') || 0);
    const out = card.querySelector<HTMLElement>('[data-calc-out]')!;
    const run = () => {
      const total = val('buyers') * (val('close') / 100) * val('gross');
      out.textContent = '$' + Math.round(total).toLocaleString('en-US');
    };
    card.addEventListener('input', run);
    run();
  }
</script>

<style is:global>
  .v4 .blk {
    padding: 0 var(--gutter) clamp(80px, 13vh, 150px);
    max-width: 1240px;
    margin: 0 auto;
  }
  .v4 .blk-label {
    text-align: center;
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--gray);
    margin-bottom: clamp(28px, 5vh, 48px);
  }
  .v4 .blk-sublabel {
    margin-top: clamp(56px, 9vh, 96px);
  }

  /* Start here */
  .v4 .offer-head {
    text-align: center;
    font-weight: 200;
    font-size: clamp(34px, 4.4vw, 68px);
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--t1);
    text-wrap: balance;
  }
  .v4 .offer-cta {
    display: flex;
    justify-content: center;
    margin: clamp(24px, 4vh, 40px) 0 clamp(40px, 6.5vh, 72px);
  }
  .v4 .offer-cta-end {
    margin: clamp(40px, 6vh, 64px) 0 0;
  }
  .v4 .offer-cta .cta {
    margin-top: 0;
  }
  .v4 .offer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
  }
  .v4 .offer-card {
    padding: clamp(28px, 3vw, 44px);
    border-radius: 22px;
    background: var(--card);
    border: 1px solid var(--edge);
    text-align: center;
  }
  .v4 .offer-card h3 {
    font-weight: 300;
    font-size: clamp(26px, 2.5vw, 38px);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--t1);
    min-height: 2.3em;
    display: flex;
    align-items: center;
    justify-content: center;
    text-wrap: balance;
  }
  .v4 .offer-tag {
    margin-top: 14px;
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent-t);
  }
  .v4 .offer-line {
    margin: 18px auto 0;
    max-width: 34ch;
    font-weight: 300;
    font-size: clamp(15px, 1.1vw, 17px);
    line-height: 1.65;
    color: var(--gray);
  }

  /* Fit / not a fit */
  .v4 .fit-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2.4vw, 36px);
    max-width: 1040px;
    margin: 0 auto;
  }
  .v4 .fit-col {
    padding: clamp(28px, 3vw, 44px);
    border-radius: 22px;
    background: var(--card);
    border: 1px solid var(--edge);
  }
  .v4 .fit-col h2 {
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .v4 .fit-yes h2 { color: var(--accent-t); }
  .v4 .fit-no h2 { color: var(--gray); }
  .v4 .fit-col li,
  .v4 .sec-list li {
    position: relative;
    font-weight: 300;
    font-size: clamp(15px, 1.15vw, 18px);
    line-height: 1.55;
    color: var(--t1);
  }
  .v4 .fit-col li + li,
  .v4 .sec-list li + li {
    margin-top: 14px;
  }
  .v4 .fit-no li { color: var(--gray); }

  /* Data promises */
  .v4 .sec-list {
    max-width: 640px;
    margin: 0 auto;
  }

  /* FAQ */
  .v4 .faq-list {
    max-width: 820px;
    margin: 0 auto;
    border-top: 1px solid var(--rule);
  }
  .v4 .faq-list details {
    border-bottom: 1px solid var(--rule);
  }
  .v4 .faq-list summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 0;
    font-weight: 300;
    font-size: clamp(18px, 1.5vw, 22px);
    color: var(--white);
  }
  .v4 .faq-list summary::-webkit-details-marker { display: none; }
  .v4 .faq-list summary::after {
    content: '+';
    font-weight: 200;
    font-size: 28px;
    line-height: 1;
    color: var(--accent-t);
    transition: transform 0.3s ease;
  }
  .v4 .faq-list details[open] summary::after { transform: rotate(45deg); }
  .v4 .faq-list summary:focus-visible { outline: 2px solid var(--accent-t); outline-offset: 4px; }
  .v4 .faq-list details p {
    padding: 0 40px 24px 0;
    font-weight: 300;
    font-size: clamp(15px, 1.15vw, 18px);
    line-height: 1.7;
    color: var(--gray);
  }

  /* Calculator */
  .v4 .calc-card {
    max-width: 880px;
    margin: 0 auto;
    padding: clamp(32px, 5vw, 64px);
    border-radius: 28px;
    text-align: center;
    background: var(--card);
    border: 1px solid var(--edge);
  }
  .v4 .calc-card h2 {
    font-weight: 200;
    font-size: clamp(26px, 3vw, 44px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--t1);
  }
  .v4 .calc-fields {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: clamp(28px, 4vh, 44px);
    text-align: left;
  }
  .v4 .calc-fields span {
    display: block;
    min-height: 2.6em;
    font-weight: 300;
    font-size: 13px;
    line-height: 1.3;
    letter-spacing: 0.04em;
    color: var(--gray);
  }
  .v4 .calc-fields input {
    width: 100%;
    margin-top: 8px;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--field-edge);
    background: var(--field);
    color: var(--t1);
    font: inherit;
    font-size: 18px;
    font-weight: 300;
  }
  .v4 .calc-fields input:focus {
    outline: none;
    border-color: var(--accent-t);
    box-shadow: 0 0 0 3px rgb(0 159 164 / 0.25);
  }
  .v4 .calc-result-label {
    margin-top: clamp(32px, 5vh, 52px);
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gray);
  }
  .v4 .calc-result {
    margin-top: 10px;
    font-weight: 200;
    font-size: clamp(48px, 7vw, 96px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--accent-t);
  }
  .v4 .calc-foot {
    margin-top: 14px;
    font-weight: 300;
    font-size: 13px;
    color: var(--gray);
  }

  @media (max-width: 820px) {
    .v4 .offer-grid,
    .v4 .fit-cols,
    .v4 .calc-fields {
      grid-template-columns: 1fr;
    }
    .v4 .calc-fields span {
      min-height: 0;
    }
    .v4 .offer-card h3 {
      min-height: 0;
    }
  }
</style>
