---
// Content blocks added to the Liquid Metal pages: the offer strip, who it is (and is not) for,
// the data promises, the FAQ, and the revenue calculator. Pick the ones a page needs with `show`.
import { offer, fit, security, faq, calc } from './copy';
type Block = 'offer' | 'fit' | 'security' | 'faq' | 'calc';
interface Props {
  show: Block[];
}
const { show } = Astro.props;
const on = (b: Block) => show.includes(b);
---

{on('offer') && (
  <section class="blk blk-offer">
    <p class="blk-label fade">{offer.eyebrow}</p>
    <ul class="offer-grid">
      {offer.rows.map((r) => (
        <li class="offer-card fade">
          <p class="offer-price">{r.price}</p>
          <h2>{r.name}</h2>
          <p class="offer-line">{r.line}</p>
        </li>
      ))}
    </ul>
    <p class="blk-label blk-sublabel fade">{offer.stepsLabel}</p>
    <ol class="offer-steps">
      {offer.steps.map((s, i) => (
        <li class="fade">
          <span class="offer-n">{i + 1}</span>
          <div>
            <h3>{s.title}</h3>
            <p>{s.line}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
)}

{on('fit') && (
  <section class="blk blk-fit">
    <p class="blk-label fade">{fit.eyebrow}</p>
    <div class="fit-cols">
      <div class="fit-col fit-yes fade">
        <h2>{fit.goodLabel}</h2>
        <ul>{fit.good.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div class="fit-col fit-no fade">
        <h2>{fit.badLabel}</h2>
        <ul>{fit.bad.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </section>
)}

{on('security') && (
  <section class="blk blk-security">
    <p class="blk-label fade">{security.eyebrow}</p>
    <ul class="sec-list fade">
      {security.items.map((t) => <li>{t}</li>)}
    </ul>
  </section>
)}

{on('faq') && (
  <section class="blk blk-faq">
    <p class="blk-label fade">{faq.eyebrow}</p>
    <div class="faq-list fade">
      {faq.items.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
)}

{on('calc') && (
  <section class="blk blk-calc">
    <p class="blk-label fade">{calc.eyebrow}</p>
    <div class="calc-card fade" data-calc>
      <h2>{calc.headline}</h2>
      <div class="calc-fields">
        {calc.fields.map((f) => (
          <label>
            <span>{f.label}</span>
            <input type="number" inputmode="decimal" min="0" step={f.step} name={f.name} placeholder={f.placeholder} />
          </label>
        ))}
      </div>
      <p class="calc-empty" data-calc-empty>{calc.empty}</p>
      <dl class="calc-out" data-calc-out hidden aria-live="polite">
        <div class="calc-main"><dt>{calc.oneLabel}</dt><dd data-out="one"></dd></div>
        <div><dt>{calc.hundredLabel}</dt><dd data-out="hundred"></dd></div>
        <div><dt>{calc.monthLabel}</dt><dd data-out="month"></dd></div>
      </dl>
      <p class="calc-foot">{calc.footnote}</p>
    </div>
  </section>
)}

<script>
  const card = document.querySelector<HTMLElement>('[data-calc]');
  if (card) {
    const num = (n: string) => parseFloat(card.querySelector<HTMLInputElement>(`[name="${n}"]`)?.value || '');
    const money = (v: number) => '$' + Math.round(v).toLocaleString('en-US');
    const set = (k: string, v: string) => {
      const el = card.querySelector<HTMLElement>(`[data-out="${k}"]`);
      if (el) el.textContent = v;
    };
    const empty = card.querySelector<HTMLElement>('[data-calc-empty]')!;
    const out = card.querySelector<HTMLElement>('[data-calc-out]')!;
    const run = () => {
      const leads = num('leads');
      const close = num('close');
      const sale = num('sale');
      const ok = close >= 0 && sale >= 0 && !Number.isNaN(close) && !Number.isNaN(sale);
      empty.hidden = ok;
      out.hidden = !ok;
      if (!ok) return;
      const one = (Math.min(close, 100) / 100) * sale;
      set('one', money(one));
      set('hundred', money(one * 100));
      set('month', Number.isNaN(leads) ? '' : money(one * leads));
      card.querySelector<HTMLElement>('[data-out="month"]')!.closest('div')!.hidden = Number.isNaN(leads);
    };
    card.addEventListener('input', run);
    run();
  }
</script>

<style is:global>
  .v4 .blk {
    padding: 0 var(--gutter) clamp(80px, 13vh, 150px);
    max-width: 1240px;
    margin: 0 auto;
  }
  .v4 .blk-label {
    text-align: center;
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--gray);
    margin-bottom: clamp(28px, 5vh, 48px);
  }
  .v4 .blk-sublabel {
    margin-top: clamp(56px, 9vh, 96px);
  }

  /* Offer */
  .v4 .offer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
  }
  .v4 .offer-card {
    padding: clamp(28px, 3vw, 44px);
    border-radius: 22px;
    background: linear-gradient(160deg, #17191c, #0f1012);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.07);
    text-align: center;
  }
  .v4 .offer-price {
    font-weight: 200;
    font-size: clamp(26px, 2.6vw, 40px);
    line-height: 1.15;
    letter-spacing: -0.01em;
    background: var(--silver);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .v4 .offer-card h2 {
    margin-top: 14px;
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--cyan);
  }
  .v4 .offer-line {
    margin: 16px auto 0;
    max-width: 34ch;
    font-weight: 300;
    font-size: clamp(15px, 1.1vw, 17px);
    line-height: 1.65;
    color: var(--gray);
  }
  .v4 .offer-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 44px);
    max-width: 1000px;
    margin: 0 auto;
  }
  .v4 .offer-steps li {
    display: flex;
    gap: 18px;
    align-items: flex-start;
  }
  .v4 .offer-n {
    font-weight: 100;
    font-size: clamp(40px, 4vw, 56px);
    line-height: 1;
    background: var(--silver);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .v4 .offer-steps h3 {
    font-weight: 300;
    font-size: clamp(18px, 1.5vw, 22px);
    color: var(--white);
  }
  .v4 .offer-steps p {
    margin-top: 6px;
    font-weight: 300;
    font-size: 15px;
    line-height: 1.6;
    color: var(--gray);
  }

  /* Fit / not a fit */
  .v4 .fit-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2.4vw, 36px);
    max-width: 1040px;
    margin: 0 auto;
  }
  .v4 .fit-col {
    padding: clamp(28px, 3vw, 44px);
    border-radius: 22px;
    background: linear-gradient(160deg, #17191c, #0f1012);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.07);
  }
  .v4 .fit-col h2 {
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .v4 .fit-yes h2 { color: var(--cyan); }
  .v4 .fit-no h2 { color: var(--gray); }
  .v4 .fit-col li,
  .v4 .sec-list li {
    position: relative;
    padding-left: 26px;
    font-weight: 300;
    font-size: clamp(15px, 1.15vw, 18px);
    line-height: 1.55;
    color: #d6dde1;
  }
  .v4 .fit-col li + li,
  .v4 .sec-list li + li {
    margin-top: 14px;
  }
  .v4 .fit-col li::before,
  .v4 .sec-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 12px;
    height: 1px;
  }
  .v4 .fit-yes li::before,
  .v4 .sec-list li::before { background: var(--cyan); box-shadow: 0 0 8px rgb(0 255 255 / 0.5); }
  .v4 .fit-no li { color: var(--gray); }
  .v4 .fit-no li::before { background: var(--gray); }

  /* Data promises */
  .v4 .sec-list {
    max-width: 640px;
    margin: 0 auto;
  }

  /* FAQ */
  .v4 .faq-list {
    max-width: 820px;
    margin: 0 auto;
    border-top: 1px solid rgb(230 235 238 / 0.14);
  }
  .v4 .faq-list details {
    border-bottom: 1px solid rgb(230 235 238 / 0.14);
  }
  .v4 .faq-list summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 0;
    font-weight: 300;
    font-size: clamp(18px, 1.5vw, 22px);
    color: var(--white);
  }
  .v4 .faq-list summary::-webkit-details-marker { display: none; }
  .v4 .faq-list summary::after {
    content: '+';
    font-weight: 200;
    font-size: 28px;
    line-height: 1;
    color: var(--cyan);
    transition: transform 0.3s ease;
  }
  .v4 .faq-list details[open] summary::after { transform: rotate(45deg); }
  .v4 .faq-list summary:focus-visible { outline: 1px solid var(--cyan); outline-offset: 4px; }
  .v4 .faq-list details p {
    padding: 0 40px 24px 0;
    font-weight: 300;
    font-size: clamp(15px, 1.15vw, 18px);
    line-height: 1.7;
    color: var(--gray);
  }

  /* Calculator */
  .v4 .calc-card {
    max-width: 880px;
    margin: 0 auto;
    padding: clamp(32px, 5vw, 64px);
    border-radius: 28px;
    text-align: center;
    background: linear-gradient(160deg, #17191c, #0f1012);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.07);
  }
  .v4 .calc-card h2 {
    font-weight: 200;
    font-size: clamp(26px, 3vw, 44px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: #e6ebee;
  }
  .v4 .calc-fields {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: clamp(28px, 4vh, 44px);
    text-align: left;
  }
  .v4 .calc-fields span {
    display: block;
    min-height: 2.6em;
    font-weight: 300;
    font-size: 13px;
    line-height: 1.3;
    letter-spacing: 0.04em;
    color: var(--gray);
  }
  .v4 .calc-fields input {
    width: 100%;
    margin-top: 8px;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid rgb(230 235 238 / 0.18);
    background: #0a0b0d;
    color: var(--white);
    font: inherit;
    font-size: 18px;
    font-weight: 300;
  }
  .v4 .calc-fields input:focus {
    outline: none;
    border-color: var(--cyan);
    box-shadow: 0 0 0 3px rgb(0 255 255 / 0.15);
  }
  .v4 .calc-empty {
    margin-top: clamp(28px, 4vh, 44px);
    font-weight: 300;
    font-size: 15px;
    color: var(--gray);
  }
  .v4 .calc-out {
    margin-top: clamp(28px, 4vh, 44px);
    display: grid;
    gap: 22px;
  }
  .v4 .calc-out[hidden],
  .v4 .calc-empty[hidden],
  .v4 .calc-out div[hidden] { display: none; }
  .v4 .calc-out dt {
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gray);
  }
  .v4 .calc-out dd {
    margin-top: 6px;
    font-weight: 200;
    font-size: clamp(30px, 3.6vw, 48px);
    line-height: 1.1;
    color: #e6ebee;
  }
  .v4 .calc-main dd {
    font-size: clamp(48px, 7vw, 96px);
    color: var(--amber);
  }
  .v4 .calc-result-label {
    margin-top: clamp(32px, 5vh, 52px);
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gray);
  }
  .v4 .calc-result {
    margin-top: 10px;
    font-weight: 200;
    font-size: clamp(48px, 7vw, 96px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--amber);
  }
  .v4 .calc-foot {
    margin-top: 14px;
    font-weight: 300;
    font-size: 13px;
    color: var(--gray);
  }

  @media (max-width: 820px) {
    .v4 .offer-grid,
    .v4 .offer-steps,
    .v4 .fit-cols,
    .v4 .calc-fields {
      grid-template-columns: 1fr;
    }
    .v4 .calc-fields span {
      min-height: 0;
    }
  }
</style>
