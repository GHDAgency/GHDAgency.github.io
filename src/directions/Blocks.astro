---
// Content blocks added to the Liquid Metal pages: the offer strip, who it is (and is not) for,
// the data promises, the FAQ, and the revenue calculator. Pick the ones a page needs with `show`.
import { offer, fit, security, faq, calc, CTA_LABEL, CTA_HREF } from './copy';
type Block = 'offer' | 'fit' | 'security' | 'faq' | 'calc';
interface Props {
  show: Block[];
  /** Calculator only: render just the card, to sit inside another section. */
  inline?: boolean;
}
const { show, inline = false } = Astro.props;
const on = (b: Block) => show.includes(b);
---

{on('offer') && (
  <section class="blk blk-offer">
    <h2 class="offer-head fade">{offer.heading}</h2>
    <p class="offer-cta fade"><a class="cta" href={CTA_HREF}><span>{CTA_LABEL}</span></a></p>
    <ul class="offer-grid">
      {offer.cards.map((c) => (
        <li class="offer-card fade">
          <h3>{c.name}</h3>
          <p class="offer-line">{c.line.split('\n').map((l) => <span>{l}</span>)}</p>
          <p class="offer-tag">{c.tag}</p>
        </li>
      ))}
    </ul>
    <p class="offer-cta offer-cta-end fade"><a class="cta" href={CTA_HREF}><span>{CTA_LABEL}</span></a></p>
  </section>
)}

{on('fit') && (
  <section class="blk blk-fit">
    <p class="blk-label fade">{fit.eyebrow}</p>
    <div class="fit-cols">
      <div class="fit-col fit-yes fade">
        <h2>{fit.goodLabel}</h2>
        <ul>{fit.good.map((t) => <li>{t.split('\n').map((l) => <span>{l}</span>)}</li>)}</ul>
      </div>
      <div class="fit-col fit-no fade">
        <h2>{fit.badLabel}</h2>
        <ul>{fit.bad.map((t) => <li>{t.split('\n').map((l) => <span>{l}</span>)}</li>)}</ul>
      </div>
    </div>
  </section>
)}

{on('security') && (
  <section class="blk blk-security">
    <p class="blk-label fade">{security.eyebrow}</p>
    <ul class="sec-list fade">
      {security.items.map((t) => <li>{t}</li>)}
    </ul>
  </section>
)}

{on('faq') && (
  <section class="blk blk-faq">
    <p class="blk-label fade">{faq.eyebrow}</p>
    <div class="faq-list fade">
      {faq.items.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
)}

{on('calc') && (
  <section class:list={['blk-calc', { blk: !inline, 'calc-inline': inline }]}>
    <p class="blk-label fade">{calc.eyebrow}</p>
    <div class="calc-card fade" data-calc>
      <h2>{calc.headline}</h2>
      <div class="calc-fields">
        {calc.fields.map((f) => (
          <div class="calc-row">
            <div class="calc-top">
              <label for={`c-${f.name}`}>{f.label}</label>
              <input id={`c-${f.name}`} type="number" inputmode="decimal" min={f.min} max={f.max * 10} step={f.step} name={f.name} value={f.value} />
            </div>
            <input type="range" min={f.min} max={f.max} step={f.step} value={f.value} data-range={f.name} aria-label={f.label} />
          </div>
        ))}
      </div>
      <div class="calc-tabs" role="tablist">
        {calc.periods.map((p) => (
          <button type="button" role="tab" data-days={p.days} data-key={p.key} data-label={p.label} aria-selected={p.key === calc.defaultPeriod ? 'true' : 'false'}>{p.label}</button>
        ))}
      </div>
      <div class="calc-result-box">
        <p class="calc-result-label"><span>{calc.resultLabel}</span> <span data-calc-per>month</span></p>
        <p class="calc-result" data-calc-out aria-live="polite">$0</p>
        <p class="calc-sub" data-calc-sub></p>
        <p class="calc-foot">{calc.footnote}</p>
      </div>
      <p class="calc-cta"><a class="cta" href={CTA_HREF}><span>{CTA_LABEL}</span></a></p>
    </div>
  </section>
)}

<script>
  const card = document.querySelector<HTMLElement>('[data-calc]');
  if (card) {
    const num = (n: string) => card.querySelector<HTMLInputElement>(`input[name="${n}"]`)!;
    const rng = (n: string) => card.querySelector<HTMLInputElement>(`input[data-range="${n}"]`)!;
    const out = card.querySelector<HTMLElement>('[data-calc-out]')!;
    const sub = card.querySelector<HTMLElement>('[data-calc-sub]')!;
    const per = card.querySelector<HTMLElement>('[data-calc-per]')!;
    const tabs = [...card.querySelectorAll<HTMLButtonElement>('.calc-tabs button')];
    const v = (n: string) => Math.max(0, parseFloat(num(n).value || '0') || 0);
    const fill = (r: HTMLInputElement) => {
      const lo = +r.min, hi = +r.max;
      r.style.setProperty('--fill', `${Math.min(100, Math.max(0, ((+r.value - lo) / (hi - lo)) * 100))}%`);
    };
    const run = () => {
      const tab = tabs.find((t) => t.getAttribute('aria-selected') === 'true') || tabs[2];
      const days = +(tab.dataset.days || 30);
      const calls = v('calls') * days;
      out.textContent = '$' + Math.round(calls * (v('close') / 100) * v('price')).toLocaleString('en-US');
      sub.textContent = `That's ${Math.round(calls).toLocaleString('en-US')} missed calls per ${tab.dataset.key}`;
      per.textContent = tab.dataset.key || 'month';
    };
    ['calls', 'close', 'price'].forEach((n) => {
      fill(rng(n));
      num(n).addEventListener('input', () => { rng(n).value = num(n).value; fill(rng(n)); run(); });
      rng(n).addEventListener('input', () => { num(n).value = rng(n).value; fill(rng(n)); run(); });
    });
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => x.setAttribute('aria-selected', x === t ? 'true' : 'false'));
      run();
    }));
    run();
  }
</script>

<style is:global>
  .v4 .blk {
    padding: 0 var(--gutter) clamp(80px, 13vh, 150px);
    max-width: 1240px;
    margin: 0 auto;
  }
  .v4 .blk-label {
    text-align: center;
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--gray);
    margin-bottom: clamp(28px, 5vh, 48px);
  }
  .v4 .blk-sublabel {
    margin-top: clamp(56px, 9vh, 96px);
  }

  /* Start here */
  .v4 .offer-head {
    text-align: center;
    font-weight: 200;
    font-size: var(--hd);
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--t1);
    text-wrap: balance;
  }
  .v4 .offer-cta {
    display: flex;
    justify-content: center;
    margin: clamp(24px, 4vh, 40px) 0 clamp(40px, 6.5vh, 72px);
  }
  .v4 .offer-cta-end {
    margin: clamp(40px, 6vh, 64px) 0 0;
  }
  .v4 .offer-cta .cta {
    margin-top: 0;
  }
  .v4 .offer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
  }
  .v4 .offer-card {
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 3vw, 44px);
    border-radius: 22px;
    background: var(--card);
    border: 1px solid var(--edge);
    text-align: center;
  }
  .v4 .offer-card h3 {
    font-weight: 300;
    font-size: clamp(26px, 2.5vw, 38px);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--t1);
    min-height: 2.3em;
    display: flex;
    align-items: center;
    justify-content: center;
    text-wrap: balance;
  }
  .v4 .offer-line span { display: block; }
  .v4 .offer-tag {
    margin-top: auto;
    padding-top: 22px;
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent-t);
  }
  .v4 .offer-line {
    margin: 18px auto 0;
    max-width: none;
    font-weight: 300;
    font-size: clamp(14px, 1.05vw, 16px);
    line-height: 1.65;
    color: var(--gray);
  }
  @media (min-width: 1240px) {
    .v4 .offer-line span { white-space: nowrap; }
  }

  /* Fit / not a fit */
  .v4 .blk-fit .blk-label {
    font-weight: 700;
    font-size: var(--hd);
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-transform: none;
    color: #0a0b0d;
    margin-bottom: clamp(32px, 6vh, 56px);
  }
  .v4 .fit-col li span { display: block; }
  .v4 .fit-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2.4vw, 36px);
    max-width: 1040px;
    margin: 0 auto;
  }
  .v4 .fit-col {
    padding: clamp(28px, 3vw, 44px);
    border-radius: 22px;
    background: var(--card);
    border: 1px solid var(--edge);
  }
  .v4 .fit-col h2 {
    font-weight: 700;
    font-size: clamp(17px, 1.4vw, 21px);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .v4 .fit-yes h2 { color: var(--accent-t); }
  .v4 .fit-no h2 { color: var(--t1); }
  .v4 .fit-col li,
  .v4 .sec-list li {
    position: relative;
    font-weight: 300;
    font-size: clamp(14px, 1.02vw, 16px);
    line-height: 1.55;
    color: var(--t1);
  }
  .v4 .fit-col li + li,
  .v4 .sec-list li + li {
    margin-top: 14px;
  }
  .v4 .fit-no li { color: var(--gray); }

  /* Data promises */
  .v4 .sec-list {
    max-width: 640px;
    margin: 0 auto;
  }

  /* FAQ */
  .v4 .faq-list {
    max-width: 820px;
    margin: 0 auto;
    border-top: 1px solid var(--rule);
  }
  .v4 .faq-list details {
    border-bottom: 1px solid var(--rule);
  }
  .v4 .faq-list summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 0;
    font-weight: 300;
    font-size: clamp(18px, 1.5vw, 22px);
    color: var(--white);
  }
  .v4 .faq-list summary::-webkit-details-marker { display: none; }
  .v4 .faq-list summary::after {
    content: '+';
    font-weight: 200;
    font-size: 28px;
    line-height: 1;
    color: var(--accent-t);
    transition: transform 0.3s ease;
  }
  .v4 .faq-list details[open] summary::after { transform: rotate(45deg); }
  .v4 .faq-list summary:focus-visible { outline: 2px solid var(--accent-t); outline-offset: 4px; }
  .v4 .faq-list details p {
    padding: 0 40px 24px 0;
    font-weight: 300;
    font-size: clamp(15px, 1.15vw, 18px);
    line-height: 1.7;
    color: var(--gray);
  }

  /* Calculator */
  .v4 .calc-card {
    max-width: 640px;
    margin: 0 auto;
    padding: clamp(28px, 4vw, 48px);
    border-radius: 28px;
    background: var(--card);
    border: 1px solid var(--edge);
  }
  .v4 .calc-card h2 {
    text-align: center;
    font-weight: 200;
    font-size: clamp(26px, 3vw, 40px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--t1);
  }
  .v4 .calc-fields {
    display: grid;
    gap: 28px;
    margin-top: clamp(28px, 4vh, 40px);
  }
  .v4 .calc-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .v4 .calc-top label {
    font-weight: 400;
    font-size: clamp(14px, 1.1vw, 16px);
    color: var(--t1);
  }
  .v4 .calc-top input {
    width: 112px;
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid var(--field-edge);
    background: var(--field);
    color: var(--t1);
    font: inherit;
    font-size: 18px;
    font-weight: 300;
    text-align: right;
  }
  .v4 .calc-top input:focus {
    outline: none;
    border-color: var(--accent-t);
    box-shadow: 0 0 0 3px rgb(0 159 164 / 0.25);
  }
  .v4 .calc-row input[type='range'] {
    --fill: 0%;
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 22px;
    margin-top: 10px;
    background: transparent;
    cursor: pointer;
  }
  .v4 .calc-row input[type='range']::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--accent-t) var(--fill), var(--edge) var(--fill));
  }
  .v4 .calc-row input[type='range']::-moz-range-track {
    height: 4px;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--accent-t) var(--fill), var(--edge) var(--fill));
  }
  .v4 .calc-row input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 22px;
    height: 22px;
    margin-top: -9px;
    border-radius: 50%;
    border: 2px solid var(--accent-t);
    background: var(--card);
  }
  .v4 .calc-row input[type='range']::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--accent-t);
    background: var(--card);
  }
  .v4 .calc-row input[type='range']:focus-visible {
    outline: 2px solid var(--accent-t);
    outline-offset: 4px;
  }
  .v4 .calc-tabs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    margin-top: 32px;
    padding: 6px;
    border-radius: 14px;
    background: var(--field);
  }
  .v4 .calc-tabs button {
    padding: 12px 6px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--gray);
    font: inherit;
    font-weight: 400;
    font-size: clamp(13px, 1vw, 15px);
    cursor: pointer;
    transition: background 0.3s ease, color 0.3s ease;
  }
  .v4 .calc-tabs button[aria-selected='true'] {
    background: var(--accent-t);
    color: #0a0b0d;
    font-weight: 500;
  }
  .v4 .calc-tabs button:focus-visible {
    outline: 2px solid var(--accent-t);
    outline-offset: 2px;
  }
  .v4 .calc-result-box {
    margin-top: 24px;
    padding: clamp(24px, 3vw, 36px) 20px;
    border-radius: 20px;
    text-align: center;
    background: var(--field);
    border: 1px solid var(--edge);
  }
  .v4 .calc-result-label {
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--gray);
  }
  .v4 .calc-result {
    margin-top: 12px;
    font-weight: 200;
    font-size: clamp(52px, 8vw, 96px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--accent-t);
  }
  .v4 .calc-sub {
    margin-top: 10px;
    font-weight: 300;
    font-size: clamp(15px, 1.2vw, 18px);
    color: var(--t1);
  }
  .v4 .calc-foot {
    margin: 16px auto 0;
    max-width: 38ch;
    font-weight: 300;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--gray);
  }
  .v4 .calc-cta {
    display: flex;
    justify-content: center;
    margin-top: 24px;
  }
  .v4 .calc-cta .cta {
    margin-top: 0;
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 820px) {
    .v4 .offer-grid,
    .v4 .fit-cols {
      grid-template-columns: 1fr;
    }
    .v4 .offer-card h3 {
      min-height: 0;
    }
  }
</style>
