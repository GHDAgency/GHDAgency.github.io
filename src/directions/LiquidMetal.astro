---
// V4: LIQUID METAL. Thin luxe type, brushed-alloy surfaces, slow parallax light pools, and the
// brand's own GHD logo animation (above the fold, and again as a beat in the problem sequence).
//
// The problem section can run five different scroll transitions, one per route:
//   noise  (/v4, /v4-noise)  Noise to Clarity: beats are pulled out of a cloud of fragments
//   line   (/v4-line)        The Revenue Line: a cyan pipeline with leaks runs under the beats
//   engine (/v4-engine)      Build the Engine: words slide in and lock between machined rails
//   plates (/v4-plates)      Stacked Plates: each beat on an alloy panel stacking over the last
//   rise   (/v4-rise)        Masked Rise: each line rises crisply from behind a hidden edge
import Layout from './Layout.astro';
import Words from './Words.astro';
import Marquee from './Marquee.astro';
import GhdLogo from './GhdLogo.astro';
import fs from 'node:fs';
import { industryIcon, industryDefs } from './industryIcons';
import ApplyForm from './ApplyForm.astro';
import Blocks from './Blocks.astro';
import {
  CTA_LABEL, CTA_HREF, HOME_HREF, nav, hero, heroServes, beats, howV4, industries, proof, fmt,
  solutionsPage, servicesPage, aboutPage, homePhoto, siteFooter, legalPages,
} from './copy';
import { disclosures } from '../data/site';

export type Transition = 'noise' | 'line' | 'engine' | 'plates' | 'rise';
export type Page = 'home' | 'solutions' | 'services' | 'about' | 'legal' | 'apply' | 'confirm';
interface Props {
  transition?: Transition;
  /** Which page of the Liquid Metal site to render (home is the full scroll story). */
  page?: Page;
  /** For page="legal": which policy (its text is passed in as the slot). */
  legal?: keyof typeof legalPages;
}
const { transition = 'noise', page = 'home', legal } = Astro.props;
const legalInfo = legal ? legalPages[legal] : null;
type Inner = { eyebrow: string; headline: string; sub: string; cta?: string };
const inner: Inner | null =
  page === 'home'
    ? null
    : page === 'legal'
      ? { eyebrow: legalInfo!.title, headline: '', sub: '' }
      : page === 'apply' || page === 'confirm'
        ? { eyebrow: page === 'confirm' ? 'Confirm' : CTA_LABEL, headline: '', sub: '' }
        : { solutions: solutionsPage, services: servicesPage, about: aboutPage }[page];
// Each inner page has its own button label; home (and the header) use the main CTA.
const ctaLabel = inner?.cta || CTA_LABEL;
// Photos appear only once their files are in public/media.
const hasFile = (src: string) => fs.existsSync(`public${src}`);
const showAboutPhoto = hasFile(aboutPage.photo);
const showHomePhoto = hasFile(homePhoto.src);
// People photography that breaks up the text on Solutions and Services.
const solPhotos = [
  '/media/people/sol-dealer.webp',
  '/media/people/sol-followup.webp',
  '/media/people/sol-medspa.webp',
  '/media/people/sol-optometry.webp',
  '/media/people/sol-reputation.webp',
];
const svcPhotos = ['/media/people/svc-find.webp', '/media/people/svc-build.webp', '/media/people/svc-grow.webp'];
// Line icons for the social links (24px grid, stroke-based).
const socialIcon: Record<string, string> = {
  LinkedIn: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5V17M8 7.2v.1M12 17v-3.8a2.7 2.7 0 0 1 5.4 0V17M12 10.5V17"/>',
  Facebook: '<circle cx="12" cy="12" r="9"/><path d="M13.2 21v-7.3h2.4l.4-2.8h-2.8V9.2c0-.8.3-1.4 1.4-1.4H16V5.3c-.3 0-1.1-.1-2-.1-2 0-3.3 1.2-3.3 3.4v2.3H8.3v2.8h2.4V21"/>',
  Instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><path d="M17.2 6.9v.1"/>',
};
const socials = siteFooter.social.filter((x) => x.href);
const pageTitle = page === 'home' ? 'GHD Agency' : `GHD Agency | ${inner!.eyebrow}`;
const here = page === 'home' ? HOME_HREF : nav.find((n) => n.href.includes(`/${page}/`))?.href;
const names: Record<Transition, string> = {
  noise: 'Noise to Clarity',
  line: 'The Revenue Line',
  engine: 'Build the Engine',
  plates: 'Stacked Plates',
  rise: 'Masked Rise',
};

type Beat = { lines: string[]; finale?: boolean; logo?: boolean };
const lead: Beat[] = beats.filter((b) => !b.finale);
const finale: Beat = beats.find((b) => b.finale)!;
const seq: Beat[] = [...lead, { lines: [], logo: true }, finale];

// Revenue Line: the stretches after the three "pain" beats are broken (leaking); the rest are whole.
const leaks = 3;

// Noise to Clarity: the background cloud is made only of fragments of the approved beat copy.
const fragments = [
  'a new AI tool', 'watched the demo', 'the webinars', 'zero time to spare', 'it sits unused',
  'the right tool?', 'grow my revenue?', 'you know you need it', 'another demo', 'the webinars',
  'it sits unused', 'a new AI tool', 'zero time to spare', 'the right tool?', 'watched the demo',
  'grow my revenue?', 'you know you need it', 'it sits unused',
];
let seed = 11;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const cloud = fragments.map((text) => ({
  text,
  x: Math.round(rnd() * 88 + 2),
  y: Math.round(rnd() * 86 + 5),
  size: +(0.7 + rnd() * 1.1).toFixed(2),
  depth: +(0.3 + rnd() * 1.2).toFixed(2),
}));
---

<Layout title={page === 'home' ? 'GHD Agency' : pageTitle} bodyClass={`v4 v4-${page}`}>
  <div class="pools" aria-hidden="true">
    <i data-par="0.12"></i>
    <i data-par="-0.08"></i>
    <i data-par="0.22"></i>
  </div>

  <header class="site-head" data-head>
    <a class="head-logo" href={HOME_HREF} aria-label="GHD home">
      <img src="/media/ghd-logo-end.webp" width="828" height="328" alt="GHD" />
    </a>
    <nav class="head-nav" aria-label="Main">
      {nav.map((n) => <a href={n.href} aria-current={n.href === here ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    {true ? (
      <div class="social head-social">
        {socials.map((x) => (
          <a href={x.href} target="_blank" rel="noopener" aria-label={`GHD on ${x.label}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={socialIcon[x.label]} />
          </a>
        ))}
      </div>
    ) : (
      <a class="cta cta-sm head-cta" href={CTA_HREF}><span>{CTA_LABEL}</span></a>
    )}
  </header>

  <main>
    {page === 'home' && (
    <Fragment>
    <!-- 1. HERO: the logo animation plays once on arrival, above the statement. -->
    <section class="hero">
      <div class="hero-inner" data-hero>
        <GhdLogo class="hero-logo" />
        <p class="eyebrow">{hero.eyebrow}</p>
        <p class="sub">{hero.subhead.map((l) => <span>{l}</span>)}</p>
        <h1 class="display metal">{hero.headline}</h1>
        <p class="serves">{heroServes}</p>
        <a class="cta" href={CTA_HREF}><span>{CTA_LABEL}</span></a>
      </div>
      <!-- 2. LOGO ROW: part of the hero, directly under the button. -->
      <div class="logos logos-hero" aria-label="Clients">
        <Marquee duration={55} />
      </div>
    </section>

    <!-- 3. THE PROBLEM -->
    <section class="problem" data-problem data-tr={transition} style={`--n:${seq.length}`}>
      <div class="stage">
        {
          transition === 'noise' && (
            <div class="noise" aria-hidden="true">
              {cloud.map((c) => (
                <span data-depth={c.depth} style={`left:${c.x}%;top:${c.y}%;font-size:${c.size}em`}>{c.text}</span>
              ))}
            </div>
          )
        }
        {
          transition === 'line' && (
            <div class="track" aria-hidden="true">
              {seq.map((_, i) => (
                <>
                  <span class="node" style={`--i:${i}`} />
                  {i < seq.length - 1 &&
                    (i < leaks ? (
                      <span class="seg broken" style={`--i:${i}`}>
                        <b class="a" />
                        <b class="b" />
                        <i class="drip" />
                        <i class="drip" />
                        <i class="drip" />
                      </span>
                    ) : (
                      <span class="seg whole" style={`--i:${i}`}>
                        <b class="full" />
                      </span>
                    ))}
                </>
              ))}
            </div>
          )
        }
        <div class="lines">
          {seq.map((b) => (
            <div class="pl fade" data-line class:list={{ finale: b.finale, 'logo-beat': b.logo }}>
              {transition === 'engine' && <i class="rail top" aria-hidden="true" />}
              {b.logo && (
                <div class="mask">
                  <div class="ln">
                    <GhdLogo class="beat-logo" />
                  </div>
                </div>
              )}
              {b.lines.map((line, j) => (
                <p class:list={{ partner: b.finale && j === 0, result: b.finale && j === 1 }}>
                  <span class="ln">
                    <Words text={line} class={b.finale ? (j === 0 ? 'w-silver' : 'w-cyan') : undefined} />
                  </span>
                </p>
              ))}
              {transition === 'engine' && <i class="rail bot" aria-hidden="true" />}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. HOW WE WORK: Find → Fix → Grow -->
    <section class="how">
      <p class="how-intro fade">{howV4.intro.map((l) => <span>{l}</span>)}</p>
      <ol class="steps fade">
        {howV4.steps.map((s) => (
          <li class="step">
            <span class="num idx metal">{s.n}</span>
            <div class="step-copy">
              <h2>{s.title}</h2>
              <p>{s.line.split('\n').map((l) => <span>{l}</span>)}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>


    <!-- RESULTS: directly above Start here -->
    {page === 'home' && (
    <section class="proof" data-proof>
      <div class="slab fade">
        <dl class="stats">
          {proof.stats.map((s) => (
            <div class="stat">
              <dt>{s.label}</dt>
              <dd class:list={['num', 'figure', s.money ? 'amber' : 'metal']} data-count={s.value} data-prefix={s.prefix} style={`min-width:${(s.prefix + fmt(s.value)).length}ch`}>
                {s.prefix + fmt(s.value)}
              </dd>
            </div>
          ))}
        </dl>
        <p class="foot">{proof.footnote}</p>
      </div>
    </section>
    )}

    <Blocks show={['offer']} />

    </Fragment>
    )}

    {page === 'apply' && <ApplyForm mode="apply" />}
    {page === 'confirm' && <ApplyForm mode="confirm" />}

    {inner && page !== 'apply' && page !== 'confirm' && (
      <section class:list={['page-hero', { 'page-hero-short': !inner.headline }]}>
        {/* Without a headline, the page name itself is the h1. */}
        {inner.headline ? <p class="eyebrow">{inner.eyebrow}</p> : <h1 class="eyebrow">{inner.eyebrow}</h1>}
        {inner.headline && <h1 class="display metal">{inner.headline}</h1>}
        {inner.sub && <p class="page-sub">{inner.sub}</p>}
      </section>
    )}

    {page === 'solutions' && (
      <section class="sol">
        <ol class="sol-list">
          {solutionsPage.items.map((it, i) => (
            <li class:list={['sol-item', 'fade', { flip: i % 2 === 1 }]}>
              <figure class="sol-photo" aria-hidden="true">
                <img src={solPhotos[i]} alt="" width="1400" height="933" loading="lazy" decoding="async" />
              </figure>
              <div class="sol-copy">
              <div class="sol-head">
                <span class="num sol-n">{i + 1}</span>
                {/* Non-breaking hyphens keep terms like Follow-Up whole on one line. */}
                <h2>{it.name.replaceAll('-', '‑')}</h2>
              </div>
              <dl class="sol-body">
                <div>
                  <dt>The Problem</dt>
                  <dd>{it.problem}</dd>
                </div>
                <div>
                  <dt>The Outcome</dt>
                  <dd class="sol-outcome">{it.outcome}</dd>
                </div>
              </dl>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    {page === 'solutions' && <Blocks show={['calc']} />}

    {page === 'services' && (
      <section class="svc">
        {servicesPage.groups.map((g, gi) => (
          <div class="svc-group">
            <div class="svc-lead fade">
              <div class="svc-step">
                <span class="num idx metal">{g.n}</span>
                <h2>{g.title}</h2>
              </div>
              <figure class="svc-photo" aria-hidden="true">
                <img src={svcPhotos[gi]} alt="" width="1400" height="933" loading="lazy" decoding="async" />
              </figure>
            </div>
            <ul class:list={['svc-grid', { 'cols-4': g.items.length === 4 }]}>
              {g.items.map((it) => (
                <li class="svc-item fade">
                  <h3>{it.name}</h3>
                  <p class="svc-line">{it.line}</p>
                  <ul class="svc-inc">
                    {it.includes.map((x) => <li>{x}</li>)}
                  </ul>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    )}

    {page === 'services' && <Blocks show={['offer', 'fit', 'security', 'faq']} />}

    {page === 'about' && (
      <section class="abt">
        <div class="abt-copy">
          {aboutPage.intro.map((lines) => <p class="abt-intro fade">{lines.map((l) => <span>{l}</span>)}</p>)}
        </div>
        <div class:list={['abt-story', { 'no-photo': !showAboutPhoto }]}>
          {showAboutPhoto && (
            <figure class="abt-photo fade">
              <img src={aboutPage.photo} alt={aboutPage.photoAlt} loading="lazy" decoding="async" />
            </figure>
          )}
          <div class="abt-story-copy">
            <p class="who-label abt-founder fade">{aboutPage.founder}</p>
            {aboutPage.story.map((para) => <p class="abt-body fade">{para}</p>)}
            <p class="abt-founded fade">{aboutPage.founded}</p>
          </div>
        </div>
        <p class="abt-purpose fade">{aboutPage.purpose}</p>
        <div class="abt-how">
          <p class="who-label fade">{aboutPage.howLabel}</p>
          <ol class="abt-how-list">
            {aboutPage.how.map((h) => (
              <li class="fade">
                <h2>{h.title}</h2>
                <p>{h.line.split('\n').map((l) => <span>{l}</span>)}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    {(page === 'home' || page === 'about') && (
    <Fragment>
    <!-- 5. WHO WE WORK WITH -->
    <section class="who">
      <Fragment set:html={industryDefs} />
      <p class="who-label fade">{industries.label}</p>
      <ul class="who-list">
        {industries.items.map((name, i) => (
          <li class="fade">
            <div class="ind-tile" set:html={industryIcon(i)} />
            {/* Keep "Trades &" and "Home Services" together so the name breaks cleanly. */}
            <span>{name.replace(' & ', ' & ').replace('Home Services', 'Home Services')}</span>
          </li>
        ))}
      </ul>
    </section>

    </Fragment>
    )}

    {false && showHomePhoto && (
      <section class="founder fade">
        <figure>
          <img src={homePhoto.src} alt={homePhoto.alt} loading="lazy" decoding="async" />
          <figcaption>{homePhoto.caption}</figcaption>
        </figure>
      </section>
    )}

    {page === 'legal' && (
      <section class="legal">
        <p class="legal-updated">Last Updated: {legalInfo!.updated}</p>
        <div class="legal-body">
          <slot />
          {legal === 'terms-and-conditions' && (
            <Fragment>
              <h2>Additional Disclosures</h2>
              {disclosures.filter((d) => d.title !== 'AI Disclosure').map((d) => <p><strong>{d.title}:</strong> {d.body}</p>)}
            </Fragment>
          )}
        </div>
      </section>
    )}

    <!-- 7. FINAL CTA -->
    {page !== 'legal' && page !== 'apply' && page !== 'confirm' && (
      <section class="final">
        <a class="cta fade" href={CTA_HREF}><span>{ctaLabel}</span></a>
      </section>
    )}
  </main>

  <footer class="site-foot">
    <div class="foot-top">
      <a class="foot-logo" href={HOME_HREF} aria-label="GHD home">
        <img src="/media/ghd-logo-end.webp" width="828" height="328" alt="GHD" loading="lazy" />
      </a>
      <nav class="foot-nav" aria-label="Footer">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <div class="foot-contact">
        <p>Phone: <a href={`tel:${siteFooter.tel}`}>{siteFooter.phone}</a> | Email: <a href={`mailto:${siteFooter.email}`}>{siteFooter.email}</a></p>
        <div class="social foot-social">
          {socials.map((x) => (
            <a href={x.href} target="_blank" rel="noopener" aria-label={`GHD on ${x.label}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={socialIcon[x.label]} />
            </a>
          ))}
        </div>
      </div>
    </div>
    <div class="foot-legal">
      <p class="foot-links">
        {siteFooter.legal.map((l) => <a href={l.href}>{l.label}</a>)}
      </p>
      <p class="foot-copy">{siteFooter.copyright}</p>
      <div class="foot-disclosures">
        {disclosures.filter((d) => d.title === 'AI Disclosure').map((d) => <p><strong>{d.title}:</strong> {d.body}</p>)}
      </div>
    </div>
  </footer>
</Layout>

<script>
  import { motion, onFrame, problemTimeline, pinProgress, fades, countUp, clamp, ease } from './engine';

  fades();
  const proofBand = document.querySelector('[data-proof]');
  if (proofBand) countUp(proofBand);

  if (motion()) {
    // Above the fold: the logo animation plays once as the page opens.
    document.querySelector<HTMLVideoElement>('.hero-logo .ghd-video')?.play().catch(() => {});

    // Header: on the home page its small logo appears once the hero logo has scrolled away.
    const head = document.querySelector<HTMLElement>('[data-head]');
    const heroLogo = document.querySelector<HTMLElement>('.hero-logo');
    if (head && heroLogo) onFrame(() => head.classList.toggle('show-logo', heroLogo.getBoundingClientRect().bottom < 0));

    // Slow parallax: light pools and plates drift at their own rates; the hero recedes as you leave it.
    const par = Array.from(document.querySelectorAll<HTMLElement>('[data-par]'));
    const heroInner = document.querySelector<HTMLElement>('[data-hero]');
    onFrame(() => {
      const y = scrollY;
      par.forEach((el) => {
        const r = Number(el.dataset.par);
        const off = el.closest('.pools') ? y * r : (el.getBoundingClientRect().top + el.offsetHeight / 2 - innerHeight / 2) * r;
        el.style.translate = `0 ${(-off).toFixed(1)}px`;
      });
      const k = clamp(y / innerHeight);
      // The hero stays put (no downward drift toward the logo band) and simply fades as you leave it.
      if (heroInner) heroInner.style.opacity = String(1 - k * 0.9);
    });

    const section = document.querySelector<HTMLElement>('[data-problem]');
    if (section) {
    const tr = section.dataset.tr;
    // Noise to Clarity animates each beat's words on a timer once the beat is reached, so the
    // scroll only chooses which beat is showing; the other transitions scrub the words to scroll.
    const tl = problemTimeline(section, '[data-line]', tr === 'noise' ? 0.05 : 0.18, tr !== 'noise');
    const beatEls = Array.from(section.querySelectorAll<HTMLElement>('[data-line]'));

    // The logo beat plays the brand animation once as it arrives; scrolling back above rewinds it.
    const logos = beatEls.map((el) => {
      const video = el.querySelector<HTMLVideoElement>('.ghd-video');
      return video ? { video, started: false } : null;
    });
    let loaded = false;
    // "Your Growth Partner. We answer with Results." loads by itself when the logo animation ends,
    // so the visitor never has to scroll to see it. The timer covers a video that cannot play.
    const logoIdx = beatEls.findIndex((el) => el.classList.contains('logo-beat'));
    const finIdx = beatEls.findIndex((el) => el.classList.contains('finale'));
    let logoDone = false;
    let doneTimer = 0;

    // Per-word start offsets: scattered for Noise to Clarity, directional for Build the Engine.
    if (tr === 'noise' || tr === 'engine') {
      let seed = 3;
      const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
      beatEls.forEach((el) =>
        el.querySelectorAll<HTMLElement>('.w').forEach((w, wi) => {
          if (tr === 'noise') {
            w.style.setProperty('--wi', String(wi));
            w.style.setProperty('--dx', `${((rnd() - 0.5) * innerWidth * 0.7).toFixed(0)}px`);
            w.style.setProperty('--dy', `${((rnd() - 0.5) * innerHeight * 0.6).toFixed(0)}px`);
            w.style.setProperty('--rot', `${((rnd() - 0.5) * 24).toFixed(1)}deg`);
          } else {
            const dir = wi % 4;
            w.style.setProperty('--dx', `${[-80, 80, 0, 0][dir]}px`);
            w.style.setProperty('--dy', `${[0, 0, -36, 36][dir]}px`);
          }
        }),
      );
    }

    const noise = section.querySelector<HTMLElement>('.noise');
    const frags = noise ? Array.from(noise.children as HTMLCollectionOf<HTMLElement>) : [];
    const track = section.querySelector<HTMLElement>('.track');
    const segs = track ? Array.from(track.querySelectorAll<HTMLElement>('.seg')) : [];
    const nodes = track ? Array.from(track.querySelectorAll<HTMLElement>('.node')) : [];

    onFrame(() => {
      if (!loaded && section.getBoundingClientRect().top < innerHeight * 2) {
        loaded = true;
        logos.forEach((l) => l?.video.load());
      }

      const { lines, pos, lp } = tl(pinProgress(section));
      const n = lines.length;
      // Noise to Clarity: the beat currently on stage (none until the stage is in view).
      const cur = section.getBoundingClientRect().top < innerHeight * 0.25 ? Math.min(n - 1, Math.floor(pos + 0.25)) : -1;

      logos.forEach((l, i) => {
        if (!l) return;
        const d = pos - i;
        const arrive = tr === 'noise' ? i === cur : d > -0.02;
        const leave = tr === 'noise' ? i > cur : d <= -0.1;
        if (arrive && !l.started) {
          l.started = true;
          l.video.currentTime = 0;
          l.video.play().catch(() => {});
          if (i === logoIdx) {
            logoDone = false;
            clearTimeout(doneTimer);
            // The frame loop only runs on scroll, so wake it when the animation is done.
            const markDone = () => {
              logoDone = true;
              dispatchEvent(new Event('scroll'));
            };
            l.video.addEventListener('ended', markDone, { once: true });
            doneTimer = window.setTimeout(markDone, 4300);
          }
        } else if (leave && l.started) {
          l.started = false;
          l.video.pause();
          l.video.currentTime = 0;
          if (i === logoIdx) {
            logoDone = false;
            clearTimeout(doneTimer);
          }
        }
      });

      lines.forEach((el, i) => {
        const d = pos - i;
        const last = i === n - 1;

        if (tr === 'rise') {
          // Each line rises from behind an invisible edge, then lifts away. Crisp, no overlap.
          const e = ease(clamp((d + 0.12) / 0.24));
          const x = last ? 0 : ease(clamp((d - 0.74) / 0.18));
          el.style.setProperty('--ty', ((1 - e) * 110 - x * 110).toFixed(2));
          el.style.opacity = d > -0.14 && (last || d < 0.94) ? '1' : '0';
        } else if (tr === 'plates') {
          // Each beat is a panel that slides up and settles; earlier panels step back beneath it.
          const e = ease(clamp((d + 0.22) / 0.3));
          let dep = 0;
          for (let j = i + 1; j < n; j++) dep += ease(clamp((pos - j + 0.22) / 0.3));
          const y = (1 - e) * innerHeight * 1.1 - dep * 22;
          el.style.transform = `translate(-50%, calc(-50% + ${y.toFixed(1)}px)) scale(${(1 - dep * 0.05).toFixed(4)})`;
          el.style.setProperty('--dim', Math.min(0.8, dep * 0.4).toFixed(3));
          el.style.opacity = e > 0.001 && dep < 3 ? '1' : '0';
          el.style.zIndex = String(i + 1);
        } else if (tr === 'noise') {
          // The beat's words fly in from the noise and settle on their own (CSS transitions,
          // staggered word by word); when the next beat arrives they dissolve back into it.
          if (logoIdx >= 0 && finIdx >= 0 && i === logoIdx) {
            const fin = cur === finIdx || (cur === logoIdx && logoDone);
            el.classList.toggle('on', i === cur || cur === finIdx);
            el.classList.toggle('lift', fin);
          } else if (logoIdx >= 0 && finIdx >= 0 && i === finIdx) {
            el.classList.toggle('on', i === cur || (cur === logoIdx && logoDone));
          } else {
            el.classList.toggle('on', i === cur);
          }
        } else if (tr === 'engine') {
          // Words slide in and lock; the rails close in around them and light when it's complete.
          const o = clamp((d + 0.2) / 0.14);
          const x = last ? 0 : ease(clamp((d - 0.76) / 0.16));
          el.style.opacity = (o * (1 - x)).toFixed(3);
          el.style.transform = `translate(-50%, calc(-50% - ${(x * 40).toFixed(1)}px))`;
          el.style.setProperty('--rail', clamp(lp[i] * 1.25).toFixed(3));
          el.classList.toggle('locked', lp[i] >= 0.999);
        } else if (tr === 'line') {
          const o = clamp((d + 0.2) / 0.15);
          const x = last ? 0 : ease(clamp((d - 0.76) / 0.16));
          el.style.opacity = (o * (1 - x)).toFixed(3);
          el.style.transform = `translate(-50%, calc(-50% + ${((1 - o) * 14 - x * 14).toFixed(1)}px))`;
        }
      });

      if (noise) {
        // The noise clears as the story moves toward GHD; it is gone by the logo beat.
        noise.style.opacity = (1 - clamp(pos / (n - 2))).toFixed(3);
        frags.forEach((f) => (f.style.translate = `-50% calc(-50% - ${(pos * 36 * Number(f.dataset.depth)).toFixed(1)}px)`));
      }

      if (track) {
        // The pipeline slides under the beats: each beat is a stop; after the pain beats the line
        // is broken and leaks, and from "The Market Leaders" on it runs whole into GHD.
        const S = Math.min(560, Math.max(240, innerWidth * 0.42));
        track.style.setProperty('--S', `${S}px`);
        const k = Math.min(Math.floor(pos), n - 1);
        const s = k - 1 + ease(clamp((pos - k) / 0.3));
        track.style.transform = `translate3d(${(innerWidth / 2 - s * S).toFixed(1)}px, 0, 0)`;
        segs.forEach((seg, i) => seg.style.setProperty('--f', clamp(s - i).toFixed(3)));
        nodes.forEach((node, i) => node.classList.toggle('lit', s >= i - 0.001));
      }
    });
    }
  }
</script>

