    letter-spacing: 0.3em;
    color: var(--cyan);
  }
  .v4 .principles p {
    margin-top: 12px;
    font-weight: 300;
    font-size: clamp(16px, 1.25vw, 19px);
    color: var(--gray);
  }
  .v4 .belief {
    margin: clamp(96px, 16vh, 180px) auto 0;
    text-align: center;
    font-weight: 200;
    font-size: clamp(28px, 3.4vw, 56px);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .v4 .belief span {
    display: block;
  }
  .v4 .belief span:last-child {
    margin-top: 0.4em;
    font-size: 0.6em;
    color: var(--gray);
  }
  .v4 .direct {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin: clamp(80px, 12vh, 128px) auto 0;
    font-weight: 300;
    font-size: clamp(18px, 1.6vw, 24px);
  }
  .v4 .direct a {
    color: #e6ebee;
    border-bottom: 1px solid rgb(0 255 255 / 0.35);
    padding-bottom: 2px;
  }
  .v4 .direct a:hover {
    color: var(--cyan);
  }
  .v4-about .who {
    padding-top: clamp(40px, 8vh, 96px);
  }

  /* Entrances on inner pages: rows slide in from the left, like the home steps. */
  .m .v4 .sol-item.fade:not(.in),
  .m .v4 .svc-item.fade:not(.in) {
    transform: translateX(-48px);
  }
  .m .v4 .svc-item:nth-child(3n + 2) { transition-delay: 0.15s; }
  .m .v4 .svc-item:nth-child(3n) { transition-delay: 0.3s; }

  /* HOME: the secondary link under the hero button */
  .v4 .explore {
    margin-top: 14px;
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gray);
    border-bottom: 1px solid rgb(138 148 156 / 0.4);
    padding-bottom: 3px;
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  .v4 .explore:hover {
    color: var(--white);
    border-color: var(--cyan);
  }
  .m .v4 .explore {
    animation: v4-up 1.2s 1.45s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* HERO */
  .v4 .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(84px, 12svh, 120px) var(--gutter) clamp(32px, 5svh, 56px);
    text-align: center;
    overflow: hidden;
  }
  .v4 .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    will-change: transform, opacity;
  }
  .v4 .hero-logo {
    width: clamp(140px, min(14vw, 22svh), 220px);
    margin-bottom: clamp(20px, 3.4svh, 36px);
  }
  .v4 .eyebrow {
    display: flex;
    align-items: center;
    gap: 18px;
    font-weight: 300;
    font-size: clamp(14px, 1.4vw, 20px);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: #e6ebee;
    margin-bottom: clamp(20px, 3.2svh, 36px);
  }
  .v4 .eyebrow::before,
  .v4 .eyebrow::after {
    content: '';
    width: clamp(32px, 6vw, 80px);
    height: 1px;
    background: var(--tc);
    box-shadow: 0 0 8px rgb(0 255 255 / 0.6);
  }
  .v4 .eyebrow::before {
    transform: scaleX(-1);
  }
  .v4 .display {
    font-weight: 200;
    font-size: clamp(38px, min(5.6vw, 7.2svh), 100px);
    line-height: 1.04;
    letter-spacing: -0.025em;
    max-width: 15ch;
    padding-bottom: 0.08em;
  }
  /* Home hero: the tagline and the statement share one size and face; the statement is the brighter line. */
  .v4 .hero-inner .display {
    font-size: clamp(30px, min(3.6vw, 5svh), 58px);
    max-width: none;
    color: #aab3b9;
  }
  .v4 .sub {
    margin-top: clamp(22px, 3.4svh, 40px);
    font-weight: 300;
    font-size: clamp(16px, 1.25vw, 19px);
    line-height: 1.7;
    letter-spacing: 0.01em;
    color: var(--gray);
  }
  /* The statement of what we do: the tagline's exact face and size, brighter. */
  .v4 .hero-inner .sub {
    margin-top: 0;
    font-weight: 200;
    font-size: clamp(30px, min(3.6vw, 5svh), 58px);
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: #ffffff;
  }
  .v4 .hero-inner .sub span {
    text-wrap: balance;
  }
  @media (min-width: 900px) {
    .v4 .hero-inner .sub span,
    .v4 .hero-inner .display {
      white-space: nowrap;
    }
  }
  .v4 .sub span {
    display: block;
  }
  /* Hero order: eyebrow, then the three-line statement, then the headline under it. */
  .v4 .hero-inner .eyebrow + .sub {
    margin-top: 0;
  }
  .v4 .hero-inner .sub + .display {
    margin-top: clamp(30px, 5svh, 56px);
  }
  .v4 .serves {
    margin-top: clamp(18px, 2.8svh, 32px);
    padding: 0 clamp(8px, 2vw, 32px);
    font-weight: 300;
    font-size: clamp(15px, 1.35vw, 21px);
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: #9aa3aa;
    text-wrap: balance;
  }
  .v4 .cta {
    position: relative;
    display: inline-flex;
    margin-top: clamp(26px, 4svh, 48px);
    padding: 13px 30px;
    border-radius: 999px;
    border: 1px solid transparent;
    background:
      linear-gradient(180deg, #1c2024, #0e1012) padding-box,
      linear-gradient(135deg, #e6ebee, #8a949c 40%, #009fa4 70%, #00ffff) border-box;
    color: var(--cyan);
    font-weight: 400;
    font-size: 11.5px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.12), 0 8px 24px -14px rgb(0 255 255 / 0.35);
    transition: box-shadow 0.4s ease, transform 0.4s ease;
  }
  .v4 .cta:hover {
    transform: translateY(-2px);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.16), 0 0 0 4px rgb(0 255 255 / 0.08), 0 16px 56px -10px rgb(0 255 255 / 0.7);
  }
  /* The headline stays visible from the first paint (it is the LCP element); the rest follows the logo. */
  .m .v4 .eyebrow,
  .m .v4 .sub,
  .m .v4 .serves,
  .m .v4 .hero .cta {
    animation: v4-up 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .m .v4 .eyebrow { animation-delay: 0.5s; }
  .m .v4 .sub { animation-delay: 0.9s; }
  .m .v4 .serves { animation-delay: 1.05s; }
  .m .v4 .hero .cta { animation-delay: 1.2s; }
  @keyframes v4-up {
    from { opacity: 0; transform: translateY(16px); }
  }

  /* LOGOS */
  /* The logo band inside the hero, directly under the button. */
  .v4 .logos.logos-hero {
    width: 100%;
    max-width: 1240px;
    margin: clamp(40px, 7svh, 80px) auto 0;
    padding: clamp(12px, 2svh, 22px) 0 clamp(14px, 2.2svh, 26px);
  }
  .v4 .logos-hero .mq {
    --logo-h: clamp(32px, 4.2svh, 40px);
  }
  .m .v4 .logos-hero {
    animation: v4-up 1.2s 1.35s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .v4 .logos {
    position: relative;
    /* Breathing room between the hero CTA and the logo band. */
    margin: clamp(96px, 16vh, 180px) var(--gutter) 0;
    padding: 36px 0 44px;
    border-radius: 24px;
    background: var(--brush), var(--alloy);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08), 0 30px 60px -30px rgb(0 0 0 / 0.8);
  }
  .v4 .logos::before {
    content: '';
    position: absolute;
    left: 10%;
    right: 10%;
    top: 0;
    height: 1px;
    background: var(--edge-hi);
  }
  .v4 .mq {
    --logo-h: 46px;
  }
  .v4 .mq li:hover img {
    filter: drop-shadow(0 0 12px rgb(230 235 238 / 0.45));
  }

  /* ================= PROBLEM: shared ================= */
  .v4 .problem {
    padding: 16vh var(--gutter);
    text-align: center;
  }
  .v4 .lines {
    display: flex;
    flex-direction: column;
    gap: 0.6em;
  }
  .v4 .pl {
    font-weight: 200;
    font-size: clamp(30px, 4.2vw, 76px);
    line-height: 1.18;
    letter-spacing: -0.02em;
  }
  .v4 .pl p + p {
    margin-top: 0.2em;
  }
  .v4 .pl .ln {
    display: block;
  }
  .v4 .pl.finale .result {
    margin-top: 0.55em;
    font-weight: 300;
  }
  .v4 .beat-logo {
    width: min(84vw, 760px);
    margin: 0 auto;
  }
  .v4 .noise,
  .v4 .track,
  .v4 .rail {
    display: none;
  }

  .m .v4 .problem {
    height: calc(var(--n) * 95svh + 140svh);
    padding: 0;
  }
  .m .v4 .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background: radial-gradient(ellipse 70% 55% at 50% 50%, #121417, rgb(18 20 23 / 0) 70%);
  }
  .m .v4 .pl {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(88vw, 36ch);
    opacity: 0;
    transform: translate(-50%, -50%);
    will-change: transform, opacity;
  }
  .m .v4 .pl.logo-beat {
    width: min(90vw, 780px);
  }

  /* ================= 1. Noise to Clarity ================= */
  /* Registering --p lets each word's reveal state transition smoothly on its own. */
  @property --p {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }
  /* Scroll travel = one equal share per beat (the stage itself adds one screen). */
  .m .v4 .problem[data-tr='noise'] {
    height: calc(var(--n) * 46svh + 100svh);
  }
  /* The final beat sits mid-stage; pull the next section up so the gap matches the story's rhythm. */
  .m .v4 .problem[data-tr='noise'] + .how {
    margin-top: -8svh;
    position: relative;
  }
  .m .v4 [data-tr='noise'] .pl {
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.35s ease !important;
  }
  .m .v4 [data-tr='noise'] .pl.on {
    opacity: 1;
    transition: opacity 0.3s ease !important;
  }
  /* The logo lifts and the finale settles beneath it, so the two read as one closing frame. */
  .m .v4 [data-tr='noise'] .pl.logo-beat {
    transition: opacity 0.35s ease, transform 1.1s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }
  .m .v4 [data-tr='noise'] .pl.logo-beat.lift {
    transform: translate(-50%, calc(-50% - 15svh));
  }
  .m .v4 [data-tr='noise'] .pl.finale {
    top: calc(50% + 7svh);
    transform: translate(-50%, 0);
  }
  .m .v4 [data-tr='noise'] .pl .w {
    --p: 0;
    transition: --p 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .m .v4 [data-tr='noise'] .pl.on .w {
    --p: 1;
    transition: --p 1.1s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--wi, 0) * 70ms + 120ms);
  }
  .m .v4 [data-tr='noise'] .noise span:nth-child(odd) {
    animation: v4-float 11s ease-in-out infinite alternate;
  }
  .m .v4 [data-tr='noise'] .noise span:nth-child(even) {
    animation: v4-float 14s ease-in-out -5s infinite alternate-reverse;
  }
  @keyframes v4-float {
    from { transform: translate(-14px, 6px); }
    to { transform: translate(18px, -10px); }
  }
  .m .v4 [data-tr='noise'] .noise {
    display: block;
    position: absolute;
    inset: 0;
    font-size: clamp(14px, 1.5vw, 22px);
    font-weight: 300;
    color: var(--gray);
    pointer-events: none;
  }
  .m .v4 [data-tr='noise'] .noise span {
    position: absolute;
    white-space: nowrap;
    opacity: 0.22;
    translate: -50% -50%;
    will-change: translate, transform;
  }
  .m .v4 [data-tr='noise'] .noise span:nth-child(3n) {
    opacity: 0.12;
  }
  .m .v4 [data-tr='noise'] .pl .w {
    display: inline-block;
    transform: translate(calc(var(--dx, 0px) * (1 - var(--p))), calc(var(--dy, 0px) * (1 - var(--p)))) rotate(calc(var(--rot, 0deg) * (1 - var(--p))));
  }

  /* ================= 2. The Revenue Line ================= */
  .m .v4 [data-tr='line'] .pl {
    top: 42%;
  }
  .m .v4 [data-tr='line'] .track {
    display: block;
    position: absolute;
    left: 0;
    top: 74%;
    height: 2px;
    will-change: transform;
  }
  .v4 [data-tr='line'] .node {
    position: absolute;
    left: calc(var(--S) * var(--i));
    top: 50%;
    width: 11px;
    height: 11px;
    margin: -5.5px 0 0 -5.5px;
    border-radius: 50%;
    border: 1px solid rgb(138 148 156 / 0.5);
    background: var(--base);
    transition: background 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease;
  }
  .v4 [data-tr='line'] .node.lit {
    background: var(--cyan);
    border-color: var(--cyan);
    box-shadow: 0 0 14px var(--cyan);
  }
  .v4 [data-tr='line'] .seg {
    position: absolute;
    left: calc(var(--S) * var(--i) + 12px);
    width: calc(var(--S) - 24px);
    top: 0;
    height: 2px;
  }
  .v4 [data-tr='line'] .seg b {
    position: absolute;
    top: 0;
    height: 100%;
    background: linear-gradient(90deg, var(--teal), var(--cyan));
    box-shadow: 0 0 10px rgb(0 255 255 / 0.55);
    transform-origin: left;
  }
  .v4 [data-tr='line'] .seg::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(90deg, rgb(138 148 156 / 0.35) 0 6px, transparent 6px 12px);
  }
  .v4 [data-tr='line'] .seg.whole b {
    left: 0;
    width: 100%;
    transform: scaleX(var(--f, 0));
  }
  /* A broken stretch: two halves with a gap where revenue leaks out. */
  .v4 [data-tr='line'] .seg.broken::before {
    background:
      linear-gradient(90deg, rgb(138 148 156 / 0.35) 0 40%, transparent 40% 60%, rgb(138 148 156 / 0.35) 60% 100%);
  }
  .v4 [data-tr='line'] .seg.broken .a {
    left: 0;
    width: 40%;
    transform: scaleX(clamp(0, calc(var(--f, 0) * 2.5), 1));
  }
  .v4 [data-tr='line'] .seg.broken .b {
    left: 60%;
    width: 40%;
    transform: scaleX(clamp(0, calc(var(--f, 0) * 2.5 - 1.5), 1));
  }
  .v4 [data-tr='line'] .drip {
    position: absolute;
    left: calc(40% + 6px);
    top: 0;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 6px var(--cyan);
    opacity: clamp(0, calc(var(--f, 0) * 3 - 1.1), 1);
    animation: v4-drip 1.8s cubic-bezier(0.5, 0, 1, 1) infinite;
  }
  .v4 [data-tr='line'] .drip:nth-of-type(2) {
    left: 50%;
    animation-delay: 0.6s;
  }
  .v4 [data-tr='line'] .drip:nth-of-type(3) {
    left: calc(60% - 9px);
    animation-delay: 1.2s;
  }
  @keyframes v4-drip {
    from { translate: 0 0; scale: 1; }
    to { translate: 0 90px; scale: 0.3; }
  }

  /* ================= 3. Build the Engine ================= */
  .m .v4 [data-tr='engine'] .pl .w {
    display: inline-block;
    transform: translate(calc(var(--dx, 0px) * (1 - var(--p)) * (1 - var(--p))), calc(var(--dy, 0px) * (1 - var(--p)) * (1 - var(--p))));
  }
  .m .v4 [data-tr='engine'] .rail {
    display: block;
    position: absolute;
    left: -6%;
    right: -6%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(138 148 156 / 0.8), transparent);
    transform: scaleX(var(--rail, 0));
    transition: background 0.5s ease, box-shadow 0.5s ease;
  }
  .m .v4 [data-tr='engine'] .rail.top {
    top: -0.45em;
  }
  .m .v4 [data-tr='engine'] .rail.bot {
    bottom: -0.45em;
  }
  .m .v4 [data-tr='engine'] .pl.locked .rail {
    background: linear-gradient(90deg, transparent, var(--cyan), transparent);
    box-shadow: 0 0 12px rgb(0 255 255 / 0.5);
  }

  /* ================= 4. Stacked Plates ================= */
  .m .v4 [data-tr='plates'] .pl {
    width: min(92vw, 1100px);
    min-height: min(70svh, 620px);
    display: grid;
    place-content: center;
    padding: clamp(28px, 5vw, 72px);
    border-radius: 28px;
    background: var(--brush), var(--alloy);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.1), 0 -30px 80px -30px rgb(0 0 0 / 0.9);
  }
  .m .v4 [data-tr='plates'] .pl::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: #000;
    opacity: var(--dim, 0);
    pointer-events: none;
  }
  .m .v4 [data-tr='plates'] .pl p {
    max-width: 30ch;
    margin-inline: auto;
  }

  /* ================= 5. Masked Rise ================= */
  .m .v4 [data-tr='rise'] .pl {
    transform: translate(-50%, -50%);
  }
  .m .v4 [data-tr='rise'] .pl p,
  .m .v4 [data-tr='rise'] .pl .mask {
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .m .v4 [data-tr='rise'] .pl .ln {
    transform: translateY(calc(var(--ty, 110) * 1%));
  }
  .m .v4 [data-tr='rise'] .pl p:nth-of-type(2) .ln {
    transform: translateY(calc(min(110, var(--ty, 110) * 1.35) * 1%));
  }

  /* HOW WE WORK */
  .v4 .how {
    padding: clamp(40px, 7vh, 80px) var(--gutter) clamp(96px, 18vh, 200px);
  }
  .v4 .how-intro {
    margin: 0 auto clamp(64px, 12vh, 128px);
    text-align: center;
    font-weight: 200;
    font-size: clamp(26px, 3.3vw, 56px);
    line-height: 1.24;
    letter-spacing: -0.015em;
  }
  .v4 .how-intro span {
    display: block;
  }
  .v4 .how-intro span:last-child {
    margin-top: 0.35em;
    color: #e6ebee;
  }
  /* Steps stack top to bottom in one centered column. Numerals share a fixed-width column so
     every title and line starts on the same vertical edge. */
  .v4 .steps {
    max-width: 860px;
    margin: 0 auto;
  }
  .v4 .step {
    display: grid;
    grid-template-columns: clamp(64px, 9vw, 132px) 1fr;
    align-items: center;
    column-gap: clamp(20px, 3vw, 48px);
    padding: clamp(24px, 3.5vh, 40px) 0;
    border-top: 1px solid transparent;
    border-image: linear-gradient(90deg, transparent, rgb(230 235 238 / 0.24), transparent) 1;
  }
  .v4 .step:first-child {
    border-top: 0;
  }
  .v4 .idx {
    font-size: clamp(64px, 7vw, 112px);
    font-weight: 100;
    line-height: 1;
    text-align: center;
  }
  .v4 .step h2 {
    font-weight: 300;
    font-size: clamp(24px, 2.4vw, 36px);
    line-height: 1.2;
    letter-spacing: -0.005em;
    color: var(--white);
  }
  .v4 .step p span,
  .v4 .abt-how-list p span {
    display: block;
  }
  @media (min-width: 760px) {
    .v4 .step p span {
      white-space: nowrap;
    }
  }
  .v4 .step p {
    margin-top: 10px;
    max-width: 52ch;
    font-weight: 300;
    font-size: clamp(15px, 1.15vw, 18px);
    line-height: 1.65;
    color: var(--gray);
  }
  /* Entrance: when the list comes into view, step 1 slides in from the left to its place, then
     step 2, then step 3, each fading in as it travels. */
  .m .v4 .steps.fade:not(.in) {
    opacity: 1;
    transform: none;
  }
  .m .v4 .step {
    opacity: 0;
    transform: translateX(-55vw);
    transition: opacity 0.9s ease, transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .m .v4 .steps.in .step {
    opacity: 1;
    transform: none;
  }
  .m .v4 .steps.in .step:nth-child(2) { transition-delay: 0.4s; }
  .m .v4 .steps.in .step:nth-child(3) { transition-delay: 0.8s; }
  .m .v4 .steps.in .step:nth-child(4) { transition-delay: 1.2s; }
  .m .v4 .steps.in .step:nth-child(5) { transition-delay: 1.6s; }

  /* WHO WE WORK WITH */
  .v4 .who {
    padding: 0 var(--gutter) clamp(96px, 16vh, 180px);
    text-align: center;
  }
  .v4 .who-label {
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--gray);
    margin-bottom: clamp(28px, 5vh, 48px);
  }
  .v4 .who-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2.2vw, 32px);
    max-width: 1320px;
    margin: 0 auto;
  }
  .v4 .who-list li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(16px, 2.2vw, 26px);
    font-weight: 300;
