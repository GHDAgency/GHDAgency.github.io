---
// The GHD logo animation, played from the brand's own MP4 (public/media/ghd-logo.mp4):
// G, then H, then D resolve, then the cyan swoop lights up along its channel and ties them together.
//
// The MP4 has a near-black background. Rather than hiding it with a CSS blend mode (which can make
// some graphics cards flicker), each video frame is drawn onto a canvas with the black keyed out to
// real transparency. Pages call play() on `.ghd-video`; the canvas follows it. Without JS, or with
// reduced motion, the finished final frame shows as a transparent still.
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---

<div class={`ghd ${cls}`} role="img" aria-label="GHD">
  <img class="ghd-still" src="/media/ghd-logo-end.webp" width="828" height="328" alt="" loading="lazy" decoding="async" />
  <canvas class="ghd-canvas" width="828" height="328" aria-hidden="true"></canvas>
  <video class="ghd-video" src="/media/ghd-logo.mp4" width="828" height="328" muted playsinline preload="none" aria-hidden="true"></video>
</div>

<script>
  // Key out only the video's near-black background (about rgb 6, 8, 11). Everything brighter,
  // including the letters' dark lower halves, stays opaque; colours are left untouched.
  function key(ctx: CanvasRenderingContext2D, video: HTMLVideoElement, w: number, h: number) {
    ctx.drawImage(video, 0, 0, w, h);
    const img = ctx.getImageData(0, 0, w, h);
    const d = img.data;
    for (let i = 0; i < d.length; i += 4) {
      const m = Math.max(d[i], d[i + 1], d[i + 2]);
      d[i + 3] = Math.min(255, Math.max(0, (m - 13) * 9));
    }
    ctx.putImageData(img, 0, 0);
  }

  document.querySelectorAll<HTMLElement>('.ghd').forEach((el) => {
    const video = el.querySelector<HTMLVideoElement>('.ghd-video')!;
    const canvas = el.querySelector<HTMLCanvasElement>('.ghd-canvas')!;
    const ctx = canvas.getContext('2d', { willReadFrequently: true });
    if (!ctx) return;
    const { width: w, height: h } = canvas;
    const paint = () => {
      if (video.readyState >= 2) key(ctx, video, w, h);
    };
    const loop = () => {
      paint();
      if (!video.paused && !video.ended) {
        if ('requestVideoFrameCallback' in video) (video as any).requestVideoFrameCallback(loop);
        else requestAnimationFrame(loop);
      }
    };
    video.addEventListener('play', loop);
    video.addEventListener('seeked', paint);
    video.addEventListener('ended', paint);
  });
</script>

<style is:global>
  .ghd {
    position: relative;
    aspect-ratio: 828 / 328;
    width: 100%;
  }
  .ghd-still,
  .ghd-canvas,
  .ghd-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* The video only feeds the canvas; it is never shown. */
  .ghd-video {
    opacity: 0;
    pointer-events: none;
  }
  .ghd-canvas {
    display: none;
  }
  /* Motion on: the keyed canvas carries the animation; the still is only the fallback. */
  .m .ghd-canvas {
    display: block;
  }
  .m .ghd-still {
    visibility: hidden;
  }
</style>
