---
// Shell for the /v1 to /v5 design directions (and their index). Deliberately separate from the
// main site layout: Roboto only, no header/footer chrome, not indexed.
import '@fontsource-variable/roboto/wdth.css';
import '@fontsource-variable/roboto-mono/wght.css';
import './base.css';
import robotoUrl from '@fontsource-variable/roboto/files/roboto-latin-wdth-normal.woff2?url';

interface Props {
  title: string;
  bodyClass?: string;
  theme?: string;
  description?: string;
  /** Public path of this page (e.g. "/services/"). Present only on the main site, which can be indexed. */
  canonicalPath?: string;
  /** False keeps a page out of search results even after launch. */
  index?: boolean;
  jsonLd?: object[];
}
const {
  title,
  bodyClass = '',
  theme = '#0A0B0D',
  description = 'GHD Agency builds systems for owner-led service businesses so owners regain time and money.',
  canonicalPath,
  index = true,
  jsonLd = [],
} = Astro.props;
// Indexing stays off until the build is told this is the live site (PUBLIC_INDEXABLE=true).
const live = import.meta.env.PUBLIC_INDEXABLE === 'true' && !!canonicalPath && index;
const canonical = canonicalPath ? new URL(canonicalPath, 'https://ghdagency.ai').href : undefined;
const ogImage = new URL('/og-image-v2.jpg', import.meta.env.PUBLIC_DEPLOY_ORIGIN || Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content={live ? 'index, follow, max-image-preview:large' : 'noindex, nofollow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GHD Agency" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content={theme} />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={robotoUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      var a11y = {};
      try { a11y = JSON.parse(localStorage.getItem('ghd-a11y') || '{}'); } catch (e) {}
      var h = document.documentElement;
      h.classList.add(a11y.motion === 'off' || matchMedia('(prefers-reduced-motion: reduce)').matches ? 'rm' : 'm');
      if (a11y.text) h.classList.add('a11y-t' + a11y.text);
      if (a11y.contrast) h.classList.add('a11y-contrast');
      if (a11y.links) h.classList.add('a11y-links');
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
