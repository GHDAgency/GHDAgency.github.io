---
// Shell for the /v1 to /v5 design directions (and their index). Deliberately separate from the
// main site layout: Roboto only, no header/footer chrome, not indexed.
import '@fontsource-variable/roboto/wdth.css';
import '@fontsource-variable/roboto-mono/wght.css';
import './base.css';
import robotoUrl from '@fontsource-variable/roboto/files/roboto-latin-wdth-normal.woff2?url';

interface Props {
  title: string;
  bodyClass?: string;
  theme?: string;
  description?: string;
}
const {
  title,
  bodyClass = '',
  theme = '#0A0B0D',
  description = 'GHD Agency builds systems for owner-led service businesses so owners regain time and money.',
} = Astro.props;
const ogImage = new URL('/og-image.jpg', import.meta.env.PUBLIC_DEPLOY_ORIGIN || Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GHD Agency" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={theme} />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={robotoUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add(
        matchMedia('(prefers-reduced-motion: reduce)').matches ? 'rm' : 'm'
      );
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
