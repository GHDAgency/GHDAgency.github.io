---
// Accessibility menu: a button at the lower left of every page. Choices are saved in this browser.
---

<div class="a11y" data-a11y>
  <button type="button" class="a11y-btn" aria-label="Accessibility options" aria-expanded="false" aria-controls="a11y-panel" data-a11y-open>
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="4.6" r="1.7" />
      <path d="M5 8.2l7 1.4 7-1.4M12 9.6v4.6M12 14.2l-3.4 6M12 14.2l3.4 6" />
    </svg>
  </button>
  <div class="a11y-panel" id="a11y-panel" role="dialog" aria-label="Accessibility options" hidden>
    <p class="a11y-title">Accessibility</p>
    <div class="a11y-row">
      <button type="button" data-a11y-text="down" aria-label="Decrease text size">A−</button>
      <button type="button" data-a11y-text="up" aria-label="Increase text size">A+</button>
    </div>
    <button type="button" class="a11y-opt" data-a11y-toggle="contrast" aria-pressed="false">Higher contrast</button>
    <button type="button" class="a11y-opt" data-a11y-toggle="links" aria-pressed="false">Underline links</button>
    <button type="button" class="a11y-opt" data-a11y-toggle="motion" aria-pressed="false">Reduce motion</button>
    <button type="button" class="a11y-opt a11y-reset" data-a11y-reset>Reset</button>
    <a class="a11y-link" href="/accessibility-statement/">Accessibility statement</a>
  </div>
</div>

<script>
  const root = document.documentElement;
  const wrap = document.querySelector<HTMLElement>('[data-a11y]');
  if (wrap) {
    const btn = wrap.querySelector<HTMLButtonElement>('[data-a11y-open]')!;
    const panel = wrap.querySelector<HTMLElement>('.a11y-panel')!;
    type Prefs = { text?: number; contrast?: boolean; links?: boolean; motion?: 'off' };
    let prefs: Prefs = {};
    try { prefs = JSON.parse(localStorage.getItem('ghd-a11y') || '{}'); } catch {}
    const save = () => { try { localStorage.setItem('ghd-a11y', JSON.stringify(prefs)); } catch {} };
    const sync = () => {
      wrap.querySelector('[data-a11y-toggle="contrast"]')!.setAttribute('aria-pressed', String(!!prefs.contrast));
      wrap.querySelector('[data-a11y-toggle="links"]')!.setAttribute('aria-pressed', String(!!prefs.links));
      wrap.querySelector('[data-a11y-toggle="motion"]')!.setAttribute('aria-pressed', String(prefs.motion === 'off'));
    };
    const apply = () => {
      root.classList.remove('a11y-t1', 'a11y-t2');
      if (prefs.text) root.classList.add('a11y-t' + prefs.text);
      root.classList.toggle('a11y-contrast', !!prefs.contrast);
      root.classList.toggle('a11y-links', !!prefs.links);
      sync();
    };
    const open = (on: boolean) => {
      panel.hidden = !on;
      btn.setAttribute('aria-expanded', String(on));
      if (on) panel.querySelector<HTMLElement>('button')?.focus();
      else btn.focus();
    };
    btn.addEventListener('click', () => open(panel.hidden));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) open(false); });
    document.addEventListener('click', (e) => { if (!panel.hidden && !wrap.contains(e.target as Node)) open(false); });
    wrap.querySelectorAll<HTMLButtonElement>('[data-a11y-text]').forEach((b) =>
      b.addEventListener('click', () => {
        const cur = prefs.text || 0;
        const next = b.dataset.a11yText === 'up' ? Math.min(2, cur + 1) : Math.max(0, cur - 1);
        prefs.text = next || undefined;
        save(); apply();
      }),
    );
    wrap.querySelectorAll<HTMLButtonElement>('[data-a11y-toggle]').forEach((b) =>
      b.addEventListener('click', () => {
        const k = b.dataset.a11yToggle as 'contrast' | 'links' | 'motion';
        if (k === 'motion') {
          prefs.motion = prefs.motion === 'off' ? undefined : 'off';
          save();
          location.reload();
          return;
        }
        prefs[k] = !prefs[k];
        save(); apply();
      }),
    );
    wrap.querySelector('[data-a11y-reset]')!.addEventListener('click', () => {
      const hadMotion = prefs.motion === 'off';
      prefs = {};
      save(); apply();
      if (hadMotion) location.reload();
    });
    apply();
  }
</script>

<style is:global>
  .a11y {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 60;
    font-family: inherit;
  }
  .a11y-btn {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgb(0 255 255 / 0.55);
    background: #0e1113;
    color: #00ffff;
    cursor: pointer;
    box-shadow: 0 8px 24px -8px rgb(0 0 0 / 0.8), 0 0 18px -6px rgb(0 255 255 / 0.5);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .a11y-btn:hover { transform: translateY(-2px); }
  .a11y-btn svg { width: 26px; height: 26px; }
  .a11y-btn:focus-visible,
  .a11y-panel button:focus-visible,
  .a11y-link:focus-visible {
    outline: 3px solid #00ffff;
    outline-offset: 3px;
  }
  .a11y-panel {
    position: absolute;
    left: 0;
    bottom: 60px;
    width: 232px;
    padding: 16px;
    border-radius: 18px;
    border: 1px solid rgb(230 235 238 / 0.2);
    background: #14171a;
    color: #e6ebee;
    box-shadow: 0 24px 60px -20px rgb(0 0 0 / 0.9);
    display: grid;
    gap: 8px;
  }
  .a11y-panel[hidden] { display: none; }
  .a11y-title {
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #9aa3aa;
    margin-bottom: 2px;
  }
  .a11y-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .a11y-panel button {
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid rgb(230 235 238 / 0.22);
    background: #1d2125;
    color: #e6ebee;
    font: inherit;
    font-size: 14px;
    text-align: left;
    cursor: pointer;
  }
  .a11y-row button { text-align: center; font-size: 16px; }
  .a11y-panel button[aria-pressed='true'] {
    background: #00ffff;
    border-color: #00ffff;
    color: #0a0b0d;
    font-weight: 500;
  }
  .a11y-link {
    margin-top: 4px;
    font-size: 13px;
    color: #00e5e8;
    text-decoration: underline;
  }

  /* Applied preferences */
  html.a11y-t1 body { zoom: 1.12; }
  html.a11y-t2 body { zoom: 1.28; }
  html.a11y-contrast { filter: contrast(1.3) brightness(1.04); }
  html.a11y-links a { text-decoration: underline !important; text-underline-offset: 3px; }
  html.a11y-links a.cta,
  html.a11y-links .a11y-btn { text-decoration: none !important; }
</style>
