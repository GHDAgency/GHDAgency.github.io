---
// Client testimonial banner. Copy lives in copy.ts (`testimonial`).
import { testimonial as t } from './copy';
---

<section class="tm" aria-labelledby="tm-kicker">
  <figure class="tm-card fade">
    <p class="tm-kicker" id="tm-kicker">{t.kicker} <span>{t.lead}</span></p>
    <div class="tm-body">
      <blockquote class="tm-quote">
        <span class="tm-mark" aria-hidden="true">“</span>
        <p>{t.quote}</p>
      </blockquote>
      <figcaption class="tm-who">
        {t.photo && <img class="tm-photo" src={t.photo} alt={t.name} width="96" height="96" loading="lazy" decoding="async" />}
        <img class="tm-logo" src={t.logo.src} width={t.logo.width} height={t.logo.height} alt={t.logo.alt} loading="lazy" decoding="async" />
        <span class="tm-name">{t.name}</span>
        <span class="tm-title">{t.title}</span>
      </figcaption>
    </div>
  </figure>
</section>

<style>
  .tm {
    padding: 0 var(--gutter) clamp(56px, 9vh, 96px);
  }
  .tm-card {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(28px, 3.4vw, 52px) clamp(24px, 4vw, 64px);
    border-radius: 28px;
    background: var(--brush), var(--alloy);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.1), 0 60px 120px -50px rgb(0 0 0 / 1);
  }
  .tm-card::before {
    content: '';
    position: absolute;
    left: 15%;
    right: 15%;
    top: 0;
    height: 1px;
    background: var(--edge-hi);
  }
  .tm-kicker {
    margin: 0 0 clamp(18px, 2.4vw, 30px);
    font-weight: 200;
    font-size: clamp(22px, 2.6vw, 38px);
    letter-spacing: -0.01em;
    color: #e9eef2;
    text-align: center;
  }
  .tm-kicker span {
    white-space: nowrap;
    color: var(--cyan);
  }
  .tm-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
  }
  .tm-quote {
    position: relative;
    margin: 0;
  }
  .tm-quote p {
    margin: 0;
    font-weight: 300;
    font-size: clamp(17px, 1.7vw, 24px);
    line-height: 1.55;
    color: #e9eef2;
    text-wrap: pretty;
  }
  .tm-mark {
    display: block;
    height: 0.55em;
    margin-bottom: 0.1em;
    font-weight: 200;
    font-size: clamp(56px, 6vw, 88px);
    line-height: 1;
    color: var(--cyan);
    opacity: 0.8;
  }
  .tm-who {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding-left: clamp(20px, 3vw, 44px);
    border-left: 1px solid rgb(255 255 255 / 0.12);
    min-width: 200px;
  }
  .tm-photo {
    width: 72px;
    height: 72px;
    margin-bottom: 6px;
    border-radius: 50%;
    object-fit: cover;
  }
  .tm-logo {
    height: 44px;
    width: auto;
    margin-bottom: 10px;
    opacity: 0.95;
  }
  .tm-name {
    font-weight: 400;
    font-size: 16px;
    color: #fff;
  }
  .tm-title {
    font-weight: 300;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--gray);
  }
  @media (max-width: 760px) {
    .tm-body {
      grid-template-columns: 1fr;
    }
    .tm-who {
      padding-left: 0;
      padding-top: 18px;
      border-left: 0;
      border-top: 1px solid rgb(255 255 255 / 0.12);
    }
  }
</style>
