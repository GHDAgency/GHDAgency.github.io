---
// Client testimonial banner. Copy lives in copy.ts (`testimonial`).
import { testimonial as t } from './copy';
---

<section class="tm" aria-labelledby="tm-kicker">
  <div class="tm-card fade">
    <p class="tm-kicker" id="tm-kicker">{t.kicker} <span>{t.lead}</span></p>
    <div class="tm-grid">
      {
        t.items.map((it) => (
          <figure class="tm-item">
            <blockquote class="tm-quote">
              <span class="tm-mark" aria-hidden="true">“</span>
              <p>{it.quote}</p>
            </blockquote>
            <figcaption class="tm-who">
              {it.photo && <img class="tm-photo" src={it.photo} alt={it.name} width="96" height="96" loading="lazy" decoding="async" />}
              <img class:list={['tm-logo', { round: it.logo.round }]} src={it.logo.src} width={it.logo.width} height={it.logo.height} alt={it.logo.alt} loading="lazy" decoding="async" />
              <span class="tm-text">
                <span class="tm-name">{it.name}</span>
                <span class="tm-title">{it.title}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tm {
    padding: 0 var(--gutter) clamp(56px, 9vh, 96px);
  }
  .tm-card {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(28px, 3.4vw, 52px) clamp(24px, 4vw, 64px);
    border-radius: 28px;
    background: var(--brush), var(--alloy);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.1), 0 60px 120px -50px rgb(0 0 0 / 1);
  }
  .tm-card::before {
    content: '';
    position: absolute;
    left: 15%;
    right: 15%;
    top: 0;
    height: 1px;
    background: var(--edge-hi);
  }
  .tm-kicker {
    margin: 0 0 clamp(20px, 2.8vw, 36px);
    font-weight: 200;
    font-size: clamp(22px, 2.6vw, 38px);
    letter-spacing: -0.01em;
    color: #e9eef2;
    text-align: center;
  }
  .tm-kicker span {
    white-space: nowrap;
    color: var(--cyan);
  }
  .tm-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 64px);
  }
  .tm-item {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    margin: 0;
  }
  .tm-item + .tm-item {
    padding-left: clamp(28px, 4vw, 64px);
    border-left: 1px solid rgb(255 255 255 / 0.12);
  }
  .tm-quote {
    margin: 0;
  }
  .tm-quote p {
    margin: 0;
    font-weight: 300;
    font-size: clamp(16px, 1.45vw, 20px);
    line-height: 1.6;
    color: #e9eef2;
    text-wrap: pretty;
  }
  .tm-mark {
    display: block;
    height: 0.55em;
    margin-bottom: 0.1em;
    font-weight: 200;
    font-size: clamp(56px, 6vw, 80px);
    line-height: 1;
    color: var(--cyan);
    opacity: 0.8;
  }
  .tm-who {
    display: flex;
    align-items: center;
    gap: 18px;
    padding-top: 20px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }
  .tm-photo {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
  }
  .tm-logo {
    height: clamp(64px, 6vw, 84px);
    width: auto;
    flex: none;
    filter: drop-shadow(0 0 22px rgb(0 255 255 / 0.16));
  }
  .tm-logo.round {
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    filter: none;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.18), 0 0 26px rgb(0 255 255 / 0.12);
  }
  .tm-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .tm-name {
    font-weight: 400;
    font-size: 16px;
    color: #fff;
  }
  .tm-title {
    font-weight: 300;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--gray);
  }
  @media (max-width: 800px) {
    .tm-grid {
      grid-template-columns: 1fr;
    }
    .tm-item + .tm-item {
      padding-left: 0;
      padding-top: 28px;
      border-left: 0;
      border-top: 1px solid rgb(255 255 255 / 0.12);
    }
  }
</style>
