---
// WORLD 2: CHRONOGRAPH. Swiss haute horlogerie: the page is built from dials, bezels and fine
// tick marks. Brushed silver on deep black, with cyan used only as lume. The problem sequence is a
// unidirectional bezel that clicks one hour marker per beat.
import Layout from '../directions/Layout.astro';
import Marquee from '../directions/Marquee.astro';
import GhdLogo from '../directions/GhdLogo.astro';
import { CTA_LABEL, CTA_HREF, hero, heroServes, beats, howV4, industries, finalCta, proof, footer, fmt } from '../directions/copy';

type Beat = { lines: string[]; finale?: boolean; logo?: boolean };
const lead: Beat[] = beats.filter((b) => !b.finale);
const finale: Beat = beats.find((b) => b.finale)!;
const seq: Beat[] = [...lead, { lines: [], logo: true }, finale];
const logoIdx = seq.findIndex((b) => b.logo);

// ---- Dial geometry (all SVGs use a centred coordinate system, angles clockwise from 12 o'clock) ----
const R = (n: number) => Math.round(n * 100) / 100;
const pt = (c: number, r: number, deg: number) => {
  const a = (deg * Math.PI) / 180;
  return { x: R(c + Math.sin(a) * r), y: R(c - Math.cos(a) * r) };
};
type Tick = { x1: number; y1: number; x2: number; y2: number; major: boolean };
function ticks(count: number, c: number, r: number, minor: number, major: number, every: number, from = 0, span = 360): Tick[] {
  const closed = span >= 360;
  return Array.from({ length: count }, (_, i) => {
    const deg = from + (i / (closed ? count : count - 1)) * span;
    const isMajor = i % every === 0;
    const a = pt(c, r, deg);
    const b = pt(c, r - (isMajor ? major : minor), deg);
    return { x1: a.x, y1: a.y, x2: b.x, y2: b.y, major: isMajor };
  });
}

// Hero dial (viewBox 1000).
const heroMicro = ticks(240, 500, 478, 7, 7, 1000);
const heroTicks = ticks(60, 500, 478, 18, 40, 5);
const heroNums = Array.from({ length: 12 }, (_, i) => ({ ...pt(500, 395, (i + 1) * 30), t: String((i + 1) * 5) }));

// Problem bezel (viewBox 1000): 60 minute ticks, diver numerals, 12 hour batons (the first six are the beats).
const bezelTicks = ticks(60, 500, 494, 14, 28, 5);
const bezelNums = Array.from({ length: 12 }, (_, i) => ({ deg: i * 30, t: String(i * 5).padStart(2, '0') }));

// Registers (viewBox 200).
const regTicks = ticks(60, 100, 96, 4, 10, 5);

// Gauges (viewBox 240): a 270 degree scale.
const gaugeTicks = ticks(28, 120, 116, 5, 11, 3, -135, 270);

// Final dial (viewBox 1000).
const finalTicks = ticks(60, 500, 492, 12, 26, 5);
const finalMicro = ticks(240, 500, 492, 5, 5, 1000);
const finalLume = Array.from({ length: 12 }, (_, i) => pt(500, 446, i * 30));

// Who we work with: a straight scale with 48 intervals; the names sit on the heavy lume ticks.
const scale = Array.from({ length: 49 }, (_, i) => ({ mark: [6, 18, 30, 42].includes(i), major: i % 4 === 0 }));
---

<Layout title="GHD Agency | Chronograph" bodyClass="w2">
  <main>
    <!-- 1. HERO: the logo animation at the centre of the dial. -->
    <section class="hero">
      <div class="hero-grid">
        <div class="dial hero-dial" aria-hidden="false">
          <span class="bezel" aria-hidden="true"></span>
          <span class="face sunray" aria-hidden="true"></span>
          <svg class="track" viewBox="0 0 1000 1000" aria-hidden="true">
            <defs>
              <filter id="w2glow" filterUnits="userSpaceOnUse" x="0" y="0" width="1000" height="1000">
                <feGaussianBlur stdDeviation="4" result="b" />
                <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
              </filter>
            </defs>
            <circle cx="500" cy="500" r="486" class="hair" />
            <circle cx="500" cy="500" r="352" class="hair faint" />
            {heroMicro.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class="micro" />)}
            {heroTicks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class={t.major ? 'major' : 'minor'} />)}
            {heroTicks.filter((t) => t.major).map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class="inlay" filter="url(#w2glow)" />)}
            {heroNums.map((n) => <text x={n.x} y={n.y} class="dnum">{n.t}</text>)}
          </svg>
          <GhdLogo class="dial-logo" />
          <span class="shand" aria-hidden="true"><i></i></span>
          <span class="cap" aria-hidden="true"></span>
          <span class="glass" aria-hidden="true"></span>
        </div>

        <div class="hero-copy">
          <p class="eyebrow rise" style="--d:0.35s">{hero.eyebrow}</p>
          <h1 class="display silver slide">{hero.headline}</h1>
          <p class="sub rise" style="--d:0.7s">{hero.subhead.map((l) => <span>{l}</span>)}</p>
          <p class="serves rise" style="--d:0.85s">{heroServes}</p>
          <div class="rise" style="--d:1s">
            <a class="crown" href={CTA_HREF}><span class="crown-label">{CTA_LABEL}</span><span class="knurl" aria-hidden="true"></span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. LOGO ROW -->
    <section class="logos fade" aria-label="Clients">
      <span class="rule" aria-hidden="true"></span>
      <Marquee duration={60} />
      <span class="rule" aria-hidden="true"></span>
    </section>

    <!-- 3. THE PROBLEM: one hour marker per beat. -->
    <section class="problem" data-problem data-logo={logoIdx} style={`--n:${seq.length}`}>
      <div class="stage">
        <div class="ring" data-ring>
          <span class="face azurage" aria-hidden="true"></span>
          <svg class="bezel-svg" viewBox="0 0 1000 1000" aria-hidden="true" data-bezel>
            <defs>
              <filter id="w2lume" x="-100%" y="-100%" width="300%" height="300%">
                <feGaussianBlur stdDeviation="6" result="b" />
                <feMerge><feMergeNode in="b" /><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
              </filter>
            </defs>
            <circle cx="500" cy="500" r="455" class="band" />
            <circle cx="500" cy="500" r="498" class="hair" />
            <circle cx="500" cy="500" r="412" class="hair" />
            {bezelTicks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class={t.major ? 'major' : 'minor'} />)}
            {bezelNums.map((n) => (
              <text x="500" y="74" transform={`rotate(${n.deg} 500 500)`} class="bnum">{n.t}</text>
            ))}
            {bezelNums.map((n, i) => (
              <rect x="494" y="96" width="12" height="40" rx="2" transform={`rotate(${n.deg} 500 500)`} class:list={['mk', { beat: i < seq.length }]} data-mk={i < seq.length ? i : undefined} />
            ))}
          </svg>
          <span class="pip" aria-hidden="true" data-pip></span>
          <span class="rhand" aria-hidden="true" data-hand><i></i></span>

          {seq.map((b, i) => (
            <div class="pl fade" data-line class:list={{ finale: b.finale, 'logo-beat': b.logo }} style={`--i:${i}`}>
              {b.logo && (
                <div class="lg">
                  <GhdLogo class="beat-logo" />
                </div>
              )}
              {b.lines.length > 0 && (
                <div class="txt">
                  {b.lines.map((line, j) => (
                    <p style={`--j:${j}`} class:list={{ partner: b.finale && j === 0, result: b.finale && j === 1 }}>
                      <span class:list={{ silver: b.finale && j === 0 }}>{line}</span>
                    </p>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. HOW WE WORK: three registers. -->
    <section class="how">
      <p class="how-intro fade">{howV4.intro.map((l) => <span>{l}</span>)}</p>
      <ol class="regs">
        {howV4.steps.map((s, i) => (
          <li class="reg fade" style={`--k:${(i + 1) / 3}`}>
            <div class="reg-dial">
              <svg viewBox="0 0 200 200" aria-hidden="true">
                <circle cx="100" cy="100" r="98" class="hair" />
                <circle cx="100" cy="100" r="72" class="hair faint" />
                {regTicks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class={t.major ? 'major' : 'minor'} />)}
                <circle cx="100" cy="100" r="80" pathLength="100" class="reg-arc" transform="rotate(-90 100 100)" />
              </svg>
              <span class="reg-n">{s.n}</span>
            </div>
            <h2>{s.title}</h2>
            <p>{s.line}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- 5. WHO WE WORK WITH -->
    <section class="who">
      <p class="label fade">{industries.label}</p>
      <div class="scale fade" aria-hidden="true">
        {scale.map((t) => <i class:list={{ mj: t.major, mark: t.mark }}></i>)}
      </div>
      <ul class="who-list">
        {industries.items.map((name) => (
          <li class="fade">{name}</li>
        ))}
      </ul>
    </section>

    <!-- 6. PROOF: three gauge readouts. -->
    <section class="proof" data-proof>
      <dl class="gauges fade">
        {proof.stats.map((s) => (
          <div class:list={['gauge', { money: s.money }]}>
            <dd>
              <svg viewBox="0 0 240 240" aria-hidden="true">
                {gaugeTicks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class={t.major ? 'major' : 'minor'} />)}
                <circle cx="120" cy="120" r="96" pathLength="100" class="g-track" transform="rotate(135 120 120)" />
                <circle cx="120" cy="120" r="96" pathLength="100" class="g-fill" transform="rotate(135 120 120)" />
              </svg>
              <span
                class:list={['num', 'figure', { amber: s.money }]}
                data-count={s.value}
                data-prefix={s.prefix}
                style={`min-width:${(s.prefix + fmt(s.value)).length}ch`}>{s.prefix + fmt(s.value)}</span>
            </dd>
            <dt>{s.label}</dt>
          </div>
        ))}
      </dl>
      <p class="foot fade">{proof.footnote}</p>
    </section>

    <!-- 7. FINAL CTA: centred on a dial. -->
    <section class="final">
      <svg class="final-dial" viewBox="0 0 1000 1000" aria-hidden="true">
        <g class="final-turn">
          {finalMicro.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class="micro" />)}
          {finalTicks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class={t.major ? 'major' : 'minor'} />)}
        </g>
        <circle cx="500" cy="500" r="498" class="hair" />
        <circle cx="500" cy="500" r="430" class="hair faint" />
        {finalLume.map((p) => <circle cx={p.x} cy={p.y} r="4" class="lume" />)}
      </svg>
      <div class="final-copy">
        <h2 class="final-head silver fade">{finalCta.headline}</h2>
        <p class="final-sub fade">{finalCta.sub}</p>
        <div class="fade">
          <a class="crown" href={CTA_HREF}><span class="crown-label">{CTA_LABEL}</span><span class="knurl" aria-hidden="true"></span></a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <p>{footer.name} · <a href={`mailto:${footer.email}`}>{footer.email}</a> · {footer.copyright}</p>
  </footer>
</Layout>

<script>
  import { motion, onFrame, problemTimeline, pinProgress, fades, countUp } from '../directions/engine';

  fades();
  const band = document.querySelector<HTMLElement>('[data-proof]')!;
  countUp(band, 1500, () => band.classList.add('go'));

  if (motion()) {
    document.querySelector<HTMLVideoElement>('.dial-logo .ghd-video')?.play().catch(() => {});

    const section = document.querySelector<HTMLElement>('[data-problem]')!;
    const logoIdx = Number(section.dataset.logo);
    const ring = section.querySelector<HTMLElement>('[data-ring]')!;
    const bezel = section.querySelector<SVGElement>('[data-bezel]')!;
    const pip = section.querySelector<HTMLElement>('[data-pip]')!;
    const hand = section.querySelector<HTMLElement>('[data-hand]')!;
    const marks = Array.from(section.querySelectorAll<SVGElement>('[data-mk]'));
    const tl = problemTimeline(section, '[data-line]', 0.18, false);
    const beatEls = Array.from(section.querySelectorAll<HTMLElement>('[data-line]'));
    const video = beatEls[logoIdx]?.querySelector<HTMLVideoElement>('.ghd-video') ?? null;
    const n = beatEls.length;

    let cur = -2;
    let loaded = false;
    let timer = 0;
    let sweep: Animation | null = null;

    const resetLogo = () => {
      clearTimeout(timer);
      sweep?.cancel();
      sweep = null;
      if (video) {
        video.pause();
        video.currentTime = 0;
      }
    };

    const go = (c: number) => {
      const prev = cur;
      cur = c;
      const k = Math.max(c, 0);
      const prevK = Math.max(prev, 0);

      // The bezel turns counter-clockwise, one hour marker per beat, and clicks home.
      bezel.style.transform = `rotate(${-30 * k}deg)`;
      if (k !== prevK && prev !== -2) {
        pip.animate(
          [{ transform: 'translateY(0)' }, { transform: 'translateY(5px)', offset: 0.3 }, { transform: 'translateY(0)' }],
          { duration: 360, delay: 620, easing: 'cubic-bezier(.2,.8,.2,1)' },
        );
      }
      marks.forEach((m, i) => {
        m.classList.toggle('lit', i === c);
        m.classList.toggle('past', i < c);
      });
      ring.classList.toggle('done', c === n - 1);

      if (prev === logoIdx && c !== logoIdx) resetLogo();

      beatEls.forEach((el, i) => {
        el.classList.remove('on');
        el.classList.toggle('past', i < c);
      });

      if (c === logoIdx) {
        // The hand makes one full sweep; the logo arrives at the centre as it completes.
        resetLogo();
        sweep = hand.animate(
          [
            { transform: 'rotate(0deg)', opacity: 0 },
            { opacity: 1, offset: 0.08 },
            { transform: 'rotate(360deg)', opacity: 1, offset: 0.86 },
            { transform: 'rotate(360deg)', opacity: 0 },
          ],
          { duration: 1700, easing: 'cubic-bezier(.5,.05,.3,1)' },
        );
        timer = window.setTimeout(() => {
          beatEls[logoIdx].classList.add('on');
          if (video) {
            video.currentTime = 0;
            video.play().catch(() => {});
          }
        }, 1350);
      } else if (c >= 0) {
        beatEls[c].classList.add('on');
      }
    };

    onFrame(() => {
      const top = section.getBoundingClientRect().top;
      if (!loaded && top < innerHeight * 2) {
        loaded = true;
        video?.load();
      }
      const { pos } = tl(pinProgress(section));
      const c = top < innerHeight * 0.25 ? Math.min(n - 1, Math.floor(pos + 0.25)) : -1;
      if (c !== cur) go(c);
    });
  }
</script>

<style is:global>
  .w2 {
    --steel: #e6ebee;
    --hair: rgb(230 235 238 / 0.18);
    --lume: #00ffff;
    --lume-glow: 0 0 10px rgb(0 255 255 / 0.65);
    --ease-mech: cubic-bezier(0.22, 1.32, 0.42, 1);
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    background:
      radial-gradient(ellipse 80% 60% at 30% 0%, #111418 0%, transparent 60%),
      var(--base);
  }
  .w2 .silver {
    color: transparent;
    background: linear-gradient(180deg, #f2f5f7 0%, #c9d0d4 45%, #8a949c 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  /* SVG dial vocabulary, shared by every dial on the page. */
  .w2 svg .hair {
    fill: none;
    stroke: var(--hair);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }
  .w2 svg .hair.faint {
    stroke: rgb(230 235 238 / 0.08);
  }
  .w2 svg .micro {
    stroke: rgb(230 235 238 / 0.18);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .w2 svg .minor {
    stroke: rgb(230 235 238 / 0.42);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }
  .w2 svg .major {
    stroke: #e6ebee;
    stroke-width: 2.4;
    vector-effect: non-scaling-stroke;
  }

  /* ============ CROWN BUTTON ============ */
  .w2 .crown {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid rgb(230 235 238 / 0.36);
    border-radius: 999px;
    background: linear-gradient(180deg, #1a1d21, #0c0e10);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.07),
      0 0 0 5px var(--base),
      0 0 0 6px rgb(230 235 238 / 0.08);
    color: var(--white);
    font-weight: 300;
    font-size: 13px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    overflow: hidden;
    transition: border-color 0.4s ease, box-shadow 0.4s ease;
  }
  .w2 .crown-label {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 19px 24px 19px 30px;
  }
  .w2 .crown-label::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--lume);
    box-shadow: var(--lume-glow);
  }
  .w2 .knurl {
    width: 30px;
    border-left: 1px solid rgb(230 235 238 / 0.22);
    background:
      repeating-linear-gradient(90deg, rgb(230 235 238 / 0.5) 0 1px, transparent 1px 4px) 0 0 / 4px 100%,
      linear-gradient(180deg, #2b3035, #111316);
    transition: background-position 0.9s var(--ease-out);
  }
  .w2 .crown:hover {
    border-color: rgb(230 235 238 / 0.7);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.1),
      0 0 0 5px var(--base),
      0 0 0 6px rgb(0 255 255 / 0.25),
      0 0 28px rgb(0 255 255 / 0.12);
  }
  .w2 .crown:hover .knurl {
    background-position: 16px 0, 0 0;
  }

  /* ============ HERO ============ */
  .w2 .hero {
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding: clamp(28px, 5vh, 56px) var(--gutter);
    overflow: hidden;
  }
  .w2 .hero-grid {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 6vw, 110px);
  }
  .w2 .dial {
    position: relative;
    aspect-ratio: 1;
    border-radius: 50%;
  }
  .w2 .hero-dial {
    width: min(42vw, 80svh, 680px);
    box-shadow:
      0 40px 80px -30px rgb(0 0 0 / 0.9),
      0 0 0 1px rgb(230 235 238 / 0.05),
      0 0 120px rgb(0 159 164 / 0.05);
  }
  .w2 .bezel {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      repeating-conic-gradient(rgb(0 0 0 / 0.28) 0deg 0.6deg, transparent 0.6deg 1.5deg),
      conic-gradient(from 30deg, #5b6268, #e6ebee 10%, #7d868d 22%, #c9d0d4 36%, #4e555a 50%, #dfe5e8 64%, #8a949c 78%, #f2f5f7 88%, #5b6268);
    -webkit-mask: radial-gradient(closest-side, transparent 95.2%, #000 95.5%);
    mask: radial-gradient(closest-side, transparent 95.2%, #000 95.5%);
    opacity: 0.85;
  }
  .w2 .face {
    position: absolute;
    border-radius: 50%;
  }
  .w2 .hero-dial .face {
    inset: 4.6%;
    box-shadow: inset 0 0 0 1px rgb(230 235 238 / 0.08), inset 0 14px 50px rgb(0 0 0 / 0.7);
  }
  /* Sunray guilloché: fine radial lines, barely there. */
  .w2 .face.sunray {
    background:
      repeating-conic-gradient(from 0deg, rgb(230 235 238 / 0.035) 0deg 0.35deg, transparent 0.35deg 1.2deg),
      radial-gradient(circle at 50% 42%, #181b1f 0%, #0e1013 55%, #090a0c 100%);
  }
  .w2 .track {
    position: absolute;
    inset: 4.6%;
    width: 91%;
    height: 91%;
    overflow: visible;
  }
  .w2 .track .inlay {
    stroke: var(--lume);
    stroke-width: 1;
    opacity: 0.85;
    vector-effect: non-scaling-stroke;
  }
  .w2 .dnum {
    font-family: var(--mono);
    font-weight: 200;
    font-size: 30px;
    fill: #8a949c;
    text-anchor: middle;
    dominant-baseline: central;
    letter-spacing: 0.04em;
  }
  .w2 .dial-logo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 50%;
    translate: -50% -50%;
    mix-blend-mode: lighten;
  }
  .w2 .shand {
    position: absolute;
    inset: 0;
    pointer-events: none;
    rotate: 42deg;
  }
  .w2 .shand i {
    position: absolute;
    left: calc(50% - 0.75px);
    top: 9%;
    height: 50%;
    width: 1.5px;
    background: linear-gradient(180deg, var(--lume) 0 12%, #e6ebee 12% 82%, #8a949c 82%);
    box-shadow: 0 0 1px rgb(0 0 0 / 0.8), 2px 3px 4px rgb(0 0 0 / 0.5);
  }
  .w2 .shand i::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 1%;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px solid #e6ebee;
    translate: -50% 0;
  }
  .m .w2 .shand {
    animation: w2-sweep 60s linear infinite;
  }
  @keyframes w2-sweep {
    from { rotate: 0deg; }
    to { rotate: 360deg; }
  }
  .w2 .cap {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2.2%;
    aspect-ratio: 1;
    border-radius: 50%;
    translate: -50% -50%;
    background: radial-gradient(circle at 35% 30%, #f2f5f7, #8a949c 60%, #3d4348);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.8);
  }
  /* Sapphire crystal: a cool diagonal reflection and a soft inner edge. */
  .w2 .glass {
    position: absolute;
    inset: 4.6%;
    border-radius: 50%;
    pointer-events: none;
    background:
