---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | GHD Agency.ai" description="The page you're looking for doesn't exist.">
  <section data-hero class="relative isolate grid min-h-[80svh] place-items-center overflow-hidden pt-32 pb-20 text-center">
    <div aria-hidden="true" class="grid-bg absolute inset-0 -z-10"></div>
    <div class="container-x">
      <p class="font-display text-[9rem] font-semibold leading-none sm:text-[13rem]"><span class="text-gradient">404</span></p>
      <h1 class="mt-4 text-3xl font-semibold text-white sm:text-4xl">This page went out of hours.</h1>
      <p class="mt-4 text-mist/70">The page you’re looking for doesn’t exist or has moved.</p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/" class="btn btn-primary" data-magnetic>Back to Home</a>
        <a href="/contact-us" class="btn btn-ghost">Contact Us</a>
      </div>
    </div>
  </section>
</Base>
