---
// V2: EDITORIAL MONOLITH. Massive left-aligned type, black space, almost no graphics.
// Colour is held back until the two closing lines of Section 4, so that hit lands.
import Layout from '../directions/Layout.astro';
import Words from '../directions/Words.astro';
import Marquee from '../directions/Marquee.astro';
import { CTA_LABEL, CTA_HREF, hero, logoRow, problem, how, proof, footer, fmt } from '../directions/copy';
---

<Layout title="GHD Agency | V2 Editorial Monolith" bodyClass="v2">
  <main>
    <!-- 1. HERO -->
    <section class="hero">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 class="display">{hero.headline}</h1>
      <div class="hero-foot">
        <p class="sub">{hero.subhead.map((l) => <span>{l}</span>)}</p>
        <a class="cta" href={CTA_HREF}>{CTA_LABEL}</a>
      </div>
    </section>

    <!-- 2. LOGO ROW -->
    <section class="logos fade">
      <p class="label">{logoRow.label}</p>
      <Marquee duration={60} />
    </section>

    <!-- 3. THE PROBLEM -->
    <section class="problem" data-problem style={`--n:${problem.length}`}>
      <div class="stage">
        <div class="block">
          {problem.map((line, i) => <p class="pl fade" data-line class:list={{ last: i === problem.length - 1 }}><Words text={line} /></p>)}
        </div>
      </div>
    </section>

    <!-- 4. HOW WE WORK -->
    <section class="how">
      <ol>
        {how.steps.map((s) => (
          <li class="step fade">
            <span class="n">{s.n}</span>
            <h2>{s.title}</h2>
          </li>
        ))}
      </ol>
      <div class="closing">
        <p class="partner" data-scrub><Words text={how.partner} class="w-silver" /></p>
        <p class="result" data-scrub><Words text={how.result} class="w-cyan" /></p>
      </div>
    </section>

    <!-- 5. PROOF BAND -->
    <section class="proof" data-proof>
      <dl class="stats fade">
        {proof.stats.map((s) => (
          <div class="stat">
            <dt>{s.label}</dt>
            <dd class:list={['figure', { amber: s.money }]} data-count={s.value} data-prefix={s.prefix} style={`min-width:${(s.prefix + fmt(s.value)).length * 0.9}ch`}>
              {s.prefix + fmt(s.value)}
            </dd>
          </div>
        ))}
      </dl>
      <p class="foot fade">{proof.footnote}</p>
    </section>

    <!-- 6. FINAL CTA -->
    <section class="final">
      <a class="cta fade" href={CTA_HREF}>{CTA_LABEL}</a>
    </section>
  </main>

  <footer class="footer">
    <p>{footer.name} · <a href={`mailto:${footer.email}`}>{footer.email}</a> · {footer.copyright}</p>
  </footer>
</Layout>

<script>
  import { motion, onFrame, problemTimeline, pinProgress, scrubOnView, fades, countUp, clamp } from '../directions/engine';

  fades();
  countUp(document.querySelector('[data-proof]')!);

  if (motion()) {
    document.querySelectorAll<HTMLElement>('[data-scrub]').forEach((el) => scrubOnView(el, 0.95, 0.4));

    const section = document.querySelector<HTMLElement>('[data-problem]')!;
    const block = section.querySelector<HTMLElement>('.block')!;
    const tl = problemTimeline(section);
    let tops: number[] = [];
    let blockH = 0;
    const measure = () => {
      tops = Array.from(block.children as HTMLCollectionOf<HTMLElement>).map((el) => el.offsetTop);
      blockH = block.offsetHeight;
    };
    measure();
    addEventListener('resize', measure);
    document.fonts?.ready.then(measure);

    // The whole statement stays on screen as one column of type. It drifts upward so the line
    // being resolved sits just above centre, and stops once the final line is in place.
    onFrame(() => {
      const { pos, lines } = tl(pinProgress(section));
      const i = Math.min(Math.floor(pos), lines.length - 1);
      const f = clamp(pos - i);
      const at = tops[i] + ((tops[i + 1] ?? blockH) - tops[i]) * f;
      const anchor = innerHeight * 0.42;
      const maxShift = Math.max(0, blockH - innerHeight * 0.72);
      const y = clamp(at - anchor, 0, maxShift);
      block.style.transform = `translate3d(0, ${-y}px, 0)`;
    });
  }
</script>

<style is:global>
  .v2 {
    --rule: #1c2024;
  }
  .v2 main {
    padding-inline: var(--gutter);
  }

  /* HERO */
  .v2 .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 4vw, 48px) 0 clamp(32px, 5vw, 56px);
  }
  .v2 .eyebrow {
    font-weight: 500;
    font-size: clamp(15px, 1.2vw, 18px);
    letter-spacing: 0.01em;
    color: var(--white);
  }
  .v2 .display {
    margin: auto 0 clamp(40px, 7vh, 88px);
    padding-top: 12vh;
    font-weight: 900;
    font-size: clamp(54px, 10.2vw, 196px);
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--white);
  }
  .v2 .hero-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }
  .v2 .sub {
    font-weight: 300;
    font-size: clamp(18px, 1.55vw, 24px);
    line-height: 1.45;
    color: var(--gray);
  }
  .v2 .sub span {
    display: block;
  }
  .v2 .cta {
    flex: none;
    display: inline-block;
    padding: 20px 36px;
    border: 1px solid var(--white);
    border-radius: 999px;
    background: var(--white);
    color: var(--base);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.01em;
    transition: background 0.35s ease, color 0.35s ease;
  }
  .v2 .cta:hover {
    background: transparent;
    color: var(--white);
  }
  .m .v2 .display {
    animation: v2-rise 1.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .m .v2 .hero-foot,
  .m .v2 .eyebrow {
    animation: v2-fade 1.2s 0.35s ease both;
  }
  @keyframes v2-rise {
    from { transform: translateY(0.25em); }
  }
  @keyframes v2-fade {
    from { opacity: 0; }
  }

  /* LOGOS */
  .v2 .logos {
    padding: clamp(96px, 16vh, 180px) 0;
  }
  .v2 .label {
    font-size: clamp(15px, 1.2vw, 18px);
    color: var(--gray);
    margin-bottom: clamp(32px, 5vh, 56px);
  }
  .v2 .mq {
    margin-inline: calc(var(--gutter) * -1);
    --logo-h: 34px;
  }

  /* PROBLEM (static default) */
  .v2 .problem {
    padding: 10vh 0 20vh;
  }
  .v2 .pl {
    font-weight: 800;
    font-size: clamp(34px, 5.6vw, 104px);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }
  .v2 .pl + .pl {
    margin-top: 0.12em;
  }
  .v2 .pl.last {
    margin-top: 0.6em;
    font-weight: 900;
  }
  /* PROBLEM (pinned) */
  .m .v2 .problem {
    height: calc(var(--n) * 50svh + 140svh);
    padding: 0;
  }
  .m .v2 .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  .m .v2 .block {
    padding-top: 30svh;
    will-change: transform;
  }

  /* HOW WE WORK */
  .v2 .how {
    padding: clamp(80px, 12vh, 140px) 0 clamp(120px, 20vh, 240px);
  }
  .v2 .step {
    display: grid;
    grid-template-columns: minmax(48px, 8vw) 1fr;
    align-items: baseline;
  }
  .v2 .step + .step {
    margin-top: clamp(64px, 14vh, 160px);
  }
  .v2 .n {
    font-weight: 400;
    font-size: clamp(16px, 1.3vw, 20px);
    color: var(--gray);
  }
  .v2 .step h2 {
    font-weight: 800;
    font-size: clamp(38px, 6.4vw, 124px);
    line-height: 0.96;
    letter-spacing: -0.045em;
  }
  .v2 .closing {
    margin-top: clamp(140px, 30vh, 320px);
  }
  .v2 .closing p {
    font-weight: 900;
    font-size: clamp(42px, 7.6vw, 148px);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }
  .v2 .result {
    margin-top: 0.35em;
  }

  /* PROOF */
  .v2 .proof {
    padding: clamp(80px, 14vh, 160px) 0;
    border-top: 1px solid var(--rule);
  }
  .v2 .proof-head {
    font-weight: 800;
    font-size: clamp(28px, 3.8vw, 64px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    max-width: 18ch;
  }
  .v2 .stats {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: space-between;
    gap: 40px;
    margin-top: clamp(56px, 10vh, 120px);
  }
  .v2 .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 14px;
  }
  .v2 .figure {
    font-weight: 900;
    font-size: clamp(56px, 8.4vw, 160px);
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .v2 .stat dt {
    font-size: clamp(15px, 1.2vw, 18px);
    color: var(--gray);
  }
  .v2 .foot {
    margin-top: 32px;
    font-size: 13px;
    color: var(--gray);
    max-width: 80ch;
  }

  /* FINAL CTA */
  .v2 .final {
    display: grid;
    place-items: center;
    min-height: 90svh;
  }
  .v2 .final .cta {
    padding: 24px 48px;
    font-size: 19px;
  }

  .v2 .footer {
    margin: 0 var(--gutter);
    padding: 28px 0 40px;
    border-top: 1px solid var(--rule);
    font-size: 14px;
    color: var(--gray);
  }
  .v2 .footer a:hover {
    color: var(--white);
  }

  @media (max-width: 760px) {
    .v2 .hero-foot {
      flex-direction: column;
      align-items: flex-start;
    }
    .v2 .display {
      padding-top: 18vh;
    }
    .v2 .stats {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .v2 .step {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>
