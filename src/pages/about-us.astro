---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Features from '../components/Features.astro';
import Integrations from '../components/Integrations.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';

const values = [
  { word: 'Grit', line: 'Built with grit.', image: '/images/values/grit.webp' },
  { word: 'Heart', line: 'Guided by heart.', image: '/images/values/heart.webp' },
  { word: 'Disruption', line: 'Driven by disruption.', image: '/images/values/disruption.webp' },
];
---

<Base
  title="About Us | GHD: Generative Human Design™"
  description="At GHD: Generative Human Design™, we build intelligent systems that make business more human. We're not here to replace people, we're here to amplify them."
>
  <PageHero eyebrow="About Us">
    <Fragment slot="title">We build intelligent systems that make business <span class="text-gradient">more human.</span></Fragment>
  </PageHero>

  <section class="pb-8">
    <div class="container-x">
      <figure class="relative overflow-hidden rounded-[2.5rem] border border-white/8" data-reveal="scale">
        <img
          src="/images/scenes/human-meets-ai.webp"
          alt="A human hand and a hand made of light reaching toward each other — human intention meeting machine intelligence"
          width="1400"
          height="933"
          class="aspect-[16/9] w-full scale-110 object-cover md:aspect-[21/9]"
          data-parallax="0.08"
        />
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-ink-950/90 via-transparent to-transparent"></div>
        <figcaption class="absolute inset-x-0 bottom-0 p-6 font-display text-xl font-medium text-white sm:p-10 sm:text-3xl">
          When human intention meets machine intelligence<span class="text-cyan-glow">.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="relative py-16 md:py-24">
    <div class="container-x grid gap-16 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="lg:sticky lg:top-32 lg:self-start" data-reveal="left">
        <div class="glass relative overflow-hidden rounded-[2rem] p-10">
          <div aria-hidden="true" class="absolute -top-20 -right-20 size-60 rounded-full bg-cyan-glow/20 blur-3xl"></div>
          <img src="/images/logo.webp" alt="GHD: Generative Human Design™" width="552" height="219" loading="lazy" class="blend-screen relative w-full max-w-xs" />
          <p class="relative mt-8 font-display text-3xl font-semibold leading-tight text-white">
            We’re not here to replace people, <span class="text-gradient">we’re here to amplify them.</span>
          </p>
        </div>
      </div>

      <div class="space-y-8 text-xl leading-relaxed text-mist/75" data-reveal-stagger="0.12">
        <p>At <strong class="font-semibold text-white">GHD: Generative Human Design™</strong>, we build intelligent systems that make business more human.</p>
        <p>We’re not here to replace people, we’re here to amplify them.</p>
        <p>Our AI-powered frameworks remove friction, automate the repetitive, and unlock hundreds of hours that can be reinvested into growth, creativity, and client connection.</p>
        <p>Every solution we deploy is built with grit, guided by heart, and driven by disruption. We get under the hood of your business, identify the hidden inefficiencies in your sales process, and engineer intelligent automations that multiply revenue while cutting costs.</p>
        <p class="font-display text-3xl font-semibold leading-snug text-white">
          Because when human intention meets machine intelligence, the result isn’t just efficiency — <span class="text-gradient">it’s freedom.</span>
        </p>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container-x">
      <ul class="grid gap-4 md:grid-cols-3" data-reveal-stagger="0.1">
        {
          values.map((v, i) => (
            <li class="spotlight glass group relative overflow-hidden rounded-3xl">
              <div class="relative aspect-[4/3] overflow-hidden">
                <img
                  src={v.image}
                  alt=""
                  width="720"
                  height="720"
                  loading="lazy"
                  class="size-full object-cover transition-transform duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-110"
                />
                <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-ink-900 via-ink-900/20 to-transparent" />
                <span class="absolute top-5 left-6 font-display text-sm text-cyan-glow/80 tabular-nums">0{i + 1}</span>
              </div>
              <div class="relative -mt-10 p-8 pt-0">
                <p class="font-display text-5xl font-semibold text-white transition-colors duration-500 group-hover:text-cyan-glow">{v.word}</p>
                <p class="mt-3 text-mist/60">{v.line}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Features />
  <Integrations />
  <Pricing />
  <Testimonials />
  <Faq />
  <CtaBand />
</Base>
