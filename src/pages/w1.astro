---
// WORLD 1: PRIVATE OFFICE. Old-money quiet wealth: the feel of a private bank's letterhead.
// Strictly centered and symmetrical, warm black linen, fine double hairlines, small geometric
// ornaments in brushed silver, and Cormorant Garamond set light (the one world allowed a serif).
// Signature motion: "ink on paper". Each beat of the problem sequence is written on with a soft
// horizontal ink-wipe mask, the words settling from a paler tone to full; the previous beat
// fades gently first. The GHD logo beat sits between two ruled lines that draw outward.
import '@fontsource-variable/cormorant-garamond';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import Layout from '../directions/Layout.astro';
import Marquee from '../directions/Marquee.astro';
import GhdLogo from '../directions/GhdLogo.astro';
import { CTA_LABEL, CTA_HREF, hero, heroServes, beats, howV4, industries, finalCta, proof, footer, fmt } from '../directions/copy';

type Beat = { lines: string[]; finale?: boolean; logo?: boolean };
const lead: Beat[] = beats.filter((b) => !b.finale);
const finale: Beat = beats.find((b) => b.finale)!;
const seq: Beat[] = [...lead, { lines: [], logo: true }, finale];
---

<Layout title="GHD Agency | Private Office" bodyClass="w1" theme="#0C0B0A">
  <div class="linen" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>

  <main>
    <!-- 1. HERO: the letterhead -->
    <section class="hero">
      <div class="crest">
        <span class="flank l" aria-hidden="true"><i></i></span>
        <GhdLogo class="hero-logo" />
        <span class="flank r" aria-hidden="true"><i></i></span>
      </div>
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 class="headline">{hero.headline}</h1>
      <p class="sub">{hero.subhead.map((l) => <span>{l}</span>)}</p>
      <div class="orn hero-orn" aria-hidden="true"><i></i><b></b><i></i></div>
      <p class="serves">{heroServes}</p>
      <a class="cta" href={CTA_HREF}>{CTA_LABEL}</a>
    </section>

    <!-- 2. CLIENT LOGOS -->
    <section class="logos fade" aria-label="Clients">
      <Marquee duration={60} />
    </section>

    <!-- 3. THE PROBLEM: a private letter, one line at a time -->
    <section class="problem" data-problem style={`--n:${seq.length}`}>
      <div class="stage">
        <div class="page-rule top" aria-hidden="true"><i></i><b></b><i></i></div>
        <div class="beats">
          {
            seq.map((b, i) => (
              <div class:list={['pl', 'fade', { finale: b.finale, 'logo-beat': b.logo }]} data-line>
                {b.logo && (
                  <div class="logo-frame">
                    <span class="rule" aria-hidden="true" />
                    <GhdLogo class="beat-logo" />
                    <span class="rule" aria-hidden="true" />
                  </div>
                )}
                {b.lines.map((line, j) => (
                  <p class:list={['ink', { partner: b.finale && j === 0, result: b.finale && j === 1 }]} style={`--d:${j}`}>
                    {line}
                  </p>
                ))}
              </div>
            ))
          }
        </div>
        <div class="page-rule bot" aria-hidden="true">
          <i></i>
          <span class="dots">{seq.map(() => <b></b>)}</span>
          <i></i>
        </div>
      </div>
    </section>

    <!-- 4. HOW WE WORK -->
    <section class="how">
      <p class="how-intro fade">{howV4.intro.map((l) => <span>{l}</span>)}</p>
      <div class="orn fade" aria-hidden="true"><i></i><b></b><i></i></div>
      <ol class="steps">
        {
          howV4.steps.map((s) => (
            <li class="step fade">
              <span class="numeral">{s.n}</span>
              <h2>{s.title}</h2>
              <p>{s.line}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- 5. WHO WE WORK WITH -->
    <section class="who">
      <p class="label fade">{industries.label}</p>
      <ul class="who-list fade">
        {industries.items.map((name) => <li>{name}</li>)}
      </ul>
    </section>

    <!-- 6. PROOF: a private statement -->
    <section class="proof" data-proof>
      <div class="ledger fade">
        <div class="dbl" aria-hidden="true"></div>
        <div class="orn" aria-hidden="true"><i></i><b></b><i></i></div>
        <dl class="rows">
          {
            proof.stats.map((s) => (
              <div class="row">
                <dt>{s.label}</dt>
                <span class="leader" aria-hidden="true" />
                <dd
                  class:list={['fig', { amber: s.money }]}
                  data-count={s.value}
                  data-prefix={s.prefix}
                  style={`min-width:${(s.prefix + fmt(s.value)).length}ch`}
                >
                  {s.prefix + fmt(s.value)}
                </dd>
              </div>
            ))
          }
        </dl>
        <div class="dbl" aria-hidden="true"></div>
        <p class="foot">{proof.footnote}</p>
      </div>
    </section>

    <!-- 7. FINAL CTA -->
    <section class="final">
      <div class="orn fade" aria-hidden="true"><i></i><b></b><i></i></div>
      <h2 class="final-head fade">{finalCta.headline}</h2>
      <p class="final-sub fade">{finalCta.sub}</p>
      <a class="cta fade" href={CTA_HREF}>{CTA_LABEL}</a>
    </section>
  </main>

  <footer class="footer">
    <div class="dbl" aria-hidden="true"></div>
    <p>{footer.name} · <a href={`mailto:${footer.email}`}>{footer.email}</a> · {footer.copyright}</p>
  </footer>
</Layout>

<script>
  import { motion, onFrame, pinProgress, fades, countUp, clamp } from '../directions/engine';

  fades();
  countUp(document.querySelector('[data-proof]')!, 1500);

  if (motion()) {
    // The monogram animates once as the letterhead opens.
    document.querySelector<HTMLVideoElement>('.hero-logo .ghd-video')?.play().catch(() => {});

    const section = document.querySelector<HTMLElement>('[data-problem]')!;
    const beatEls = Array.from(section.querySelectorAll<HTMLElement>('[data-line]'));
    const dots = Array.from(section.querySelectorAll<HTMLElement>('.dots b'));
    const n = beatEls.length;
    const logos = beatEls.map((el) => el.querySelector<HTMLVideoElement>('.ghd-video'));
    const started = logos.map(() => false);
    let loaded = false;
    let shown = -2;

    onFrame(() => {
      const top = section.getBoundingClientRect().top;
      if (!loaded && top < innerHeight * 2) {
        loaded = true;
        logos.forEach((v) => v?.load());
      }
      // Scroll only chooses which beat is on the page; each beat then writes itself on a timer.
      const p = pinProgress(section);
      const cur = top < innerHeight * 0.3 ? Math.min(n - 1, Math.floor(p * n * 1.08)) : -1;
      if (cur === shown) return;
      shown = cur;
      beatEls.forEach((el, i) => el.classList.toggle('on', i === cur));
      dots.forEach((d, i) => d.classList.toggle('on', i <= cur));
      logos.forEach((v, i) => {
        if (!v) return;
        if (i === cur && !started[i]) {
          started[i] = true;
          // Let the previous beat fade out before the monogram is drawn.
          setTimeout(() => {
            if (shown !== i) return;
            v.currentTime = 0;
            v.play().catch(() => {});
          }, 550);
        } else if (i > cur && started[i]) {
          started[i] = false;
          v.pause();
          v.currentTime = 0;
        }
      });
    });
    void clamp;
  }
</script>

<style is:global>
  .w1 {
    --paper: #0c0b0a;
    --paper-2: #121110;
    --serif: 'Cormorant Garamond Variable', 'Cormorant Garamond', Garamond, 'Times New Roman', serif;
    --inkc: #ece9e4;
    --hair: rgb(214 220 224 / 0.26);
    --hair-strong: rgb(214 220 224 / 0.42);
    --linen:
      repeating-linear-gradient(0deg, rgb(255 244 228 / 0.018) 0 1px, transparent 1px 3px),
      repeating-linear-gradient(90deg, rgb(255 244 228 / 0.014) 0 1px, transparent 1px 4px),
      repeating-linear-gradient(33deg, rgb(255 255 255 / 0.008) 0 1px, transparent 1px 7px),
      repeating-linear-gradient(-57deg, rgb(0 0 0 / 0.18) 0 1px, transparent 1px 5px),
      #0d0c0b;
    --brushed: linear-gradient(90deg, #8a949c, #e6ebee 50%, #8a949c);
    background: var(--paper);
    color: var(--inkc);
  }

  /* Warm linen: a faint woven grain from layered hairline gradients, plus a soft vignette. */
  .w1 .linen {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: var(--linen);
  }

  .w1 .vignette {
    position: fixed;
    inset: 0;
    z-index: 20;
    pointer-events: none;
    background: radial-gradient(ellipse 85% 75% at 50% 48%, transparent 45%, rgb(0 0 0 / 0.4) 100%);
  }

  .w1 .silver {
    color: transparent;
    background: var(--silver);
    -webkit-background-clip: text;
    background-clip: text;
  }

  /* ---- Ornaments: rule, diamond, rule ---- */
  .w1 .orn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }
  .w1 .orn i {
    width: clamp(40px, 7vw, 96px);
    height: 3px;
    border-block: 1px solid var(--hair);
  }
  .w1 .orn i:first-child {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000);
    mask-image: linear-gradient(90deg, transparent, #000);
  }
  .w1 .orn i:last-child {
    -webkit-mask-image: linear-gradient(90deg, #000, transparent);
    mask-image: linear-gradient(90deg, #000, transparent);
  }
  .w1 .orn b {
    width: 5px;
    height: 5px;
    background: var(--brushed);
    transform: rotate(45deg);
  }
  .w1 .dbl {
    height: 4px;
    border-block: 1px solid var(--hair);
  }

  .w1 .label {
    font-family: var(--font);
    font-weight: 300;
    font-size: 11px;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--gray);
  }

  /* ---- CTA: a refined outlined button, hairline border ---- */
  .w1 .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 44px;
    border: 1px solid rgb(214 220 224 / 0.45);
    outline: 1px solid rgb(214 220 224 / 0.12);
    outline-offset: 4px;
    font-family: var(--font);
    font-weight: 300;
    font-size: 12px;
    letter-spacing: 0.36em;
    text-indent: 0.36em;
    text-transform: uppercase;
    color: var(--cyan);
    transition: box-shadow 0.6s ease, border-color 0.6s ease, outline-color 0.6s ease;
  }
  .w1 .cta:hover,
  .w1 .cta:focus-visible {
    border-color: rgb(0 255 255 / 0.55);
    outline-color: rgb(0 255 255 / 0.18);
    box-shadow: 0 0 28px -6px rgb(0 255 255 / 0.45), inset 0 0 18px -8px rgb(0 255 255 / 0.4);
  }

  /* ================= HERO ================= */
  .w1 .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(40px, 6vh, 72px) var(--gutter);
    text-align: center;
  }
  .w1 .crest {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(14px, 2vw, 28px);
    mix-blend-mode: lighten;
    margin-bottom: clamp(18px, 3.2vh, 36px);
  }
  .w1 .hero-logo {
    width: clamp(120px, min(12vw, 16svh * 2.52), 190px);
    flex: none;
  }
  .w1 .flank {
    position: relative;
    display: block;
    width: clamp(36px, 9vw, 150px);
    height: 4px;
    border-block: 1px solid var(--hair-strong);
  }
  .w1 .flank.l {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 60%);
    mask-image: linear-gradient(90deg, transparent, #000 60%);
    transform-origin: right;
  }
  .w1 .flank.r {
    -webkit-mask-image: linear-gradient(90deg, #000 40%, transparent);
    mask-image: linear-gradient(90deg, #000 40%, transparent);
    transform-origin: left;
  }
  .w1 .eyebrow {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(28px, min(3vw, 5svh), 46px);
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: #d9dee1;
    margin-bottom: clamp(10px, 1.8vh, 20px);
  }
  .w1 .headline {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(40px, min(5.6vw, 9.2svh), 96px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    max-width: 17ch;
    color: #eef0f1;
    text-wrap: balance;
  }
  .w1 .sub {
    margin-top: clamp(18px, 3vh, 32px);
    font-family: var(--font);
    font-weight: 300;
    font-size: clamp(15px, 1.1vw, 17px);
    line-height: 1.75;
    letter-spacing: 0.02em;
    color: var(--gray);
  }
  .w1 .sub span {
    display: block;
  }
  .w1 .hero-orn {
    margin-top: clamp(16px, 2.6vh, 28px);
  }
  .w1 .serves {
    margin-top: clamp(12px, 2vh, 22px);
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(21px, min(1.9vw, 3.2svh), 30px);
    line-height: 1.3;
    color: #e3e6e8;
    text-wrap: balance;
  }
  .w1 .hero .cta {
    margin-top: clamp(22px, 4vh, 44px);
  }
  /* The headline is visible from first paint (LCP); everything else settles in after the monogram. */
  .m .w1 .hero .flank {
    animation: w1-draw 1.6s 0.4s cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  .m .w1 .eyebrow,
  .m .w1 .sub,
  .m .w1 .hero-orn,
  .m .w1 .serves,
  .m .w1 .hero .cta {
    animation: w1-rise 1.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .m .w1 .eyebrow { animation-delay: 0.3s; }
  .m .w1 .sub { animation-delay: 0.9s; }
  .m .w1 .hero-orn { animation-delay: 1.1s; }
  .m .w1 .serves { animation-delay: 1.25s; }
  .m .w1 .hero .cta { animation-delay: 1.45s; }
  @keyframes w1-draw {
    from { transform: scaleX(0); }
  }
  @keyframes w1-rise {
    from { opacity: 0; transform: translateY(10px); }
  }

  /* ================= LOGOS ================= */
  .w1 .logos {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .w1 .logos .mq {
    --logo-h: 30px;
    padding: 30px 0;
    border-block: 1px solid var(--hair);
    position: relative;
  }
  .w1 .logos .mq img {
    opacity: 0.5;
  }

  /* ================= PROBLEM ================= */
  .w1 .problem {
    padding: 18vh var(--gutter);
    text-align: center;
  }
  .w1 .page-rule {
    display: none;
  }
  .w1 .beats {
    display: flex;
    flex-direction: column;
    gap: clamp(56px, 11vh, 120px);
  }
  .w1 .pl {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(32px, 4.4vw, 72px);
    line-height: 1.12;
    letter-spacing: -0.005em;
    color: var(--inkc);
    text-wrap: balance;
  }
  .w1 .pl p {
    max-width: 22ch;
    margin-inline: auto;
  }
  .w1 .pl p + p {
    margin-top: 0.25em;
  }
  .w1 .pl.finale .partner {
    color: transparent;
    background: var(--silver);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .w1 .pl.finale .result {
    margin-top: 0.5em;
    font-style: italic;
    font-weight: 400;
    color: var(--cyan);
    text-shadow: 0 0 22px rgb(0 255 255 / 0.5), 0 0 60px rgb(0 255 255 / 0.2);
  }
  .w1 .logo-frame {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(22px, 4vh, 40px);
    mix-blend-mode: lighten;
  }
  .w1 .logo-frame .rule {
    display: block;
    width: min(76vw, 620px);
    height: 4px;
    border-block: 1px solid var(--hair-strong);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 25%, #000 75%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 25%, #000 75%, transparent);
  }
  .w1 .beat-logo {
    width: min(68vw, 520px);
  }

  /* Motion: the sticky page. */
  @property --ink {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 130%;
  }
  .m .w1 .problem {
    height: calc(var(--n) * 76svh + 100svh);
    padding: 0;
  }
  .m .w1 .stage {
    background: var(--linen);
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  .m .w1 .page-rule {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .m .w1 .page-rule.top { top: clamp(28px, 7svh, 64px); }
  .m .w1 .page-rule.bot { bottom: clamp(28px, 7svh, 64px); }
  .m .w1 .page-rule i {
    width: clamp(60px, 16vw, 240px);
    height: 4px;
    border-block: 1px solid var(--hair);
  }
  .m .w1 .page-rule i:first-child {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000);
    mask-image: linear-gradient(90deg, transparent, #000);
  }
  .m .w1 .page-rule i:last-child {
    -webkit-mask-image: linear-gradient(90deg, #000, transparent);
    mask-image: linear-gradient(90deg, #000, transparent);
  }
  .m .w1 .page-rule > b {
    width: 5px;
    height: 5px;
    background: var(--brushed);
    transform: rotate(45deg);
  }
  .w1 .dots {
    display: flex;
    gap: 12px;
  }
  .w1 .dots b {
    width: 5px;
    height: 5px;
    border: 1px solid rgb(214 220 224 / 0.4);
    transform: rotate(45deg);
    transition: background-color 1s ease, border-color 1s ease;
  }
  .w1 .dots b.on {
    background: #c9d0d4;
    border-color: #c9d0d4;
  }
  .m .w1 .pl {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(88vw, 1000px);
    transform: translate(-50%, -50%);
    opacity: 0;
    visibility: hidden;
    /* Leaving: a slow, gentle fade. */
    transition: opacity 0.55s ease, visibility 0s 0.55s !important;
  }
  .m .w1 .pl.logo-beat {
    mix-blend-mode: lighten;
  }
  .m .w1 .pl.on {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.3s ease 0.5s, visibility 0s 0.5s !important;
  }
  /* The ink-wipe: a soft-edged mask travels left to right, and the words settle from pale to full tone. */
  .m .w1 .pl .ink {
    --ink: -30%;
    -webkit-mask-image: linear-gradient(90deg, #000 calc(var(--ink) - 28%), transparent var(--ink));
    mask-image: linear-gradient(90deg, #000 calc(var(--ink) - 28%), transparent var(--ink));
    opacity: 0.5;
    transition: --ink 0s 0.6s, opacity 0s 0.6s;
  }
  .m .w1 .pl.on .ink {
    --ink: 130%;
    opacity: 1;
    transition:
      --ink 1.25s cubic-bezier(0.45, 0.05, 0.3, 1) calc(0.55s + var(--d, 0) * 0.85s),
      opacity 1.7s ease calc(0.75s + var(--d, 0) * 0.85s);
  }
  .m .w1 .pl.finale.on .result {
    transition:
      --ink 1.25s cubic-bezier(0.45, 0.05, 0.3, 1) 1.5s,
      opacity 1.7s ease 1.7s;
  }
  /* The monogram beat: two rules draw outward from the centre, then the logo is drawn between them. */
  .m .w1 .logo-frame .rule {
    transform: scaleX(0);
    transition: transform 0s 0.6s;
  }
  .m .w1 .pl.on .logo-frame .rule {
    transform: scaleX(1);
    transition: transform 1.4s cubic-bezier(0.65, 0, 0.35, 1) 0.45s;
  }

  /* ================= HOW WE WORK ================= */
  .w1 .how {
    padding: clamp(120px, 22vh, 240px) var(--gutter) clamp(100px, 18vh, 200px);
    text-align: center;
  }
  .w1 .how-intro {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(27px, 3.4vw, 56px);
    line-height: 1.22;
    color: var(--inkc);
  }
  .w1 .how-intro span {
    display: block;
  }
  .w1 .how-intro span:last-child {
    margin-top: 0.4em;
    font-style: italic;
    color: #cfd5d9;
  }
  .w1 .how > .orn {
    margin: clamp(48px, 9vh, 96px) 0;
  }
  .w1 .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto auto auto;
    max-width: 1180px;
    margin: 0 auto;
  }
  .w1 .step {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: 0;
    padding: 0 clamp(20px, 3.4vw, 56px);
    border-left: 1px solid var(--hair);
  }
  .w1 .step:first-child {
    border-left: 0;
  }
  .w1 .numeral {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(72px, 7vw, 116px);
    line-height: 1;
    font-variant-numeric: lining-nums;
    color: transparent;
    background: var(--silver);
    -webkit-background-clip: text;
    background-clip: text;
    padding: 0 0.1em 0.05em;
    justify-self: center;
  }
  .w1 .step h2 {
    margin-top: clamp(18px, 2.4vw, 30px);
    font-family: var(--font);
    font-weight: 300;
    font-size: 12px;
    line-height: 1.6;
    letter-spacing: 0.34em;
    text-indent: 0.34em;
    text-transform: uppercase;
    color: #dfe3e6;
  }
  .w1 .step p {
    margin-top: 16px;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(19px, 1.45vw, 22px);
    line-height: 1.5;
    color: #aeb5ba;
