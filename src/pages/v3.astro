---
// V3: SIGNAL ROOM. Data terminal meets revenue dashboard: thin rules, Roboto Mono data accents,
// ticking readouts, a scanning line. The problem section resolves like a system log; the proof
// band is the centrepiece.
import Layout from '../directions/Layout.astro';
import Words from '../directions/Words.astro';
import Marquee from '../directions/Marquee.astro';
import { CTA_LABEL, CTA_HREF, hero, logoRow, problem, how, proof, footer, fmt } from '../directions/copy';

// Decorative signal trace for the hero panel (a rising, noisy series).
const pts = Array.from({ length: 41 }, (_, i) => {
  const x = i * 10;
  const trend = 150 - i * 2.9;
  const noise = Math.sin(i * 1.7) * 9 + Math.sin(i * 0.6) * 12;
  return [x, Math.max(14, Math.min(176, trend + noise))];
});
const path = pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x} ${y.toFixed(1)}`).join(' ');
const area = `${path} L400 190 L0 190 Z`;
---

<Layout title="GHD Agency | V3 Signal Room" bodyClass="v3">
  <main>
    <!-- 1. HERO -->
    <section class="hero">
      <div class="bar" aria-hidden="true">
        <span class="dot"></span>
        <span class="num tick" data-clock>00:00:00.0</span>
      </div>
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{hero.eyebrow}</p>
          <h1 class="display">{hero.headline}</h1>
          <p class="sub">{hero.subhead.map((l) => <span>{l}</span>)}</p>
          <a class="cta" href={CTA_HREF}>{CTA_LABEL}</a>
        </div>
        <div class="signal" aria-hidden="true">
          <svg viewBox="0 0 400 190" preserveAspectRatio="none">
            <defs>
              <linearGradient id="v3-stroke" x1="0" x2="1">
                <stop offset="0" stop-color="#009FA4" />
                <stop offset="1" stop-color="#00FFFF" />
              </linearGradient>
              <linearGradient id="v3-fill" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0" stop-color="#00FFFF" stop-opacity="0.18" />
                <stop offset="1" stop-color="#00FFFF" stop-opacity="0" />
              </linearGradient>
            </defs>
            <path class="area" d={area} fill="url(#v3-fill)" />
            <path class="trace" d={path} fill="none" stroke="url(#v3-stroke)" stroke-width="2" vector-effect="non-scaling-stroke" pathLength="1" />
          </svg>
          <span class="scan"></span>
          <div class="readouts">
            <span class="num" data-drift="1.8">+18.4</span>
            <span class="num" data-drift="0.6">0.927</span>
            <span class="num" data-drift="4">1,204</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. LOGO ROW -->
    <section class="logos fade">
      <p class="label">{logoRow.label}</p>
      <Marquee duration={38} />
    </section>

    <!-- 3. THE PROBLEM -->
    <section class="problem" data-problem style={`--n:${problem.length}`}>
      <div class="stage">
        <div class="term">
          <div class="term-bar" aria-hidden="true">
            <span class="dot"></span>
            <span class="num tick" data-clock>00:00:00.0</span>
            <span class="meter"><i></i></span>
          </div>
          <div class="term-body">
            <span class="scan" aria-hidden="true"></span>
            <ol class="log">
              {problem.map((line, i) => (
                <li class="pl fade" data-line class:list={{ last: i === problem.length - 1 }}>
                  <span class="ln num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <p><Words text={line} /><span class="caret" aria-hidden="true"></span></p>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. HOW WE WORK -->
    <section class="how">
      <ol class="cols">
        {how.steps.map((s) => (
          <li class="col fade">
            <span class="num idx">{s.n}</span>
            <h2>{s.title}</h2>
          </li>
        ))}
      </ol>
      <div class="closing">
        <p class="partner" data-scrub><Words text={how.partner} class="w-silver" /></p>
        <p class="result" data-scrub><Words text={how.result} class="w-cyan" /></p>
      </div>
    </section>

    <!-- 5. PROOF BAND -->
    <section class="proof" data-proof>
      <div class="proof-inner">
        <dl class="stats">
          {proof.stats.map((s) => (
            <div class="stat fade">
              <dt>{s.label}</dt>
              <dd class:list={['num', 'figure', { amber: s.money }]} data-count={s.value} data-prefix={s.prefix} style={`min-width:${(s.prefix + fmt(s.value)).length}ch`}>
                {s.prefix + fmt(s.value)}
              </dd>
              <span class="track" aria-hidden="true"><i></i></span>
            </div>
          ))}
        </dl>
        <p class="foot">{proof.footnote}</p>
      </div>
    </section>

    <!-- 6. FINAL CTA -->
    <section class="final">
      <a class="cta fade" href={CTA_HREF}>{CTA_LABEL}</a>
    </section>
  </main>

  <footer class="footer">
    <p>{footer.name} · <a href={`mailto:${footer.email}`}>{footer.email}</a> · {footer.copyright}</p>
  </footer>
</Layout>

<script>
  import { motion, onFrame, problemTimeline, pinProgress, scrubOnView, fades, countUp, clamp } from '../directions/engine';

  fades();
  const band = document.querySelector<HTMLElement>('[data-proof]')!;
  countUp(band, 1500, () => band.classList.add('counting'));

  if (motion()) {
    // Ticking readouts: a running clock and a few drifting values. Decorative only.
    const clocks = document.querySelectorAll<HTMLElement>('[data-clock]');
    const drift = document.querySelectorAll<HTMLElement>('[data-drift]');
    const base = drift.length ? Array.from(drift).map((el) => parseFloat(el.textContent!.replace(/[^\d.-]/g, ''))) : [];
    const t0 = performance.now();
    setInterval(() => {
      const ms = performance.now() - t0;
      const s = ms / 1000;
      const txt = `${String(Math.floor(s / 3600)).padStart(2, '0')}:${String(Math.floor(s / 60) % 60).padStart(2, '0')}:${String(Math.floor(s) % 60).padStart(2, '0')}.${Math.floor((ms % 1000) / 100)}`;
      clocks.forEach((c) => (c.textContent = txt));
    }, 100);
    setInterval(() => {
      drift.forEach((el, i) => {
        const b = base[i];
        const v = b + (Math.random() - 0.5) * Number(el.dataset.drift);
        el.textContent = b > 100 ? Math.round(v).toLocaleString('en-US') : (b < 1 ? v.toFixed(3) : (v >= 0 ? '+' : '') + v.toFixed(1));
      });
    }, 900);

    document.querySelectorAll<HTMLElement>('[data-scrub]').forEach((el) => scrubOnView(el));

    const section = document.querySelector<HTMLElement>('[data-problem]')!;
    const body = section.querySelector<HTMLElement>('.term-body')!;
    const log = section.querySelector<HTMLElement>('.log')!;
    const meter = section.querySelector<HTMLElement>('.meter i')!;
    const tl = problemTimeline(section);

    onFrame(() => {
      const { lines, lp, t } = tl(pinProgress(section));
      let active = -1;
      lines.forEach((el, i) => {
        const on = lp[i] > 0 || i === 0;
        el.classList.toggle('shown', on);
        if (on) active = i;
      });
      lines.forEach((el, i) => el.classList.toggle('cur', i === active));
      meter.style.transform = `scaleX(${t.toFixed(4)})`;
      // Keep the newest log line in view, like a terminal that scrolls as it prints.
      const lastEl = lines[Math.max(0, active)];
      const bottom = lastEl.offsetTop + lastEl.offsetHeight;
      const room = body.clientHeight - 48;
      log.style.transform = `translate3d(0, ${-Math.max(0, bottom - room)}px, 0)`;
      section.classList.toggle('held', t >= 1);
    });
  }
</script>

<style is:global>
  .v3 {
    --rule: rgb(138 148 156 / 0.18);
    --rule-hi: rgb(0 255 255 / 0.28);
  }
  .v3 .dot {
    display: inline-block;
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 0 0 rgb(0 255 255 / 0.6);
    animation: v3-pulse 2s ease-out infinite;
  }
  @keyframes v3-pulse {
    0% { box-shadow: 0 0 0 0 rgb(0 255 255 / 0.55); }
    100% { box-shadow: 0 0 0 10px rgb(0 255 255 / 0); }
  }
  .v3 .tick {
    font-size: 12px;
    color: var(--gray);
    letter-spacing: 0.06em;
  }

  /* HERO */
  .v3 .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding: 0 var(--gutter) clamp(40px, 6vh, 72px);
  }
  .v3 .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    border-bottom: 1px solid var(--rule);
  }
  .v3 .hero-grid {
    flex: 1;
    display: grid;
    grid-template-columns: 7fr 5fr;
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
    padding-top: clamp(40px, 8vh, 96px);
  }
  .v3 .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 500;
    font-size: 14px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gray);
    margin-bottom: 28px;
  }
  .v3 .display {
    font-weight: 800;
    font-size: clamp(44px, 6.2vw, 108px);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .v3 .sub {
    margin-top: 32px;
    padding-left: 18px;
    border-left: 1px solid var(--rule-hi);
    font-weight: 300;
    font-size: clamp(17px, 1.4vw, 21px);
    line-height: 1.55;
    color: var(--gray);
  }
  .v3 .sub span {
    display: block;
  }
  .v3 .cta {
    display: inline-flex;
    align-items: center;
    margin-top: 40px;
    padding: 18px 30px;
    border-radius: 3px;
    background: var(--cyan);
    color: var(--base);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 0.04em;
    box-shadow: 0 0 0 1px var(--cyan), 0 10px 40px -10px rgb(0 255 255 / 0.6);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }
  .v3 .cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 0 1px var(--cyan), 0 16px 56px -8px rgb(0 255 255 / 0.8);
  }

  .v3 .signal {
    position: relative;
    aspect-ratio: 4 / 3.2;
    border: 1px solid var(--rule);
    background:
      linear-gradient(var(--rule) 1px, transparent 1px) 0 0 / 100% 25%,
      linear-gradient(90deg, var(--rule) 1px, transparent 1px) 0 0 / 12.5% 100%,
      var(--raised);
    overflow: hidden;
  }
  .v3 .signal svg {
    position: absolute;
    inset: 12% 0 22% 0;
    width: 100%;
    height: 66%;
  }
  .v3 .trace {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    filter: drop-shadow(0 0 6px rgb(0 255 255 / 0.6));
  }
  .m .v3 .trace {
    animation: v3-draw 2.4s 0.3s cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  .m .v3 .area {
    animation: v3-fade 1.2s 1.6s both;
  }
  @keyframes v3-fade {
    from { opacity: 0; }
  }
  @keyframes v3-draw {
    from { stroke-dashoffset: 1; }
  }
  .v3 .signal .scan {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    background: var(--cyan);
    box-shadow: 0 0 12px var(--cyan);
    opacity: 0.7;
  }
  .m .v3 .signal .scan {
    animation: v3-sweep 5s linear infinite;
  }
  @keyframes v3-sweep {
    from { left: 0; }
    to { left: 100%; }
  }
  .v3 .readouts {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--rule);
  }
  .v3 .readouts span {
    padding: 14px 16px;
    font-size: clamp(13px, 1.1vw, 16px);
    color: var(--white);
  }
  .v3 .readouts span + span {
    border-left: 1px solid var(--rule);
  }

  /* LOGOS */
  .v3 .logos {
    display: grid;
    grid-template-columns: minmax(200px, 3fr) 9fr;
    align-items: center;
    gap: 32px;
    margin: 0 var(--gutter);
    padding: 28px 0;
    border-block: 1px solid var(--rule);
  }
  .v3 .label {
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gray);
    line-height: 1.6;
  }
  .v3 .mq {
    --logo-h: 30px;
  }

  /* PROBLEM (static default) */
  .v3 .problem {
    padding: 14vh var(--gutter);
  }
  .v3 .term {
    max-width: 1180px;
    margin: 0 auto;
    border: 1px solid var(--rule);
    background: var(--raised);
  }
  .v3 .term-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 44px;
    padding: 0 18px;
    border-bottom: 1px solid var(--rule);
  }
  .v3 .meter {
    flex: 1;
    height: 2px;
    background: var(--rule);
  }
  .v3 .meter i {
    display: block;
    height: 100%;
    background: var(--tc);
    transform-origin: left;
    box-shadow: 0 0 10px rgb(0 255 255 / 0.6);
  }
  .v3 .term-body {
    position: relative;
    padding: clamp(24px, 3vw, 44px) clamp(18px, 3vw, 44px);
    overflow: hidden;
  }
  .v3 .log {
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1.2vh, 16px);
  }
  .v3 .pl {
    display: grid;
    grid-template-columns: 3.2ch 1fr;
    align-items: baseline;
    gap: clamp(12px, 2vw, 28px);
    padding-left: 14px;
    border-left: 2px solid transparent;
  }
  .v3 .ln {
    font-size: 13px;
    color: var(--gray);
    opacity: 0.6;
  }
  .v3 .pl p {
    font-weight: 500;
    font-size: clamp(22px, 3.1vw, 46px);
    line-height: 1.14;
    letter-spacing: -0.02em;
  }
  .v3 .pl.last p {
    font-weight: 700;
  }
  .v3 .pl.last .ln {
    color: var(--cyan);
    opacity: 1;
  }
  .v3 .caret {
    display: none;
  }
  .v3 .scan {
    display: none;
  }
  /* PROBLEM (pinned) */
  .m .v3 .problem {
    height: calc(var(--n) * 46svh + 140svh);
    padding: 0 var(--gutter);
  }
  .m .v3 .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    align-items: center;
  }
  .m .v3 .term {
    width: 100%;
  }
  .m .v3 .term-body {
    height: min(68svh, 640px);
  }
  .m .v3 .log {
    will-change: transform;
  }
  .m .v3 .pl:not(.shown) {
    opacity: 0 !important;
  }
  .m .v3 .pl.cur {
    border-left-color: var(--cyan);
  }
  .m .v3 .pl.cur .ln {
    color: var(--cyan);
    opacity: 1;
  }
  .m .v3 .pl.cur .caret {
    display: inline-block;
    width: 0.5em;
    height: 0.9em;
    margin-left: 0.15em;
    vertical-align: -0.08em;
    background: var(--cyan);
    box-shadow: 0 0 12px var(--cyan);
    animation: v3-caret 1s steps(2, jump-none) infinite;
  }
  @keyframes v3-caret {
    50% { opacity: 0; }
  }
  .m .v3 .scan {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 80px;
    background: linear-gradient(transparent, rgb(0 255 255 / 0.06) 85%, rgb(0 255 255 / 0.35) 99%, transparent);
    pointer-events: none;
    animation: v3-scan 4.5s linear infinite;
  }
  @keyframes v3-scan {
    from { transform: translateY(-80px); }
    to { transform: translateY(min(68svh, 640px)); }
  }
  .m .v3 .problem.held .pl.last p {
    animation: v3-glow 2.4s ease-in-out infinite;
  }
  @keyframes v3-glow {
    50% { text-shadow: 0 0 28px rgb(0 255 255 / 0.35); }
  }

  /* HOW WE WORK */
  .v3 .how {
    padding: clamp(96px, 16vh, 180px) var(--gutter);
  }
  .v3 .cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-block: 1px solid var(--rule);
  }
  .v3 .col {
    padding: clamp(28px, 3vw, 44px) clamp(20px, 2.4vw, 36px) clamp(40px, 5vw, 72px);
  }
  .v3 .col + .col {
    border-left: 1px solid var(--rule);
  }
  .v3 .idx {
    display: block;
    font-size: clamp(40px, 4.4vw, 68px);
    line-height: 1;
    font-weight: 300;
    color: var(--cyan);
  }
  .v3 .col h2 {
    margin-top: clamp(40px, 6vw, 88px);
    font-weight: 700;
    font-size: clamp(24px, 2.4vw, 36px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .v3 .closing {
    margin-top: clamp(96px, 16vh, 180px);
  }
  .v3 .closing p {
    font-weight: 800;
    font-size: clamp(36px, 5.6vw, 96px);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .v3 .result {
    margin-top: 0.3em;
  }

  /* PROOF (centrepiece) */
  .v3 .proof {
    position: relative;
    padding: clamp(96px, 16vh, 180px) var(--gutter);
    background:
      linear-gradient(var(--rule) 1px, transparent 1px) 0 0 / 100% 64px,
      linear-gradient(90deg, var(--rule) 1px, transparent 1px) 0 0 / 64px 100%,
      var(--raised);
    border-block: 1px solid var(--rule-hi);
  }
  .v3 .proof::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 60% at 50% 50%, rgb(20 23 26 / 0.2), var(--raised) 85%);
  }
  .v3 .proof-inner {
    position: relative;
    max-width: 1320px;
    margin: 0 auto;
  }
  .v3 .proof-head {
    display: flex;
    align-items: center;
    gap: 16px;
    font-weight: 700;
    font-size: clamp(22px, 2.6vw, 40px);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .v3 .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: clamp(40px, 6vw, 72px);
    border: 1px solid var(--rule);
    background: rgb(10 11 13 / 0.7);
  }
  .v3 .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    position: relative;
    padding: clamp(28px, 3vw, 44px) clamp(20px, 2.4vw, 36px) clamp(40px, 4vw, 56px);
  }
  .v3 .stat + .stat {
    border-left: 1px solid var(--rule);
  }
  .v3 .figure {
    font-size: clamp(44px, 6vw, 104px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .v3 .stat dt {
    margin-top: 14px;
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gray);
  }
  .v3 .track {
    position: absolute;
    left: clamp(20px, 2.4vw, 36px);
    right: clamp(20px, 2.4vw, 36px);
    bottom: clamp(18px, 2vw, 26px);
    height: 2px;
    background: var(--rule);
  }
  .v3 .track i {
    display: block;
    height: 100%;
    background: var(--tc);
    box-shadow: 0 0 10px rgb(0 255 255 / 0.5);
    transform-origin: left;
  }
  .m .v3 .track i {
    transform: scaleX(0);
    transition: transform 1.5s cubic-bezier(0.33, 1, 0.68, 1);
  }
  .m .v3 .counting .track i {
    transform: scaleX(1);
  }
  .m .v3 .counted .figure {
    animation: v3-breathe 3.2s ease-in-out infinite;
  }
  .m .v3 .counted .figure.amber {
    animation-name: v3-breathe-amber;
  }
  @keyframes v3-breathe {
    50% { text-shadow: 0 0 24px rgb(242 245 247 / 0.28); }
  }
  @keyframes v3-breathe-amber {
    50% { text-shadow: 0 0 28px rgb(255 181 71 / 0.45); }
  }
  .v3 .foot {
    margin-top: 20px;
    font-size: 13px;
    color: var(--gray);
    max-width: 90ch;
  }

  /* FINAL CTA */
  .v3 .final {
    display: grid;
    place-items: center;
    min-height: 80svh;
    padding: 0 var(--gutter);
    background:
      linear-gradient(90deg, transparent, var(--rule-hi) 30%, transparent calc(50% - 170px), transparent calc(50% + 170px), var(--rule-hi) 70%, transparent) center / 100% 1px no-repeat;
  }
  .v3 .final .cta {
    margin: 0;
    padding: 22px 40px;
    font-size: 18px;
  }

  .v3 .footer {
    margin: 0 var(--gutter);
    padding: 24px 0 36px;
    border-top: 1px solid var(--rule);
    font-size: 14px;
    color: var(--gray);
  }
  .v3 .footer a:hover {
    color: var(--cyan);
  }

  @media (max-width: 900px) {
    .v3 .hero-grid {
      grid-template-columns: 1fr;
      align-content: center;
    }
    .v3 .signal {
      aspect-ratio: 16 / 9;
    }
    .v3 .logos {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .v3 .cols,
    .v3 .stats {
      grid-template-columns: 1fr;
    }
    .v3 .col + .col,
    .v3 .stat + .stat {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
    .v3 .col h2 {
      margin-top: 20px;
    }
    .v3 .pl {
      grid-template-columns: 2.4ch 1fr;
      padding-left: 10px;
