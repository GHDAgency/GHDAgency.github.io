---
// Index of the five homepage design directions.
import Layout from '../directions/Layout.astro';

const directions = [
  { href: '/w1/', name: 'Private Office', line: 'Old-money quiet wealth: centered serif letterhead, statements written on like ink.' },
  { href: '/w4/', name: 'Schematic', line: 'The engine, drawn: callouts point at broken parts until GHD snaps it together.' },
  { href: '/w5/', name: 'The Gallery', line: 'A private gallery after hours: each statement hung under its own spotlight.' },
  { href: '/v1/', name: 'Obsidian Command', line: 'Dark command center: blueprint grid under glass, neon cyan edges, condensed heavy caps.' },
  { href: '/v2/', name: 'Editorial Monolith', line: 'Massive left-aligned type and black space; colour held back until the closing lines.' },
  { href: '/v3/', name: 'Signal Room', line: 'Data terminal meets revenue dashboard: mono readouts, scanning line, a system-log reveal.' },
  { href: '/v4-noise/', name: 'V4 · Noise to Clarity', line: 'Liquid Metal, revised copy. Beats pulled out of a cloud of fragments (recommended).' },
  { href: '/v4-line/', name: 'V4 · Revenue Line', line: 'A cyan pipeline runs under the beats, broken where revenue leaks, whole into GHD.' },
  { href: '/v4-engine/', name: 'V4 · Build the Engine', line: 'Words slide in and lock between machined rails that light when complete.' },
  { href: '/v4-plates/', name: 'V4 · Stacked Plates', line: 'Each beat on a polished alloy panel that settles over the last.' },
  { href: '/v4-rise/', name: 'V4 · Masked Rise', line: 'Each line rises crisply from behind a hidden edge. The most restrained.' },
  { href: '/v5/', name: 'Split Contrast', line: 'Architectural black and soft-white rhythm with a horizontal problem sequence.' },
];
---

<Layout title="GHD Agency | Homepage directions" bodyClass="dir">
  <main>
    <h1>GHD Agency homepage directions</h1>
    <ol>
      {directions.map((d) => (
        <li>
          <a href={d.href}>
            <span class="num">{d.href.replaceAll('/', '').toUpperCase()}</span>
            <span class="name">{d.name}</span>
            <span class="line">{d.line}</span>
          </a>
        </li>
      ))}
    </ol>
  </main>
</Layout>

<style is:global>
  .dir main {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(56px, 12vh, 120px) var(--gutter);
  }
  .dir h1 {
    font-weight: 800;
    font-size: clamp(28px, 4vw, 48px);
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: clamp(32px, 6vh, 56px);
    background: var(--silver);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .dir ol {
    border-top: 1px solid rgb(138 148 156 / 0.2);
  }
  .dir li {
    border-bottom: 1px solid rgb(138 148 156 / 0.2);
  }
  .dir a {
    display: grid;
    grid-template-columns: 9ch 22ch 1fr;
    align-items: baseline;
    gap: 20px;
    padding: 26px 8px;
    transition: background 0.25s ease;
  }
  .dir a:hover {
    background: var(--raised);
  }
  .dir .num {
    color: var(--cyan);
    font-size: 15px;
  }
  .dir .name {
    font-weight: 700;
    font-size: 20px;
  }
  .dir .line {
    color: var(--gray);
    font-weight: 300;
    font-size: 17px;
  }
  @media (max-width: 720px) {
    .dir a {
      grid-template-columns: 4ch 1fr;
      row-gap: 6px;
    }
    .dir .line {
      grid-column: 2;
    }
  }
</style>
