---
import { nav } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,border-color,backdrop-filter] duration-500 border-b border-transparent"
>
  <div class="container-x flex h-18 items-center justify-between gap-6">
    <a href="/" class="relative z-10 flex items-center gap-3" aria-label="GHD Agency.ai — home">
      <img src="/images/logo.webp" alt="GHD" width="552" height="219" class="blend-screen h-9 w-auto" />
      <span class="hidden font-display text-sm font-medium tracking-wide text-mist/70 xl:block">
        Generative Human Design™
      </span>
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="glass flex items-center gap-1 rounded-full p-1.5">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'relative block whitespace-nowrap rounded-full px-4 py-2 text-sm font-medium transition-colors duration-300',
                  isActive(item.href)
                    ? 'bg-cyan-glow/12 text-white shadow-[inset_0_0_0_1px_rgb(0_240_255/0.35)]'
                    : 'text-mist/70 hover:text-white',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <button type="button" data-demo-open class="btn btn-primary hidden !py-2.5 !px-5 text-sm sm:inline-flex" data-magnetic>
        <span class="size-2 rounded-full bg-ink-950 animate-pulse-dot"></span>
        Free AI Demo
      </button>
      <button
        type="button"
        id="menu-toggle"
        class="glass relative grid size-11 place-items-center rounded-full lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <span class="menu-line absolute h-0.5 w-5 -translate-y-1.5 rounded bg-white transition-transform duration-300"></span>
        <span class="menu-line absolute h-0.5 w-5 translate-y-1.5 rounded bg-white transition-transform duration-300"></span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="pointer-events-none fixed inset-0 -z-10 bg-ink-950/95 opacity-0 backdrop-blur-xl transition-opacity duration-500 lg:hidden"
  >
    <nav aria-label="Mobile" class="container-x flex h-full flex-col justify-center gap-2">
      {
        nav.map((item, i) => (
          <a
            href={item.href}
            class="mobile-link translate-y-6 font-display text-4xl font-semibold opacity-0 transition-all duration-500"
            style={`transition-delay:${80 + i * 60}ms`}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <span class={isActive(item.href) ? 'text-gradient' : 'text-white'}>{item.label}</span>
          </a>
        ))
      }
      <button type="button" data-demo-open class="btn btn-primary mt-8 self-start">Receive an Ai Demo Call</button>
    </nav>
  </div>
</header>

<style>
  #site-header.is-scrolled {
    background-color: rgb(3 7 8 / 0.72);
    border-color: rgb(255 255 255 / 0.06);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
  }
  #site-header.menu-open #mobile-menu {
    opacity: 1;
    pointer-events: auto;
  }
  #site-header.menu-open .mobile-link {
    opacity: 1;
    translate: none;
  }
  /* Tailwind v4 translate utilities use the separate `translate` property, so reset it too. */
  #site-header.menu-open .menu-line:first-child {
    translate: none;
    transform: rotate(45deg);
  }
  #site-header.menu-open .menu-line:last-child {
    translate: none;
    transform: rotate(-45deg);
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;

  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setMenu = (open: boolean) => {
    header.classList.toggle('menu-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.documentElement.classList.toggle('overflow-hidden', open);
  };
  toggle.addEventListener('click', () => setMenu(!header.classList.contains('menu-open')));
  document.querySelectorAll('#mobile-menu a, #mobile-menu button').forEach((el) =>
    el.addEventListener('click', () => setMenu(false)),
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });
</script>
