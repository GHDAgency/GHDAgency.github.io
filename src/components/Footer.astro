---
import { company, footerLinks, legalLinks, disclosures } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="relative mt-10 overflow-hidden border-t border-white/6 bg-ink-950">
  <div aria-hidden="true" class="pointer-events-none absolute -top-40 left-1/2 h-80 w-[60rem] -translate-x-1/2 rounded-full bg-cyan-glow/10 blur-[120px]"></div>

  <div class="container-x relative py-16 md:py-20">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <img src="/images/logo-footer.webp" alt="GHD" width="552" height="219" loading="lazy" class="blend-screen h-14 w-auto" />
        <p class="mt-5 font-display text-2xl font-medium text-white">{company.tagline}</p>
        <p class="mt-3 max-w-sm text-sm text-slate-soft">{company.motto}</p>
      </div>

      <div class="grid grid-cols-2 gap-8 md:col-span-4">
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-cyan-glow">Company</h2>
          <ul class="mt-4 space-y-3 text-sm">
            {footerLinks.map((l) => <li><a href={l.href} class="text-mist/70 transition-colors hover:text-white">{l.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-cyan-glow">Legal</h2>
          <ul class="mt-4 space-y-3 text-sm">
            {legalLinks.map((l) => <li><a href={l.href} class="text-mist/70 transition-colors hover:text-white">{l.label}</a></li>)}
            <li><button type="button" data-cookie-prefs class="text-mist/70 transition-colors hover:text-white">Cookie Preferences</button></li>
          </ul>
        </div>
      </div>

      <div class="md:col-span-3">
        <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-cyan-glow">Get in touch</h2>
        <ul class="mt-4 space-y-3 text-sm text-mist/70">
          <li><a href={company.phoneHref} class="transition-colors hover:text-white">{company.phone}</a></li>
          <li><a href={`mailto:${company.email}`} class="transition-colors hover:text-white">{company.email}</a></li>
          <li class="leading-relaxed">{company.address}</li>
        </ul>
      </div>
    </div>

    <details class="group mt-14 rounded-2xl border border-white/6 bg-white/[0.015]">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-sm font-medium text-mist/80 [&::-webkit-details-marker]:hidden">
        Disclosures &amp; policies
        <svg class="size-4 transition-transform duration-300 group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z"/></svg>
      </summary>
      <div class="grid gap-5 px-5 pb-6 text-xs leading-relaxed text-slate-soft md:grid-cols-2">
        {disclosures.map((d) => <p><strong class="font-semibold text-mist/90">{d.title}:</strong> {d.body}</p>)}
      </div>
    </details>

    <div class="mt-10 flex flex-col gap-2 border-t border-white/6 pt-8 text-xs text-slate-soft md:flex-row md:items-center md:justify-between">
      <p>© {year} {company.legalName}, DBA {company.dba}. All Rights Reserved.</p>
      <p>{company.legalName}, Doing Business As {company.dba}.</p>
    </div>
  </div>
</footer>
