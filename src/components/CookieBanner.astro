---
// Stores consent in localStorage as { analytics, marketing, ts } under "ghd-consent".
// Future tracking scripts should check window.ghdConsent (or listen for the
// "ghd:consent" event) before loading.
---

<div
  id="cookie-banner"
  role="region"
  aria-label="Cookie consent"
  class="fixed inset-x-3 bottom-3 z-[60] hidden sm:inset-x-auto sm:right-5 sm:bottom-5 sm:max-w-md"
>
  <div class="glass rounded-2xl !bg-ink-900/90 p-5 shadow-2xl shadow-black/60">
    <p class="text-sm leading-relaxed text-mist/85">
      We use cookies to run this site and improve your experience. You can accept all, reject non-essential, or choose preferences.
    </p>
    <p class="mt-2 text-xs text-slate-soft">
      Read our <a href="/privacy-policy" class="text-cyan-glow underline underline-offset-2">Privacy Policy</a>{' and '}<a href="/cookie-policy" class="text-cyan-glow underline underline-offset-2">Cookie Policy</a>.
    </p>
    <div class="mt-4 flex flex-wrap gap-2">
      <button type="button" data-consent="reject" class="btn btn-ghost !px-4 !py-2 text-xs">Reject Non-Essential</button>
      <button type="button" data-cookie-prefs class="btn btn-ghost !px-4 !py-2 text-xs">Preferences</button>
      <button type="button" data-consent="accept" class="btn btn-primary !px-4 !py-2 text-xs">Accept All</button>
    </div>
  </div>
</div>

<dialog
  id="cookie-prefs"
  aria-labelledby="cookie-prefs-title"
  class="m-auto w-[min(28rem,calc(100vw-2rem))] rounded-3xl border border-white/10 bg-ink-900 p-0 text-mist backdrop:bg-ink-950/80 backdrop:backdrop-blur-md"
>
  <form method="dialog" class="p-6">
    <div class="flex items-center justify-between">
      <h2 id="cookie-prefs-title" class="font-display text-lg font-semibold text-white">Cookie Preferences</h2>
      <button value="cancel" class="grid size-9 place-items-center rounded-full text-mist/60 hover:bg-white/5 hover:text-white" aria-label="Close">✕</button>
    </div>
    <ul class="mt-5 space-y-3">
      <li class="rounded-2xl border border-white/8 p-4">
        <div class="flex items-center justify-between gap-4">
          <span class="font-medium text-white">Strictly Necessary</span>
          <span class="text-xs font-semibold text-cyan-glow">Always On</span>
        </div>
        <p class="mt-1 text-xs text-slate-soft">Required for core site functionality and consent storage.</p>
      </li>
      <li class="rounded-2xl border border-white/8 p-4">
        <label class="flex items-center justify-between gap-4">
          <span class="font-medium text-white">Analytics</span>
          <input type="checkbox" name="analytics" class="toggle" aria-label="Enable Analytics" />
        </label>
        <p class="mt-1 text-xs text-slate-soft">Helps us understand usage to improve site performance and content.</p>
      </li>
      <li class="rounded-2xl border border-white/8 p-4">
        <label class="flex items-center justify-between gap-4">
          <span class="font-medium text-white">Marketing</span>
          <input type="checkbox" name="marketing" class="toggle" aria-label="Enable Marketing" />
        </label>
        <p class="mt-1 text-xs text-slate-soft">Used to show and measure ads, and build audiences.</p>
      </li>
    </ul>
    <div class="mt-6 flex justify-end gap-2">
      <button value="cancel" class="btn btn-ghost !px-4 !py-2 text-sm">Cancel</button>
      <button value="save" class="btn btn-primary !px-4 !py-2 text-sm">Save Preferences</button>
    </div>
  </form>
</dialog>

<style>
  .toggle {
    appearance: none;
    position: relative;
    width: 2.6rem;
    height: 1.5rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.12);
    cursor: pointer;
    transition: background-color 0.25s;
  }
  .toggle::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 999px;
    background: #fff;
    transition: transform 0.25s var(--ease-out-expo);
  }
  .toggle:checked { background: var(--color-cyan-glow); }
  .toggle:checked::after { transform: translateX(1.1rem); background: var(--color-ink-950); }
</style>

<script>
  type Consent = { analytics: boolean; marketing: boolean; ts: string };
  const KEY = 'ghd-consent';
  const banner = document.getElementById('cookie-banner')!;
  const prefs = document.getElementById('cookie-prefs') as HTMLDialogElement;
  const form = prefs.querySelector('form')!;

  const read = (): Consent | null => {
    try {
      return JSON.parse(localStorage.getItem(KEY) || 'null');
    } catch {
      return null;
    }
  };
  const save = (c: Omit<Consent, 'ts'>) => {
    const value = { ...c, ts: new Date().toISOString() };
    try {
      localStorage.setItem(KEY, JSON.stringify(value));
    } catch {}
    (window as any).ghdConsent = value;
    window.dispatchEvent(new CustomEvent('ghd:consent', { detail: value }));
    banner.classList.add('hidden');
  };

  const existing = read();
  (window as any).ghdConsent = existing;
  if (!existing) banner.classList.remove('hidden');

  banner.addEventListener('click', (e) => {
    const choice = (e.target as HTMLElement).closest<HTMLElement>('[data-consent]')?.dataset.consent;
    if (choice === 'accept') save({ analytics: true, marketing: true });
    if (choice === 'reject') save({ analytics: false, marketing: false });
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('[data-cookie-prefs]')) return;
    const c = read();
    (form.elements.namedItem('analytics') as HTMLInputElement).checked = !!c?.analytics;
    (form.elements.namedItem('marketing') as HTMLInputElement).checked = !!c?.marketing;
    prefs.showModal();
  });

  prefs.addEventListener('close', () => {
    if (prefs.returnValue !== 'save') return;
    save({
      analytics: (form.elements.namedItem('analytics') as HTMLInputElement).checked,
      marketing: (form.elements.namedItem('marketing') as HTMLInputElement).checked,
    });
  });
</script>
