---
import { smsConsent } from '../data/site';
---

<dialog
  id="demo-modal"
  aria-labelledby="demo-title"
  class="m-auto w-[min(34rem,calc(100vw-2rem))] max-h-[calc(100dvh-2rem)] overflow-y-auto rounded-3xl border border-white/10 bg-ink-900 p-0 text-mist shadow-[0_40px_120px_-20px_rgb(0_240_255/0.35)] backdrop:bg-ink-950/80 backdrop:backdrop-blur-md"
>
  <div class="relative">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 right-0 h-48 w-72 rounded-full bg-cyan-glow/20 blur-3xl"></div>

    <div class="relative flex items-start justify-between gap-4 border-b border-white/6 p-6">
      <div class="flex items-center gap-4">
        <div class="relative grid size-12 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-cyan-glow to-teal-deep font-display text-lg font-bold text-ink-950">
          T
          <span class="absolute -right-0.5 -bottom-0.5 size-3.5 rounded-full border-2 border-ink-900 bg-emerald-400"></span>
        </div>
        <div>
          <h2 id="demo-title" class="font-display text-lg font-semibold leading-snug text-white">Chat with Trina — Your AI Demo Assistant</h2>
          <p class="mt-1 flex items-center gap-2 text-xs font-medium text-emerald-400">
            <span class="size-1.5 rounded-full bg-emerald-400 animate-pulse-dot"></span> Online
          </p>
        </div>
      </div>
      <button type="button" data-demo-close class="grid size-9 shrink-0 place-items-center rounded-full text-mist/60 transition-colors hover:bg-white/5 hover:text-white" aria-label="Close">
        <svg class="size-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/></svg>
      </button>
    </div>

    <form id="demo-form" class="relative space-y-4 p-6" novalidate>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block sm:col-span-2">
          <span class="text-sm font-medium text-mist/80">Full Name</span>
          <input name="full_name" type="text" autocomplete="name" class="field" placeholder="Full Name" />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-mist/80">Email <span class="text-cyan-glow">*</span></span>
          <input name="email" type="email" autocomplete="email" required class="field" placeholder="Email" />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-mist/80">Phone <span class="text-cyan-glow">*</span></span>
          <input name="phone" type="tel" autocomplete="tel" required class="field" placeholder="Phone" />
        </label>
        <label class="block sm:col-span-2">
          <span class="text-sm font-medium text-mist/80">Website</span>
          <input name="website" type="text" inputmode="url" autocomplete="url" class="field" placeholder="Web URL goes here" />
        </label>
      </div>

      <!-- Honeypot: hidden from people, bots tend to fill it. -->
      <div aria-hidden="true" class="absolute -left-[9999px] h-0 w-0 overflow-hidden">
        <label>Leave this empty <input name="company_fax" type="text" tabindex="-1" autocomplete="off" /></label>
      </div>

      <label class="flex gap-3 text-[11px] leading-relaxed text-slate-soft">
        <input name="sms_marketing_consent" type="checkbox" class="check" />
        <span>{smsConsent.marketing}</span>
      </label>
      <label class="flex gap-3 text-[11px] leading-relaxed text-slate-soft">
        <input name="sms_transactional_consent" type="checkbox" class="check" />
        <span>{smsConsent.transactional}</span>
      </label>

      <p id="demo-error" role="alert" class="hidden rounded-xl border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-200"></p>

      <button type="submit" class="btn btn-primary w-full !py-3.5 text-base">
        <span data-label>Free Instant Demo</span>
        <svg data-spinner class="hidden size-5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" opacity=".25"/><path d="M22 12a10 10 0 0 0-10-10" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
      </button>

      <p class="text-center text-xs text-slate-soft">
        <a href="/privacy-policy" class="underline-offset-4 hover:text-white hover:underline">Privacy Policy</a>
        <span class="mx-2 opacity-40">|</span>
        <a href="/terms-and-conditions" class="underline-offset-4 hover:text-white hover:underline">Terms &amp; Conditions</a>
      </p>
    </form>

    <div id="demo-success" class="hidden p-10 text-center">
      <div class="mx-auto grid size-16 place-items-center rounded-full bg-cyan-glow/15 text-cyan-glow shadow-[0_0_40px_rgb(0_240_255/0.35)]">
        <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h3 class="mt-6 font-display text-2xl font-semibold text-white">You're all set!</h3>
      <p class="mt-3 text-mist/70">Thanks — your AI demo is on its way. Keep your phone handy.</p>
      <button type="button" data-demo-close class="btn btn-ghost mt-8">Close</button>
    </div>
  </div>
</dialog>

<style>
  .field {
    margin-top: 0.4rem;
    width: 100%;
    border-radius: 0.85rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: rgb(255 255 255 / 0.03);
    padding: 0.75rem 0.95rem;
    font-size: 0.95rem;
    color: #fff;
    transition: border-color 0.2s, box-shadow 0.2s, background-color 0.2s;
  }
  .field::placeholder { color: rgb(143 176 182 / 0.6); }
  .field:focus {
    outline: none;
    border-color: rgb(0 240 255 / 0.6);
    background: rgb(0 240 255 / 0.04);
    box-shadow: 0 0 0 4px rgb(0 240 255 / 0.12);
  }
  .field[aria-invalid='true'] { border-color: rgb(248 113 113 / 0.7); }
  .check {
    margin-top: 0.15rem;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    accent-color: var(--color-cyan-glow);
  }
  dialog[open] { animation: dialog-in 0.45s var(--ease-out-expo); }
  dialog[open]::backdrop { animation: fade-in 0.35s ease-out; }
  @keyframes dialog-in {
    from { opacity: 0; transform: translateY(24px) scale(0.96); }
  }
  @keyframes fade-in {
    from { opacity: 0; }
  }
</style>

<script>
  // Leads are POSTed to a GoHighLevel "Inbound Webhook" trigger. Set the URL in .env:
  //   PUBLIC_GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/...
  const WEBHOOK_URL = import.meta.env.PUBLIC_GHL_WEBHOOK_URL as string | undefined;

  const dialog = document.getElementById('demo-modal') as HTMLDialogElement;
  const form = document.getElementById('demo-form') as HTMLFormElement;
  const success = document.getElementById('demo-success')!;
  const errorBox = document.getElementById('demo-error')!;
  const submit = form.querySelector('button[type=submit]') as HTMLButtonElement;

  const open = () => {
    form.classList.remove('hidden');
    success.classList.add('hidden');
    dialog.showModal();
    (window as any).lenis?.stop();
  };
  const close = () => dialog.close();
  dialog.addEventListener('close', () => (window as any).lenis?.start());

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-demo-open]')) {
      e.preventDefault();
      open();
    } else if (t.closest('[data-demo-close]')) close();
  });
  // Close when clicking the backdrop.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });
  if (location.hash === '#demo') open();

  const showError = (msg: string) => {
    errorBox.textContent = msg;
    errorBox.classList.remove('hidden');
  };

  const setLoading = (loading: boolean) => {
    submit.disabled = loading;
    submit.querySelector('[data-label]')!.textContent = loading ? 'Sending…' : 'Free Instant Demo';
    submit.querySelector('[data-spinner]')!.classList.toggle('hidden', !loading);
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.classList.add('hidden');

    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    if (data.company_fax) return; // bot

    let firstInvalid: HTMLInputElement | null = null;
    for (const name of ['email', 'phone']) {
      const input = form.elements.namedItem(name) as HTMLInputElement;
      const ok = input.checkValidity() && input.value.trim() !== '';
      input.setAttribute('aria-invalid', String(!ok));
      if (!ok && !firstInvalid) firstInvalid = input;
    }
    if (firstInvalid) {
      showError('Please enter a valid email and phone number.');
      firstInvalid.focus();
      return;
    }

    if (!WEBHOOK_URL) {
      showError('The demo form isn’t connected yet. Please email connect@ghdagency.ai or call 702-581-8617.');
      console.warn('PUBLIC_GHL_WEBHOOK_URL is not set.');
      return;
    }

    const [first_name, ...rest] = (data.full_name || '').trim().split(/\s+/);
    const payload = {
      full_name: data.full_name?.trim() || '',
      first_name: first_name || '',
      last_name: rest.join(' '),
      email: data.email.trim(),
      phone: data.phone.trim(),
      website: data.website?.trim() || '',
      sms_marketing_consent: data.sms_marketing_consent === 'on',
      sms_transactional_consent: data.sms_transactional_consent === 'on',
      source: 'Website — Free Instant Demo',
      page: location.href,
      submitted_at: new Date().toISOString(),
    };

    setLoading(true);
    try {
      const res = await fetch(WEBHOOK_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      form.reset();
      form.classList.add('hidden');
      success.classList.remove('hidden');
    } catch (err) {
      console.error(err);
      showError('Something went wrong sending your request. Please try again, or call 702-581-8617.');
    } finally {
      setLoading(false);
    }
  });
</script>
