---
import { testimonials, testimonialDisclaimer } from '../data/site';
// Duplicate the list so the marquee can loop seamlessly.
const loop = [...testimonials, ...testimonials];
---

<section class="relative overflow-hidden py-24 md:py-32">
  <div class="container-x text-center">
    <img src="/images/trustpilot.png" alt="Trustpilot" width="318" height="159" loading="lazy" class="mx-auto h-12 w-auto" data-reveal="fade" />
    <h2 class="mt-5 text-3xl font-semibold text-white sm:text-4xl" data-split>Rated Excellent by business owners</h2>
    <div class="mt-4 flex justify-center gap-1 text-[#00b67a]" aria-label="5 out of 5 stars" data-reveal="fade">
      {Array.from({ length: 5 }).map(() => (
        <svg class="size-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6L10 15l-5.4 3 1.2-6L1.3 7.8l6.1-.7L10 1.5z"/></svg>
      ))}
    </div>
  </div>

  <div class="marquee group relative mt-14" style="--marquee-duration: 45s">
    <ul class="flex w-max gap-5 animate-marquee group-hover:[animation-play-state:paused]">
      {
        loop.map((t, i) => (
          <li class="glass w-[22rem] shrink-0 rounded-3xl p-7 sm:w-[26rem]" aria-hidden={i >= testimonials.length ? 'true' : undefined}>
            <div class="flex gap-0.5 text-[#00b67a]" aria-label="5 stars">★★★★★</div>
            <blockquote class="mt-4 font-display text-lg leading-snug text-white">“{t.quote}”</blockquote>
            <div class="mt-6 flex items-center gap-3">
              <div class="grid size-10 place-items-center rounded-full bg-gradient-to-br from-cyan-glow/40 to-teal-deep/60 text-sm font-semibold text-white">
                {t.name.split(' ').map((n) => n[0]).join('')}
              </div>
              <div class="text-sm">
                <p class="font-semibold text-white">{t.name}</p>
                <p class="text-slate-soft">{t.source}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <p class="container-x mt-10 text-center text-xs text-slate-soft">{testimonialDisclaimer}</p>
</section>

<style>
  .marquee {
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
</style>
