---
interface Props {
  eyebrow?: string;
}
const { eyebrow } = Astro.props;
---

<section data-hero class="relative isolate overflow-hidden pt-40 pb-16 md:pt-48 md:pb-24">
  <div aria-hidden="true" class="absolute inset-0 -z-10">
    <div class="grid-bg absolute inset-0"></div>
    <div class="absolute -top-48 left-1/2 h-[32rem] w-[60rem] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,rgb(0_240_255/0.22),transparent)] blur-2xl"></div>
    <div data-cursor-glow class="absolute top-1/3 left-1/2 size-[28rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-cyan-glow/10 blur-[110px]"></div>
  </div>
  <div class="container-x text-center">
    {eyebrow && <p class="eyebrow" data-reveal="fade">{eyebrow}</p>}
    <h1 class="mx-auto mt-6 max-w-5xl text-5xl font-semibold leading-[1] text-white sm:text-6xl lg:text-7xl" data-split>
      <slot name="title" />
    </h1>
    {
      Astro.slots.has('default') && (
        <div class="mx-auto mt-8 max-w-2xl space-y-4 text-lg leading-relaxed text-mist/75" data-reveal>
          <slot />
        </div>
      )
    }
  </div>
</section>
