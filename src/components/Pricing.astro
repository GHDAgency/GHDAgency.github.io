---
import SectionHeading from './SectionHeading.astro';
import { plans, checkoutUrl } from '../data/site';

interface Props {
  as?: 'h1' | 'h2';
}
const { as = 'h2' } = Astro.props;
---

<section id="pricing" class="relative py-24 md:py-32">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-1/3 -z-10 mx-auto h-[30rem] max-w-5xl rounded-full bg-[linear-gradient(90deg,rgb(0_159_164/0.12),rgb(139_123_255/0.12))] blur-[140px]"></div>

  <div class="container-x">
    <SectionHeading eyebrow="Pricing" as={as}>
      <Fragment slot="title">Choose Your Plan. <span class="text-gradient">Automate Your Growth.</span></Fragment>
      <p>Plans for businesses of all sizes. Upgrade any time.</p>
    </SectionHeading>

    <div class="mt-16 grid items-stretch gap-6 lg:grid-cols-3" data-reveal-stagger="0.12">
      {
        plans.map((p) => (
          <article
            data-tilt
            class:list={[
              'spotlight relative flex flex-col rounded-[2rem] p-8 will-change-transform',
              p.popular
                ? 'border border-cyan-glow/40 bg-gradient-to-b from-cyan-glow/[0.12] via-ink-850 to-violet-deep/[0.18] shadow-[0_30px_100px_-30px_rgb(0_240_255/0.5),0_40px_120px_-40px_rgb(139_123_255/0.5)]'
                : 'glass',
            ]}
          >
            {p.popular && (
              <span class="absolute -top-3.5 left-8 rounded-full bg-cyan-glow px-3.5 py-1 text-xs font-bold tracking-wide text-ink-950 shadow-[0_0_24px_rgb(0_240_255/0.6)]">
                Most Popular
              </span>
            )}
            <h3 class="font-display text-xl font-semibold text-white">{p.name}</h3>
            <p class="mt-6 flex items-baseline gap-1.5">
              <span class="font-display text-6xl font-semibold tracking-tight text-white">${p.price}</span>
              <span class="text-mist/60">/mo</span>
            </p>
            <p class="mt-2 text-sm font-medium text-cyan-glow">+ ${p.setup} one-time setup</p>

            <ul class="mt-8 flex-1 space-y-3.5 border-t border-white/8 pt-8 text-sm">
              {p.items.map((item) => (
                <li class="flex gap-3 text-mist/80">
                  <svg class="mt-0.5 size-4 shrink-0 text-cyan-glow" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.7 4.15a.75.75 0 0 1 .15 1.05l-8 10.5a.75.75 0 0 1-1.13.08l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.9 3.9 7.47-9.82a.75.75 0 0 1 1.05-.15Z" clip-rule="evenodd" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>

            <a href={checkoutUrl} class:list={['btn mt-10 w-full', p.popular ? 'btn-primary' : 'btn-ghost']}>
              Start with Setup
            </a>
            <p class="mt-4 text-center text-xs text-slate-soft">Activate monthly after 30 days →</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
